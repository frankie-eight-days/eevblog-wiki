				"to": 294300
			},
			"text": " But I don't..."
		},
		{
			"timestamps": {
				"from": "00:04:54,300",
				"to": "00:05:01,360"
			},
			"offsets": {
				"from": 294300,
				"to": 301360
			},
			"text": " I don't have a mainstream appeal, which is why my videos almost never go viral or anything like that."
		},
		{
			"timestamps": {
				"from": "00:05:01,360",
				"to": "00:05:06,820"
			},
			"offsets": {
				"from": 301360,
				"to": 306820
			},
			"text": " I just wanted to show you that this is what YouTube shows us YouTubers every single time we log in."
		},
		{
			"timestamps": {
				"from": "00:05:06,940",
				"to": "00:05:10,780"
			},
			"offsets": {
				"from": 306940,
				"to": 310780
			},
			"text": " And I've done that video on how they remove the dislike to protect us."
