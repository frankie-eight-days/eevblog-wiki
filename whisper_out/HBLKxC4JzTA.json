				"to": "00:03:28,580"
			},
			"offsets": {
				"from": 202220,
				"to": 208580
			},
			"text": " So, you know, the thing is that this is aluminum, so it's really well sheeted, and yeah, this makes it much easier."
		},
		{
			"timestamps": {
				"from": "00:03:28,580",
				"to": "00:03:28,940"
			},
			"offsets": {
				"from": 208580,
				"to": 208940
			},
			"text": " It makes it much easier."
