				"to": "00:04:38,980"
			},
			"offsets": {
				"from": 277860,
				"to": 278980
			},
			"text": " And it's a single point of failure."
		},
		{
			"timestamps": {
				"from": "00:04:39,240",
				"to": "00:04:39,400"
			},
			"offsets": {
				"from": 279240,
				"to": 279400
			},
			"text": " Yep."
		},
		{
			"timestamps": {
				"from": "00:04:39,400",
				"to": "00:04:46,800"
			},
			"offsets": {
				"from": 279400,
				"to": 286800
			},
			"text": " And we are accepting it, because we don't have the engineering capacity and the energy to do it the easy way."
		},
		{
			"timestamps": {
				"from": "00:04:47,040",
				"to": "00:04:52,980"
			},
			"offsets": {
				"from": 287040,
				"to": 292980
			},
			"text": " So, it was a case of rover first, worry about lander second."
		},
		{
			"timestamps": {
				"from": "00:04:53,340",
				"to": "00:04:54,140"
			},
			"offsets": {
				"from": 293340,
				"to": 294140
			},
			"text": " Yeah, yeah, yeah."
		},
		{
			"timestamps": {
				"from": "00:04:54,140",
				"to": "00:04:54,340"
			},
			"offsets": {
				"from": 294140,
				"to": 294340
			},
			"text": " Right?"
		},
		{
			"timestamps": {
				"from": "00:04:54,480",
				"to": "00:04:54,760"
			},
			"offsets": {
				"from": 294480,
				"to": 294760
			},
			"text": " It was."
		},
		{
			"timestamps": {
				"from": "00:04:54,860",
				"to": "00:04:55,360"
			},
			"offsets": {
				"from": 294860,
				"to": 295360
			},
			"text": " Essentially, yeah."
		},
		{
			"timestamps": {
				"from": "00:04:55,360",
				"to": "00:04:55,800"
			},
			"offsets": {
				"from": 295360,
				"to": 295800
			},
			"text": " Yeah."
		},
		{
			"timestamps": {
				"from": "00:04:55,800",
				"to": "00:04:58,360"
			},
			"offsets": {
				"from": 295800,
				"to": 298360
			},
			"text": " Another thing is that the rover is."
		},
		{
			"timestamps": {
				"from": "00:04:58,360",
				"to": "00:04:59,460"
			},
			"offsets": {
				"from": 298360,
				"to": 299460
			},
			"text": " It's very easy to test."
		},
		{
			"timestamps": {
				"from": "00:04:59,600",
				"to": "00:05:00,600"
			},
			"offsets": {
				"from": 299600,
				"to": 300600
			},
			"text": " You can take it to a playground."
		},
		{
			"timestamps": {
				"from": "00:05:00,940",
				"to": "00:05:01,800"
			},
			"offsets": {
				"from": 300940,
				"to": 301800
			},
			"text": " Yeah, it's very easy."
		},
		{
			"timestamps": {
				"from": "00:05:01,980",
				"to": "00:05:12,440"
			},
			"offsets": {
				"from": 301980,
				"to": 312440
			},
			"text": " But with a lander, it's really hard to test it, because the thrusters that you have don't actually work on Earth in an oxygen environment."
		},
		{
			"timestamps": {
				"from": "00:05:12,600",
				"to": "00:05:13,300"
			},
			"offsets": {
				"from": 312600,
				"to": 313300
			},
			"text": " They are made for vacuum."
		},
		{
			"timestamps": {
				"from": "00:05:13,600",
				"to": "00:05:19,940"
			},
			"offsets": {
				"from": 313600,
				"to": 319940
			},
			"text": " And they don't have the ability to lift the lander at a 1G gravity."
		},
		{
			"timestamps": {
				"from": "00:05:20,140",
				"to": "00:05:24,300"
			},
			"offsets": {
				"from": 320140,
				"to": 324300
			},
			"text": " They are designed to avoid enough lift for 1.6 gravity."
		},
		{
			"timestamps": {
				"from": "00:05:25,300",
				"to": "00:05:28,300"
			},
			"offsets": {
				"from": 325300,
				"to": 328300
			},
			"text": " So, all of that together makes the."
		},
		{
			"timestamps": {
				"from": "00:05:28,520",
				"to": "00:05:37,600"
			},
			"offsets": {
				"from": 328520,
				"to": 337600
			},
			"text": " So, we are developing the lander, a pretty big challenge that we wanted to address in the latest part where we went, where we were sure what the requirements are."
		},
		{
			"timestamps": {
				"from": "00:05:37,900",
				"to": "00:05:40,840"
			},
			"offsets": {
				"from": 337900,
				"to": 340840
			},
			"text": " And you've got solid funding to."
		},
		{
			"timestamps": {
				"from": "00:05:40,920",
				"to": "00:05:42,940"
			},
			"offsets": {
				"from": 340920,
				"to": 342940
			},
			"text": " Oh, yeah, and the funding is also interesting."
		},
		{
			"timestamps": {
				"from": "00:05:42,940",
				"to": "00:05:44,440"
			},
			"offsets": {
				"from": 342940,
				"to": 344440
			},
			"text": " Because lander is not sexy."
		},
		{
			"timestamps": {
				"from": "00:05:44,440",
				"to": "00:05:46,640"
			},
			"offsets": {
				"from": 344440,
				"to": 346640
			},
			"text": " Nobody, look, we've got a lander."
		},
		{
			"timestamps": {
				"from": "00:05:46,640",
				"to": "00:05:47,740"
			},
			"offsets": {
				"from": 346640,
				"to": 347740
			},
			"text": " Oh, it's kind of sexy."
		},
		{
			"timestamps": {
				"from": "00:05:47,740",
				"to": "00:05:52,180"
			},
			"offsets": {
				"from": 347740,
				"to": 352180
			},
			"text": " You know, but come on, you can't sell that to Audi."
		},
		{
			"timestamps": {
				"from": "00:05:52,220",
				"to": "00:05:53,620"
			},
			"offsets": {
				"from": 352220,
				"to": 353620
			},
			"text": " They don't want a lander."
		},
		{
			"timestamps": {
				"from": "00:05:54,620",
				"to": "00:05:55,600"
			},
			"offsets": {
				"from": 354620,
				"to": 355600
			},
			"text": " No, give us the rover."
		},
		{
			"timestamps": {
				"from": "00:05:55,640",
				"to": "00:05:57,520"
			},
			"offsets": {
				"from": 355640,
				"to": 357520
			},
			"text": " We want our logo on a rover, you know."
		},
		{
			"timestamps": {
				"from": "00:05:58,120",
				"to": "00:06:01,620"
			},
			"offsets": {
				"from": 358120,
				"to": 361620
			},
			"text": " So, yeah, the rover is something that people can relate more to."
		},
		{
			"timestamps": {
				"from": "00:06:01,640",
				"to": "00:06:03,040"
			},
			"offsets": {
				"from": 361640,
				"to": 363040
			},
			"text": " They can relate more to it."
		},
		{
			"timestamps": {
				"from": "00:06:03,140",
				"to": "00:06:03,340"
			},
			"offsets": {
				"from": 363140,
				"to": 363340
			},
			"text": " It's better."
		},
		{
			"timestamps": {
				"from": "00:06:03,420",
				"to": "00:06:03,940"
			},
			"offsets": {
				"from": 363420,
				"to": 363940
			},
			"text": " And it's fun."
		},
		{
			"timestamps": {
				"from": "00:06:04,160",
				"to": "00:06:05,800"
			},
			"offsets": {
				"from": 364160,
				"to": 365800
			},
			"text": " Come on, the rover is more fun than the lander."
		},
		{
			"timestamps": {
				"from": "00:06:05,860",
				"to": "00:06:06,400"
			},
			"offsets": {
				"from": 365860,
				"to": 366400
			},
			"text": " Yeah, yeah, I agree."
		}
	]
}
