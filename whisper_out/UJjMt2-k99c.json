			"text": " And if we move our voltage up and down,"
		},
		{
			"timestamps": {
				"from": "00:05:02,000",
				"to": "00:05:04,000"
			},
			"offsets": {
				"from": 302000,
				"to": 304000
			},
			"text": " I should use a better pot than this."
		},
		{
			"timestamps": {
				"from": "00:05:04,000",
				"to": "00:05:07,000"
			},
			"offsets": {
				"from": 304000,
				"to": 307000
			},
			"text": " If I did, we can maybe see it change with time."
		},
		{
			"timestamps": {
				"from": "00:05:07,000",
				"to": "00:05:09,000"
			},
			"offsets": {
				"from": 307000,
				"to": 309000
			},
			"text": " Now, here's where the digital oscilloscope,"
		},
		{
			"timestamps": {
				"from": "00:05:09,000",
				"to": "00:05:13,000"
			},
			"offsets": {
				"from": 309000,
				"to": 313000
			},
			"text": " we can put it in what's called roll mode, OK?"
		},
		{
			"timestamps": {
				"from": "00:05:13,000",
				"to": "00:05:17,000"
			},
			"offsets": {
				"from": 313000,
				"to": 317000
			},
			"text": " And it works slightly differently in that it doesn't retrace."
		},
		{
			"timestamps": {
				"from": "00:05:17,000",
				"to": "00:05:19,000"
			},
			"offsets": {
				"from": 317000,
				"to": 319000
			},
			"text": " It's like a chart recorder,"
		},
		{
			"timestamps": {
				"from": "00:05:19,000",
				"to": "00:05:23,000"
			},
			"offsets": {
				"from": 319000,
				"to": 323000
			},
			"text": " those old-fashioned seismic chart recorders or something like that."
		},
		{
			"timestamps": {
				"from": "00:05:23,000",
				"to": "00:05:24,000"
			},
			"offsets": {
				"from": 323000,
				"to": 324000
			},
			"text": " Now, watch."
		},
		{
			"timestamps": {
				"from": "00:05:24,000",
				"to": "00:05:27,000"
			},
			"offsets": {
				"from": 324000,
				"to": 327000
			},
			"text": " If I move this, I can actually generate,"
		},
		{
			"timestamps": {
				"from": "00:05:27,000",
				"to": "00:05:29,000"
			},
			"offsets": {
				"from": 327000,
				"to": 329000
			},
			"text": " you might be familiar with this,"
		},
		{
			"timestamps": {
				"from": "00:05:29,000",
				"to": "00:05:34,000"
			},
			"offsets": {
				"from": 329000,
				"to": 334000
			},
			"text": " I'm very crudely trying to generate a sinusoidal wave there"
		},
		{
			"timestamps": {
				"from": "00:05:34,000",
				"to": "00:05:36,000"
			},
			"offsets": {
				"from": 334000,
				"to": 336000
			},
			"text": " or any sort of wave like that."
		},
		{
			"timestamps": {
				"from": "00:05:36,000",
				"to": "00:05:38,000"
			},
			"offsets": {
				"from": 336000,
				"to": 338000
			},
			"text": " You can see it change with time."
		},
		{
			"timestamps": {
				"from": "00:05:38,000",
				"to": "00:05:41,000"
			},
			"offsets": {
				"from": 338000,
				"to": 341000
			},
			"text": " And if we slow it down even more,"
		},
		{
			"timestamps": {
				"from": "00:05:41,000",
				"to": "00:05:44,000"
			},
			"offsets": {
				"from": 341000,
				"to": 344000
			},
			"text": " then we can really start to see that"
		},
		{
			"timestamps": {
				"from": "00:05:44,000",
				"to": "00:05:46,000"
			},
			"offsets": {
				"from": 344000,
				"to": 346000
			},
			"text": " on that digital storage oscilloscope."
		},
		{
			"timestamps": {
				"from": "00:05:46,000",
				"to": "00:05:49,000"
			},
			"offsets": {
				"from": 346000,
				"to": 349000
			},
			"text": " And that's something that we can't see on the--"
		},
		{
			"timestamps": {
				"from": "00:05:49,000",
				"to": "00:05:51,000"
			},
			"offsets": {
				"from": 349000,
				"to": 351000
			},
			"text": " well, you can kind of follow it on the multimeter,"
		},
		{
			"timestamps": {
				"from": "00:05:51,000",
				"to": "00:05:54,000"
			},
			"offsets": {
				"from": 351000,
				"to": 354000
			},
			"text": " but you don't get the same visual representation as you would"
		},
		{
			"timestamps": {
				"from": "00:05:54,000",
				"to": "00:05:57,000"
			},
			"offsets": {
				"from": 354000,
				"to": 357000
			},
			"text": " on an oscilloscope like this."
		},
		{
			"timestamps": {
				"from": "00:05:57,000",
				"to": "00:05:59,000"
			},
			"offsets": {
				"from": 357000,
				"to": 359000
			},
			"text": " So that is one of the big advantages."
		},
		{
			"timestamps": {
				"from": "00:05:59,000",
				"to": "00:06:05,000"
			},
			"offsets": {
				"from": 359000,
				"to": 365000
			},
			"text": " You're displaying voltage on the y-axis versus time on the x-axis."
		},
		{
			"timestamps": {
				"from": "00:06:05,000",
				"to": "00:06:08,000"
			},
			"offsets": {
				"from": 365000,
				"to": 368000
			},
			"text": " And the oscilloscope can measure things very quickly."
		},
		{
			"timestamps": {
				"from": "00:06:08,000",
				"to": "00:06:13,000"
			},
			"offsets": {
				"from": 368000,
				"to": 373000
			},
			"text": " And all modern digital electronics works on very fast-changing signals"
		},
		{
			"timestamps": {
				"from": "00:06:13,000",
				"to": "00:06:16,000"
			},
			"offsets": {
				"from": 373000,
				"to": 376000
			},
			"text": " which you can't see on a multimeter."
		},
		{
			"timestamps": {
				"from": "00:06:16,000",
				"to": "00:06:20,000"
			},
			"offsets": {
				"from": 376000,
				"to": 380000
			},
			"text": " So you need an oscilloscope to give you a window"
		},
		{
			"timestamps": {
				"from": "00:06:20,000",
				"to": "00:06:23,000"
			},
			"offsets": {
				"from": 380000,
				"to": 383000
			},
			"text": " into what's happening inside your electronic circuits."
		},
		{
			"timestamps": {
				"from": "00:06:23,000",
				"to": "00:06:27,000"
			},
			"offsets": {
				"from": 383000,
				"to": 387000
			},
			"text": " And you can see voltages change with time."
		},
		{
			"timestamps": {
				"from": "00:06:27,000",
				"to": "00:06:31,000"
			},
			"offsets": {
				"from": 387000,
				"to": 391000
			},
			"text": " And that's pretty much all it is."
		},
		{
			"timestamps": {
				"from": "00:06:31,000",
				"to": "00:06:34,000"
			},
			"offsets": {
				"from": 391000,
				"to": 394000
			},
			"text": " Except you can view really fast stuff."
		},
		{
			"timestamps": {
				"from": "00:06:34,000",
				"to": "00:06:40,000"
			},
			"offsets": {
				"from": 394000,
				"to": 400000
			},
			"text": " And if I had an oscilloscope probe--"
		},
		{
			"timestamps": {
				"from": "00:06:40,000",
				"to": "00:06:42,000"
			},
			"offsets": {
				"from": 400000,
				"to": 402000
			},
			"text": " ah, no!"
		},
		{
			"timestamps": {
				"from": "00:06:42,000",
				"to": "00:06:45,000"
			},
			"offsets": {
				"from": 402000,
				"to": 405000
			},
			"text": " Oscilloscope probe, David!"
		},
		{
			"timestamps": {
				"from": "00:06:45,000",
				"to": "00:06:47,000"
			},
			"offsets": {
				"from": 405000,
				"to": 407000
			},
			"text": " The lab's in a state of flux at the moment,"
		},
		{
			"timestamps": {
				"from": "00:06:47,000",
				"to": "00:06:49,000"
			},
			"offsets": {
				"from": 407000,
				"to": 409000
			},
			"text": " and I want this video to be a single take."
		},
		{
			"timestamps": {
				"from": "00:06:49,000",
				"to": "00:06:51,000"
			},
			"offsets": {
				"from": 409000,
				"to": 411000
			},
			"text": " Ah, I should have said that."
		},
		{
			"timestamps": {
				"from": "00:06:51,000",
				"to": "00:06:53,000"
			},
			"offsets": {
				"from": 411000,
				"to": 413000
			},
			"text": " Ah! Ah!"
		},
		{
			"timestamps": {
				"from": "00:06:53,000",
				"to": "00:06:55,000"
			},
			"offsets": {
				"from": 413000,
				"to": 415000
			},
			"text": " There's a whole box of them."
		},
		{
			"timestamps": {
				"from": "00:06:55,000",
				"to": "00:06:56,000"
			},
			"offsets": {
				"from": 415000,
				"to": 416000
			},
			"text": " There's a whole box of them."
		},
		{
			"timestamps": {
				"from": "00:06:56,000",
				"to": "00:06:59,000"
			},
			"offsets": {
				"from": 416000,
				"to": 419000
			},
			"text": " That probe starts in the bottom."
		},
		{
			"timestamps": {
				"from": "00:06:59,000",
				"to": "00:07:01,000"
			},
			"offsets": {
				"from": 419000,
				"to": 421000
			},
			"text": " Ah!"
		},
		{
			"timestamps": {
				"from": "00:07:01,000",
				"to": "00:07:03,000"
			},
			"offsets": {
				"from": 421000,
				"to": 423000
			},
			"text": " It's still one take, Dave."
		},
		{
			"timestamps": {
				"from": "00:07:03,000",
				"to": "00:07:05,000"
			},
			"offsets": {
				"from": 423000,
				"to": 425000
			},
			"text": " Ah, no, it's even missing from here."
		},
		{
			"timestamps": {
				"from": "00:07:05,000",
				"to": "00:07:07,000"
			},
			"offsets": {
				"from": 425000,
				"to": 427000
			},
			"text": " Ah, it's the wrong type of plug."
		},
		{
			"timestamps": {
				"from": "00:07:07,000",
				"to": "00:07:09,000"
			},
			"offsets": {
				"from": 427000,
				"to": 429000
			},
			"text": " Why does that exist?"
		},
		{
			"timestamps": {
				"from": "00:07:09,000",
				"to": "00:07:11,000"
			},
			"offsets": {
				"from": 429000,
				"to": 431000
			},
			"text": " There we go."
		},
		{
			"timestamps": {
				"from": "00:07:11,000",
				"to": "00:07:16,000"
			},
			"offsets": {
				"from": 431000,
				"to": 436000
			},
			"text": " We've now got an oscilloscope probe."
		},
		{
			"timestamps": {
				"from": "00:07:16,000",
				"to": "00:07:18,000"
			},
			"offsets": {
				"from": 436000,
				"to": 438000
			},
			"text": " Sorry about that."
		},
		{
			"timestamps": {
				"from": "00:07:18,000",
				"to": "00:07:21,000"
			},
			"offsets": {
				"from": 438000,
				"to": 441000
			},
			"text": " Okay, let's go up here."
		},
		{
			"timestamps": {
				"from": "00:07:21,000",
				"to": "00:07:22,000"
			},
			"offsets": {
				"from": 441000,
				"to": 442000
			},
			"text": " Oscilloscope probe."
		},
		{
			"timestamps": {
				"from": "00:07:22,000",
				"to": "00:07:29,000"
			},
			"offsets": {
				"from": 442000,
				"to": 449000
			},
			"text": " And I'll actually measure a probe adjust signal."
		},
		{
			"timestamps": {
				"from": "00:07:29,000",
				"to": "00:07:31,000"
			},
			"offsets": {
				"from": 449000,
				"to": 451000
			},
			"text": " Oh, hang on."
		},
		{
			"timestamps": {
				"from": "00:07:31,000",
				"to": "00:07:32,000"
			},
			"offsets": {
				"from": 451000,
				"to": 452000
			},
			"text": " There we go."
		},
		{
			"timestamps": {
				"from": "00:07:32,000",
				"to": "00:07:37,000"
			},
			"offsets": {
				"from": 452000,
				"to": 457000
			},
			"text": " There we go."
		},
		{
			"timestamps": {
				"from": "00:07:37,000",
				"to": "00:07:42,000"
			},
			"offsets": {
				"from": 457000,
				"to": 462000
			},
			"text": " We now have an example of a fast change."
		},
		{
			"timestamps": {
				"from": "00:07:42,000",
				"to": "00:07:46,000"
			},
			"offsets": {
				"from": 462000,
				"to": 466000
			},
			"text": " In this case, it's only a one kilohertz signal,"
		},
		{
			"timestamps": {
				"from": "00:07:46,000",
				"to": "00:07:49,000"
			},
			"offsets": {
				"from": 466000,
				"to": 469000
			},
			"text": " i.e. it changes a thousand times per second."
		},
		{
			"timestamps": {
				"from": "00:07:49,000",
				"to": "00:07:51,000"
			},
			"offsets": {
				"from": 469000,
				"to": 471000
			},
			"text": " But we can see this square wave here,"
		},
		{
			"timestamps": {
				"from": "00:07:51,000",
				"to": "00:07:56,000"
			},
			"offsets": {
				"from": 471000,
				"to": 476000
			},
			"text": " which goes across, up very fast rise time in here."
		},
		{
			"timestamps": {
				"from": "00:07:56,000",
				"to": "00:07:58,000"
			},
			"offsets": {
				"from": 476000,
				"to": 478000
			},
			"text": " And we can actually see--"
		},
		{
			"timestamps": {
				"from": "00:07:58,000",
				"to": "00:08:00,000"
			},
			"offsets": {
				"from": 478000,
				"to": 480000
			},
			"text": " there we go."
		},
		{
			"timestamps": {
				"from": "00:08:00,000",
				"to": "00:08:01,000"
			},
			"offsets": {
				"from": 480000,
				"to": 481000
			},
			"text": " We can see that's like"
		},
		{
			"timestamps": {
				"from": "00:08:01,000",
				"to": "00:08:04,000"
			},
			"offsets": {
				"from": 481000,
				"to": 484000
			},
			"text": " one microsecond per division."
		},
		{
			"timestamps": {
				"from": "00:08:04,000",
				"to": "00:08:05,000"
			},
			"offsets": {
				"from": 484000,
				"to": 485000
			},
			"text": " So one division here,"
		},
		{
			"timestamps": {
				"from": "00:08:05,000",
				"to": "00:08:06,000"
			},
			"offsets": {
				"from": 485000,
				"to": 486000
			},
			"text": " that is rising--"
		},
		{
			"timestamps": {
				"from": "00:08:06,000",
				"to": "00:08:09,000"
			},
			"offsets": {
				"from": 486000,
				"to": 489000
			},
			"text": " that signal is rising in one microsecond,"
		},
		{
			"timestamps": {
				"from": "00:08:09,000",
				"to": "00:08:11,000"
			},
			"offsets": {
				"from": 489000,
				"to": 491000
			},
			"text": " or one one millionth of a second."
		},
		{
			"timestamps": {
				"from": "00:08:11,000",
				"to": "00:08:13,000"
			},
			"offsets": {
				"from": 491000,
				"to": 493000
			},
			"text": " There's no way you'd ever see that"
		},
		{
			"timestamps": {
				"from": "00:08:13,000",
				"to": "00:08:14,000"
			},
			"offsets": {
				"from": 493000,
				"to": 494000
			},
			"text": " on a multimeter,"
		},
		{
			"timestamps": {
				"from": "00:08:14,000",
				"to": "00:08:17,000"
			},
			"offsets": {
				"from": 494000,
				"to": 497000
			},
			"text": " even though multimeter technically,"
		},
		{
			"timestamps": {
				"from": "00:08:17,000",
				"to": "00:08:19,000"
			},
			"offsets": {
				"from": 497000,
				"to": 499000
			},
			"text": " if it had a fast enough converter"
		},
		{
			"timestamps": {
				"from": "00:08:19,000",
				"to": "00:08:20,000"
			},
			"offsets": {
				"from": 499000,
				"to": 500000
			},
			"text": " and everything else,"
		},
		{
			"timestamps": {
				"from": "00:08:20,000",
				"to": "00:08:21,000"
			},
			"offsets": {
				"from": 500000,
				"to": 501000
			},
			"text": " you could actually see it."
		},
		{
			"timestamps": {
				"from": "00:08:21,000",
				"to": "00:08:23,000"
			},
			"offsets": {
				"from": 501000,
				"to": 503000
			},
			"text": " But the oscilloscope allows you to see"
		},
		{
			"timestamps": {
				"from": "00:08:23,000",
				"to": "00:08:26,000"
			},
			"offsets": {
				"from": 503000,
				"to": 506000
			},
			"text": " really fast changing signals like that."
		},
		{
			"timestamps": {
				"from": "00:08:26,000",
				"to": "00:08:27,000"
			},
			"offsets": {
				"from": 506000,
				"to": 507000
			},
			"text": " So this is a hundred--"
		},
		{
			"timestamps": {
				"from": "00:08:27,000",
				"to": "00:08:29,000"
			},
			"offsets": {
				"from": 507000,
				"to": 509000
			},
			"text": " no, two hundred nanoseconds."
		},
		{
			"timestamps": {
				"from": "00:08:29,000",
				"to": "00:08:30,000"
			},
			"offsets": {
				"from": 509000,
				"to": 510000
			},
			"text": " So really fast changing--"
		},
		{
			"timestamps": {
				"from": "00:08:30,000",
				"to": "00:08:32,000"
			},
			"offsets": {
				"from": 510000,
				"to": 512000
			},
			"text": " fast changing signals."
		},
		{
			"timestamps": {
				"from": "00:08:32,000",
				"to": "00:08:33,000"
			},
			"offsets": {
				"from": 512000,
				"to": 513000
			},
			"text": " You can actually see"
		},
		{
			"timestamps": {
				"from": "00:08:33,000",
				"to": "00:08:35,000"
			},
			"offsets": {
				"from": 513000,
				"to": 515000
			},
			"text": " exactly what's happening in your circuit."
		},
		{
			"timestamps": {
				"from": "00:08:35,000",
				"to": "00:08:38,000"
			},
			"offsets": {
				"from": 515000,
				"to": 518000
			},
			"text": " And that's the advantage of an oscilloscope."
		},
		{
			"timestamps": {
				"from": "00:08:38,000",
				"to": "00:08:40,000"
			},
			"offsets": {
				"from": 518000,
				"to": 520000
			},
			"text": " And also the advantage of a digital oscilloscope"
		},
		{
			"timestamps": {
				"from": "00:08:40,000",
				"to": "00:08:43,000"
			},
			"offsets": {
				"from": 520000,
				"to": 523000
			},
			"text": " is that you can actually"
		},
		{
			"timestamps": {
				"from": "00:08:43,000",
				"to": "00:08:46,000"
			},
			"offsets": {
				"from": 523000,
				"to": 526000
			},
			"text": " single shot trigger this as well."
		},
		{
			"timestamps": {
				"from": "00:08:46,000",
				"to": "00:08:48,000"
			},
			"offsets": {
				"from": 526000,
				"to": 528000
			},
			"text": " So you can go like that,"
		},
		{
			"timestamps": {
				"from": "00:08:48,000",
				"to": "00:08:50,000"
			},
			"offsets": {
				"from": 528000,
				"to": 530000
			},
			"text": " and it's captured the waveform,"
		},
		{
			"timestamps": {
				"from": "00:08:50,000",
				"to": "00:08:52,000"
			},
			"offsets": {
				"from": 530000,
				"to": 532000
			},
			"text": " and I can disconnect that completely,"
		},
		{
			"timestamps": {
				"from": "00:08:52,000",
				"to": "00:08:54,000"
			},
			"offsets": {
				"from": 532000,
				"to": 534000
			},
			"text": " and it's captured our waveform"
		},
		{
			"timestamps": {
				"from": "00:08:54,000",
				"to": "00:08:56,000"
			},
			"offsets": {
				"from": 534000,
				"to": 536000
			},
			"text": " so that we can go in there"
		},
		{
			"timestamps": {
				"from": "00:08:56,000",
				"to": "00:08:58,000"
			},
			"offsets": {
				"from": 536000,
				"to": 538000
			},
			"text": " and analyze it like that."
		},
		{
			"timestamps": {
				"from": "00:08:58,000",
				"to": "00:08:59,000"
			},
			"offsets": {
				"from": 538000,
				"to": 539000
			},
			"text": " And also,"
		},
		{
			"timestamps": {
				"from": "00:08:59,000",
				"to": "00:09:01,000"
			},
			"offsets": {
				"from": 539000,
				"to": 541000
			},
			"text": " the oscilloscope,"
		},
		{
			"timestamps": {
				"from": "00:09:01,000",
				"to": "00:09:05,000"
			},
			"offsets": {
				"from": 541000,
				"to": 545000
			},
			"text": " although this is more of a practicality"
		},
		{
			"timestamps": {
				"from": "00:09:05,000",
				"to": "00:09:09,000"
			},
			"offsets": {
				"from": 545000,
				"to": 549000
			},
			"text": " of actually getting something on the screen,"
		},
		{
			"timestamps": {
				"from": "00:09:09,000",
				"to": "00:09:12,000"
			},
			"offsets": {
				"from": 549000,
				"to": 552000
			},
			"text": " you see how it's a nice stable signal like that?"
		},
		{
			"timestamps": {
				"from": "00:09:12,000",
				"to": "00:09:15,000"
			},
			"offsets": {
				"from": 552000,
				"to": 555000
			},
			"text": " If we actually adjust our trigger level here,"
		},
		{
			"timestamps": {
				"from": "00:09:15,000",
				"to": "00:09:17,000"
			},
			"offsets": {
				"from": 555000,
				"to": 557000
			},
			"text": " which is this line here,"
		},
		{
			"timestamps": {
				"from": "00:09:17,000",
				"to": "00:09:18,000"
			},
			"offsets": {
				"from": 557000,
				"to": 558000
			},
			"text": " where it's going to trigger from,"
		},
		{
			"timestamps": {
				"from": "00:09:18,000",
				"to": "00:09:19,000"
			},
			"offsets": {
				"from": 558000,
				"to": 559000
			},
			"text": " if we go up here,"
		},
		{
			"timestamps": {
				"from": "00:09:19,000",
				"to": "00:09:24,000"
			},
			"offsets": {
				"from": 559000,
				"to": 564000
			},
			"text": " it should, well, not trigger."
		},
		{
			"timestamps": {
				"from": "00:09:24,000",
				"to": "00:09:26,000"
			},
			"offsets": {
				"from": 564000,
				"to": 566000
			},
			"text": " And it's not, okay?"
		},
		{
			"timestamps": {
				"from": "00:09:26,000",
				"to": "00:09:28,000"
			},
			"offsets": {
				"from": 566000,
				"to": 568000
			},
			"text": " So it's not updating that screen display anymore."
		},
		{
			"timestamps": {
				"from": "00:09:28,000",
				"to": "00:09:30,000"
			},
			"offsets": {
				"from": 568000,
				"to": 570000
			},
			"text": " It's not doing anything."
		},
		{
			"timestamps": {
				"from": "00:09:30,000",
				"to": "00:09:32,000"
			},
			"offsets": {
				"from": 570000,
				"to": 572000
			},
			"text": " But if you move it down,"
		},
		{
			"timestamps": {
				"from": "00:09:32,000",
				"to": "00:09:34,000"
			},
			"offsets": {
				"from": 572000,
				"to": 574000
			},
			"text": " bingo, it allows us to trigger the signal."
		},
		{
			"timestamps": {
				"from": "00:09:34,000",
				"to": "00:09:36,000"
			},
			"offsets": {
				"from": 574000,
				"to": 576000
			},
			"text": " But that's a whole 'nother video."
		},
		{
			"timestamps": {
				"from": "00:09:36,000",
				"to": "00:09:39,000"
			},
			"offsets": {
				"from": 576000,
				"to": 579000
			},
			"text": " But that is what an oscilloscope allows you to do."
		},
		{
			"timestamps": {
				"from": "00:09:39,000",
				"to": "00:09:43,000"
			},
			"offsets": {
				"from": 579000,
				"to": 583000
			},
			"text": " And if your signal is doing something like this,"
		},
		{
			"timestamps": {
				"from": "00:09:43,000",
				"to": "00:09:45,000"
			},
			"offsets": {
				"from": 583000,
				"to": 585000
			},
			"text": " I won't explain jitter,"
		},
		{
			"timestamps": {
				"from": "00:09:45,000",
				"to": "00:09:47,000"
			},
			"offsets": {
				"from": 585000,
				"to": 587000
			},
			"text": " but if your signal is jumping back and forth"
		},
		{
			"timestamps": {
				"from": "00:09:47,000",
				"to": "00:09:49,000"
			},
			"offsets": {
				"from": 587000,
				"to": 589000
			},
			"text": " really, really fast like that,"
		},
		{
			"timestamps": {
				"from": "00:09:49,000",
				"to": "00:09:51,000"
			},
			"offsets": {
				"from": 589000,
				"to": 591000
			},
			"text": " you'll be able to see it on your oscilloscope."
		},
		{
			"timestamps": {
				"from": "00:09:51,000",
				"to": "00:09:53,000"
			},
			"offsets": {
				"from": 591000,
				"to": 593000
			},
			"text": " So that's what an oscilloscope is."
		},
		{
			"timestamps": {
				"from": "00:09:53,000",
				"to": "00:09:54,000"
			},
			"offsets": {
				"from": 593000,
				"to": 594000
			},
			"text": " It's just like a multimeter."
		},
		{
			"timestamps": {
				"from": "00:09:54,000",
				"to": "00:09:55,000"
			},
			"offsets": {
				"from": 594000,
				"to": 595000
			},
			"text": " It measures voltage,"
		},
		{
			"timestamps": {
				"from": "00:09:55,000",
				"to": "00:09:57,000"
			},
			"offsets": {
				"from": 595000,
				"to": 597000
			},
			"text": " but does it with respect to time."
		},
		{
			"timestamps": {
				"from": "00:09:57,000",
				"to": "00:09:59,000"
			},
			"offsets": {
				"from": 597000,
				"to": 599000
			},
			"text": " Like that."
		},
		{
			"timestamps": {
				"from": "00:09:59,000",
				"to": "00:10:00,000"
			},
			"offsets": {
				"from": 599000,
				"to": 600000
			},
			"text": " Is that clear, Liam?"
		},
		{
			"timestamps": {
				"from": "00:10:00,000",
				"to": "00:10:01,000"
			},
			"offsets": {
				"from": 600000,
				"to": 601000
			},
			"text": " Yeah, yeah."
		},
		{
			"timestamps": {
				"from": "00:10:01,000",
				"to": "00:10:02,000"
			},
			"offsets": {
				"from": 601000,
				"to": 602000
			},
			"text": " Now you know what an oscilloscope is."
		},
		{
			"timestamps": {
				"from": "00:10:02,000",
				"to": "00:10:03,000"
			},
			"offsets": {
				"from": 602000,
				"to": 603000
			},
			"text": " Yep."
		},
		{
			"timestamps": {
				"from": "00:10:03,000",
				"to": "00:10:05,000"
			},
			"offsets": {
				"from": 603000,
				"to": 605000
			},
			"text": " Vital tool for seeing inside circuits."
		},
		{
			"timestamps": {
				"from": "00:10:05,000",
				"to": "00:10:07,000"
			},
			"offsets": {
				"from": 605000,
				"to": 607000
			},
			"text": " So if you're probing your circuits"
		},
		{
			"timestamps": {
				"from": "00:10:07,000",
				"to": "00:10:09,000"
			},
			"offsets": {
				"from": 607000,
				"to": 609000
			},
			"text": " or your modern stuff that you're used to,"
		},
		{
			"timestamps": {
				"from": "00:10:09,000",
				"to": "00:10:10,000"
			},
			"offsets": {
				"from": 609000,
				"to": 610000
			},
			"text": " how they work,"
		},
		{
			"timestamps": {
				"from": "00:10:10,000",
				"to": "00:10:12,000"
			},
			"offsets": {
				"from": 610000,
				"to": 612000
			},
			"text": " you can't see it with any other tool"
		},
		{
			"timestamps": {
				"from": "00:10:12,000",
				"to": "00:10:15,000"
			},
			"offsets": {
				"from": 612000,
				"to": 615000
			},
			"text": " except an oscilloscope."
		},
		{
			"timestamps": {
				"from": "00:10:15,000",
				"to": "00:10:16,000"
			},
			"offsets": {
				"from": 615000,
				"to": 616000
			},
			"text": " So there you go."
		},
		{
			"timestamps": {
				"from": "00:10:16,000",
				"to": "00:10:17,000"
			},
			"offsets": {
				"from": 616000,
				"to": 617000
			},
			"text": " Hope you enjoyed that."
		},
		{
			"timestamps": {
				"from": "00:10:17,000",
				"to": "00:10:18,000"
			},
			"offsets": {
				"from": 617000,
				"to": 618000
			},
			"text": " Catch you next time."
		}
	]
}
