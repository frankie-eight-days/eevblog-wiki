			"timestamps": {
				"from": "00:04:17,800",
				"to": "00:04:19,440"
			},
			"offsets": {
				"from": 257800,
				"to": 259440
			},
			"text": " Time for the Jedi to end?"
		},
		{
			"timestamps": {
				"from": "00:04:19,440",
				"to": "00:04:19,520"
			},
			"offsets": {
				"from": 259440,
				"to": 259520
			},
			"text": " Hmm."
		},
		{
			"timestamps": {
				"from": "00:04:26,940",
				"to": "00:04:35,160"
			},
			"offsets": {
				"from": 266940,
				"to": 275160
			},
			"text": " Speaking of which, it ended prematurely."
		},
		{
			"timestamps": {
				"from": "00:04:37,000",
				"to": "00:04:38,540"
			},
			"offsets": {
				"from": 277000,
				"to": 278540
			},
			"text": " Still got 12 seconds left."
		},
		{
			"timestamps": {
				"from": "00:04:39,000",
				"to": "00:04:39,960"
			},
			"offsets": {
				"from": 279000,
				"to": 279960
			},
			"text": " Oh, okay."
		},
		{
			"timestamps": {
				"from": "00:04:40,360",
				"to": "00:04:40,720"
			},
			"offsets": {
				"from": 280360,
				"to": 280720
			},
			"text": " Right."
		},
		{
			"timestamps": {
				"from": "00:04:43,180",
				"to": "00:04:43,700"
			},
			"offsets": {
				"from": 283180,
				"to": 283700
			},
			"text": " Wow."
		},
		{
			"timestamps": {
				"from": "00:04:43,840",
				"to": "00:04:45,720"
			},
			"offsets": {
				"from": 283840,
				"to": 285720
			},
			"text": " It's time for the Jedi to end?"
		},
		{
			"timestamps": {
				"from": "00:04:46,220",
				"to": "00:04:47,180"
			},
			"offsets": {
				"from": 286220,
				"to": 287180
			},
			"text": " Is that what he said?"
		},
		{
			"timestamps": {
				"from": "00:04:47,180",
				"to": "00:04:47,260"
			},
			"offsets": {
				"from": 287180,
				"to": 287260
			},
			"text": " Is that what he said?"
		},
		{
			"timestamps": {
				"from": "00:04:53,820",
				"to": "00:04:55,520"
			},
			"offsets": {
				"from": 293820,
				"to": 295520
			},
			"text": " It's time for the Jedi."
		},
		{
			"timestamps": {
				"from": "00:04:56,940",
				"to": "00:04:58,120"
			},
			"offsets": {
				"from": 296940,
				"to": 298120
			},
			"text": " To end."
		},
		{
			"timestamps": {
				"from": "00:04:59,900",
				"to": "00:05:00,740"
			},
			"offsets": {
				"from": 299900,
				"to": 300740
			},
			"text": " Wow."
		},
		{
			"timestamps": {
				"from": "00:05:01,840",
				"to": "00:05:03,300"
			},
			"offsets": {
				"from": 301840,
				"to": 303300
			},
			"text": " Didn't expect that."
		},
		{
			"timestamps": {
				"from": "00:05:07,660",
				"to": "00:05:09,120"
			},
			"offsets": {
				"from": 307660,
				"to": 309120
			},
			"text": " But he's training."
		},
		{
			"timestamps": {
				"from": "00:05:09,800",
				"to": "00:05:13,760"
			},
			"offsets": {
				"from": 309800,
				"to": 313760
			},
			"text": " Okay, so Luke's training Rey."
		},
		{
			"timestamps": {
				"from": "00:05:13,900",
				"to": "00:05:16,440"
			},
			"offsets": {
				"from": 313900,
				"to": 316440
			},
			"text": " We saw Rey training there."
		},
		{
			"timestamps": {
				"from": "00:05:17,440",
				"to": "00:05:23,640"
			},
			"offsets": {
				"from": 317440,
				"to": 323640
			},
			"text": " And she's going to become a Jedi, right?"
		},
		{
			"timestamps": {
				"from": "00:05:23,640",
				"to": "00:05:25,460"
			},
			"offsets": {
				"from": 323640,
				"to": 325460
			},
			"text": " How can the Jedi end?"
		},
		{
			"timestamps": {
				"from": "00:05:25,560",
				"to": "00:05:26,640"
			},
			"offsets": {
				"from": 325560,
				"to": 326640
			},
			"text": " Unless Luke is..."
		},
		{
			"timestamps": {
				"from": "00:05:26,940",
				"to": "00:05:33,500"
			},
			"offsets": {
				"from": 326940,
				"to": 333500
			},
			"text": " Or pessimistic that he's not going to be able to do the business and the Dark Side's going to win."
		},
		{
			"timestamps": {
				"from": "00:05:34,800",
				"to": "00:05:35,360"
			},
			"offsets": {
				"from": 334800,
				"to": 335360
			},
			"text": " Hmm."
		},
		{
			"timestamps": {
				"from": "00:05:36,700",
				"to": "00:05:37,260"
			},
			"offsets": {
				"from": 336700,
				"to": 337260
			},
			"text": " Interesting."
		},
		{
			"timestamps": {
				"from": "00:05:37,400",
				"to": "00:05:38,520"
			},
			"offsets": {
				"from": 337400,
				"to": 338520
			},
			"text": " Did not expect that."
		},
		{
			"timestamps": {
				"from": "00:05:39,720",
				"to": "00:05:40,260"
			},
			"offsets": {
				"from": 339720,
				"to": 340260
			},
			"text": " Wow."
		},
		{
			"timestamps": {
				"from": "00:05:40,980",
				"to": "00:05:43,480"
			},
			"offsets": {
				"from": 340980,
				"to": 343480
			},
			"text": " That was, yeah, that was a good teaser trial."
		},
		{
			"timestamps": {
				"from": "00:05:43,580",
				"to": "00:05:44,400"
			},
			"offsets": {
				"from": 343580,
				"to": 344400
			},
			"text": " They didn't show much."
		},
		{
			"timestamps": {
				"from": "00:05:44,480",
				"to": "00:05:46,760"
			},
			"offsets": {
				"from": 344480,
				"to": 346760
			},
			"text": " They showed, yeah, there was some battles."
		},
		{
			"timestamps": {
				"from": "00:05:47,240",
				"to": "00:05:49,000"
			},
			"offsets": {
				"from": 347240,
				"to": 349000
			},
			"text": " You know, there's some space battles."
		},
		{
			"timestamps": {
				"from": "00:05:49,420",
				"to": "00:05:52,040"
			},
			"offsets": {
				"from": 349420,
				"to": 352040
			},
			"text": " They showed that Rey was learning the Force."
		},
		{
			"timestamps": {
				"from": "00:05:52,160",
				"to": "00:05:55,040"
			},
			"offsets": {
				"from": 352160,
				"to": 355040
			},
			"text": " BB-8 and Poe are back, you know, in the thicker things."
		},
		{
			"timestamps": {
				"from": "00:05:55,500",
				"to": "00:05:56,760"
			},
			"offsets": {
				"from": 355500,
				"to": 356760
			},
			"text": " You know, on a ship exploding."
		},
		{
			"timestamps": {
				"from": "00:05:56,940",
				"to": "00:05:57,840"
			},
			"offsets": {
				"from": 356940,
				"to": 357840
			},
			"text": " And they'll escape."
		},
		{
			"timestamps": {
				"from": "00:05:58,120",
				"to": "00:06:00,660"
			},
			"offsets": {
				"from": 358120,
				"to": 360660
			},
			"text": " And then Poe will do his thing."
		},
		{
			"timestamps": {
				"from": "00:06:01,800",
				"to": "00:06:03,760"
			},
			"offsets": {
				"from": 361800,
				"to": 363760
			},
			"text": " And back on pod racing."
		},
		{
			"timestamps": {
				"from": "00:06:04,720",
				"to": "00:06:06,660"
			},
			"offsets": {
				"from": 364720,
				"to": 366660
			},
			"text": " And, yeah."
		},
		{
			"timestamps": {
				"from": "00:06:07,600",
				"to": "00:06:10,380"
			},
			"offsets": {
				"from": 367600,
				"to": 370380
			},
			"text": " And the battle between light and dark and all that sort of stuff."
		},
		{
			"timestamps": {
				"from": "00:06:10,500",
				"to": "00:06:13,380"
			},
			"offsets": {
				"from": 370500,
				"to": 373380
			},
			"text": " Didn't saw a shot of Kylo Ren there, but not much."
		},
		{
			"timestamps": {
				"from": "00:06:15,120",
				"to": "00:06:20,060"
			},
			"offsets": {
				"from": 375120,
				"to": 380060
			},
			"text": " So, yeah, that was a very well-crafted teaser trailer."
		},
		{
			"timestamps": {
				"from": "00:06:20,220",
				"to": "00:06:23,240"
			},
			"offsets": {
				"from": 380220,
				"to": 383240
			},
			"text": " And it just leaves you with, like, and they didn't show Luke up close."
		},
		{
			"timestamps": {
				"from": "00:06:23,240",
				"to": "00:06:26,660"
			},
			"offsets": {
				"from": 383240,
				"to": 386660
			},
			"text": " They just sort of, like, shadowy Luke in the cave."
		},
		{
			"timestamps": {
				"from": "00:06:26,940",
				"to": "00:06:33,220"
			},
			"offsets": {
				"from": 386940,
				"to": 393220
			},
			"text": " You know, the hermit cave where he's been holed up for however many decades."
		},
		{
			"timestamps": {
				"from": "00:06:33,560",
				"to": "00:06:33,920"
			},
			"offsets": {
				"from": 393560,
				"to": 393920
			},
			"text": " What is it?"
		},
		{
			"timestamps": {
				"from": "00:06:33,940",
				"to": "00:06:35,000"
			},
			"offsets": {
				"from": 393940,
				"to": 395000
			},
			"text": " Three decades or whatever."
		},
		{
			"timestamps": {
				"from": "00:06:35,260",
				"to": "00:06:39,060"
			},
			"offsets": {
				"from": 395260,
				"to": 399060
			},
			"text": " And because it is a real-time thing, the story's in real time."
		},
		{
			"timestamps": {
				"from": "00:06:39,060",
				"to": "00:06:41,180"
			},
			"offsets": {
				"from": 399060,
				"to": 401180
			},
			"text": " So, that was awesome."
		},
		{
			"timestamps": {
				"from": "00:06:43,240",
				"to": "00:06:46,020"
			},
			"offsets": {
				"from": 403240,
				"to": 406020
			},
			"text": " And they're very good at doing trailers."
		},
		{
			"timestamps": {
				"from": "00:06:46,900",
				"to": "00:06:47,780"
			},
			"offsets": {
				"from": 406900,
				"to": 407780
			},
			"text": " They are very good."
		},
		{
			"timestamps": {
				"from": "00:06:47,840",
				"to": "00:06:49,220"
			},
			"offsets": {
				"from": 407840,
				"to": 409220
			},
			"text": " You don't want to give away too much."
		},
		{
			"timestamps": {
				"from": "00:06:49,400",
				"to": "00:06:50,740"
			},
			"offsets": {
				"from": 409400,
				"to": 410740
			},
			"text": " And that didn't."
		},
		{
			"timestamps": {
				"from": "00:06:51,600",
				"to": "00:06:53,500"
			},
			"offsets": {
				"from": 411600,
				"to": 413500
			},
			"text": " So, that fuels speculations."
		},
		{
			"timestamps": {
				"from": "00:06:53,680",
				"to": "00:06:56,260"
			},
			"offsets": {
				"from": 413680,
				"to": 416260
			},
			"text": " And now I've got to go watch all the analysis videos."
		},
		{
			"timestamps": {
				"from": "00:06:56,460",
				"to": "00:06:56,720"
			},
			"offsets": {
				"from": 416460,
				"to": 416720
			},
			"text": " Because I'm..."
		},
		{
			"timestamps": {
				"from": "00:06:56,940",
				"to": "00:06:59,900"
			},
			"offsets": {
				"from": 416940,
				"to": 419900
			},
			"text": " You know, I'm not that good at analysing these sorts of things."
		},
		{
			"timestamps": {
				"from": "00:07:00,040",
				"to": "00:07:05,400"
			},
			"offsets": {
				"from": 420040,
				"to": 425400
			},
			"text": " I'm not as versed in the universe as most others."
		},
		{
			"timestamps": {
				"from": "00:07:05,500",
				"to": "00:07:06,720"
			},
			"offsets": {
				"from": 425500,
				"to": 426720
			},
			"text": " I'm hopeless at it."
		},
		{
			"timestamps": {
				"from": "00:07:07,180",
				"to": "00:07:08,580"
			},
			"offsets": {
				"from": 427180,
				"to": 428580
			},
			"text": " But, yeah, that's awesome."
		},
		{
			"timestamps": {
				"from": "00:07:08,960",
				"to": "00:07:09,260"
			},
			"offsets": {
				"from": 428960,
				"to": 429260
			},
			"text": " Wow."
		},
		{
			"timestamps": {
				"from": "00:07:09,980",
				"to": "00:07:10,600"
			},
			"offsets": {
				"from": 429980,
				"to": 430600
			},
			"text": " That's it."
		},
		{
			"timestamps": {
				"from": "00:07:11,020",
				"to": "00:07:13,880"
			},
			"offsets": {
				"from": 431020,
				"to": 433880
			},
			"text": " I watched the last Jedi trailer."
		},
		{
			"timestamps": {
				"from": "00:07:14,360",
				"to": "00:07:15,700"
			},
			"offsets": {
				"from": 434360,
				"to": 435700
			},
			"text": " Oh, man."
		},
		{
			"timestamps": {
				"from": "00:07:16,700",
				"to": "00:07:17,140"
			},
			"offsets": {
				"from": 436700,
				"to": 437140
			},
			"text": " Brilliant."
		},
		{
			"timestamps": {
				"from": "00:07:17,760",
				"to": "00:07:20,080"
			},
			"offsets": {
				"from": 437760,
				"to": 440080
			},
			"text": " Anyway, that's it."
		},
		{
			"timestamps": {
				"from": "00:07:20,080",
				"to": "00:07:23,660"
			},
			"offsets": {
				"from": 440080,
				"to": 443660
			},
			"text": " I guess, what, we might have to wait, like, six months for another one."
		},
		{
			"timestamps": {
				"from": "00:07:23,780",
				"to": "00:07:24,100"
			},
			"offsets": {
				"from": 443780,
				"to": 444100
			},
			"text": " Will we?"
		},
		{
			"timestamps": {
				"from": "00:07:24,160",
				"to": "00:07:25,920"
			},
			"offsets": {
				"from": 444160,
				"to": 445920
			},
			"text": " Before the real trailers come out."
		},
		{
			"timestamps": {
				"from": "00:07:26,000",
				"to": "00:07:26,580"
			},
			"offsets": {
				"from": 446000,
				"to": 446580
			},
			"text": " You know, one."
		},
		{
			"timestamps": {
				"from": "00:07:26,700",
				"to": "00:07:28,280"
			},
			"offsets": {
				"from": 446700,
				"to": 448280
			},
			"text": " And maybe two or something like that."
		},
		{
			"timestamps": {
				"from": "00:07:28,320",
				"to": "00:07:30,200"
			},
			"offsets": {
				"from": 448320,
				"to": 450200
			},
			"text": " They usually do at least two trailers, don't they?"
		},
		{
			"timestamps": {
				"from": "00:07:30,240",
				"to": "00:07:31,740"
			},
			"offsets": {
				"from": 450240,
				"to": 451740
			},
			"text": " And then maybe an international version."
		},
		{
			"timestamps": {
				"from": "00:07:31,860",
				"to": "00:07:34,460"
			},
			"offsets": {
				"from": 451860,
				"to": 454460
			},
			"text": " You get another little tidbit thrown in there."
		},
		{
			"timestamps": {
				"from": "00:07:34,500",
				"to": "00:07:35,620"
			},
			"offsets": {
				"from": 454500,
				"to": 455620
			},
			"text": " Another bone thrown in."
		},
		{
			"timestamps": {
				"from": "00:07:35,960",
				"to": "00:07:36,980"
			},
			"offsets": {
				"from": 455960,
				"to": 456980
			},
			"text": " But, that's great."
		},
		{
			"timestamps": {
				"from": "00:07:38,500",
				"to": "00:07:38,860"
			},
			"offsets": {
				"from": 458500,
				"to": 458860
			},
			"text": " Awesome."
		},
		{
			"timestamps": {
				"from": "00:07:39,520",
				"to": "00:07:40,380"
			},
			"offsets": {
				"from": 459520,
				"to": 460380
			},
			"text": " Catch you next time."
		}
	]
}
