				"from": "00:00:55,000",
				"to": "00:00:56,000"
			},
			"offsets": {
				"from": 55000,
				"to": 56000
			},
			"text": " And this is the Dalek actually."
		},
		{
			"timestamps": {
				"from": "00:00:56,000",
				"to": "00:00:57,000"
			},
			"offsets": {
