	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:06,000"
			},
			"offsets": {
				"from": 0,
				"to": 6000
			},
			"text": " Our next presenter is going to tell us how we can not be just a consumer, but also be a creator, be a maker."
		},
		{
			"timestamps": {
				"from": "00:00:06,000",
				"to": "00:00:08,000"
			},
			"offsets": {
				"from": 6000,
				"to": 8000
			},
			"text": " So please welcome, David Luckwood."
		},
		{
			"timestamps": {
				"from": "00:00:16,000",
				"to": "00:00:20,000"
			},
			"offsets": {
				"from": 16000,
				"to": 20000
			},
			"text": " Be a maker, not just a consumer."
		},
		{
			"timestamps": {
				"from": "00:00:20,000",
				"to": "00:00:27,000"
			},
			"offsets": {
				"from": 20000,
				"to": 27000
			},
			"text": " I'm here tonight to persuade everyone here to get creative and to make things."
		},
		{
			"timestamps": {
				"from": "00:00:27,000",
				"to": "00:00:35,000"
			},
			"offsets": {
				"from": 27000,
				"to": 35000
			},
			"text": " And in fact, this is actually the slogan for a class that I teach at Sydney University Centre for Continuing Education."
		},
		{
			"timestamps": {
				"from": "00:00:35,000",
				"to": "00:00:39,000"
			},
			"offsets": {
				"from": 35000,
				"to": 39000
			},
			"text": " It's an evening and weekend class which is open to everyone."
		},
		{
			"timestamps": {
				"from": "00:00:39,000",
				"to": "00:00:43,000"
			},
			"offsets": {
				"from": 39000,
				"to": 43000
			},
			"text": " And the next class starts next week and we have a lot of fun there."
		},
		{
			"timestamps": {
				"from": "00:00:43,000",
				"to": "00:00:48,000"
			},
			"offsets": {
				"from": 43000,
				"to": 48000
			},
			"text": " We have ten people, we all get together and we have fun with computers."
		},
		{
			"timestamps": {
				"from": "00:00:48,000",
				"to": "00:00:52,000"
			},
			"offsets": {
				"from": 48000,
				"to": 52000
			},
			"text": " Now, if we think about the history of computing."
		},
		{
			"timestamps": {
				"from": "00:00:52,000",
				"to": "00:00:56,000"
			},
			"offsets": {
				"from": 52000,
				"to": 56000
			},
			"text": " When computers first started, they were big, important things locked away in rooms"
		},
		{
			"timestamps": {
				"from": "00:00:56,000",
				"to": "00:00:57,000"
			},
			"offsets": {
				"from": 56000,
				"to": 57000
			},
			"text": " which were only available to the public."
		},
		{
			"timestamps": {
				"from": "00:00:57,000",
				"to": "00:00:59,000"
			},
			"offsets": {
				"from": 57000,
				"to": 59000
			},
			"text": " They were only available to experts."
		},
		{
			"timestamps": {
				"from": "00:00:59,000",
				"to": "00:01:02,000"
			},
			"offsets": {
				"from": 59000,
				"to": 62000
			},
			"text": " If something went wrong, it would cost a fortune."
		},
		{
			"timestamps": {
				"from": "00:01:02,000",
				"to": "00:01:05,000"
			},
			"offsets": {
				"from": 62000,
				"to": 65000
			},
			"text": " Then we go forward to the 80s and things started to change."
		},
		{
			"timestamps": {
				"from": "00:01:05,000",
				"to": "00:01:08,000"
			},
			"offsets": {
				"from": 65000,
				"to": 68000
			},
			"text": " We started to see the growth of home computing."
		},
		{
			"timestamps": {
				"from": "00:01:08,000",
				"to": "00:01:11,000"
			},
			"offsets": {
				"from": 68000,
				"to": 71000
			},
			"text": " People could hack and tinker and create in their bedrooms."
		},
		{
			"timestamps": {
				"from": "00:01:11,000",
				"to": "00:01:16,000"
			},
			"offsets": {
				"from": 71000,
				"to": 76000
			},
			"text": " We saw great things like the Apple computer created by Steve Wozniak out of his garage."
		},
		{
			"timestamps": {
				"from": "00:01:16,000",
				"to": "00:01:20,000"
			},
			"offsets": {
				"from": 76000,
				"to": 80000
			},
			"text": " We can go forward to the 90s and things became even better."
		},
		{
			"timestamps": {
				"from": "00:01:20,000",
				"to": "00:01:22,000"
			},
			"offsets": {
				"from": 80000,
				"to": 82000
			},
			"text": " Things became even easier."
		},
		{
			"timestamps": {
				"from": "00:01:22,000",
				"to": "00:01:26,000"
			},
			"offsets": {
				"from": 82000,
				"to": 86000
			},
			"text": " We had powerful desktops, powerful laptops."
		},
		{
			"timestamps": {
				"from": "00:01:26,000",
				"to": "00:01:28,000"
			},
			"offsets": {
				"from": 86000,
				"to": 88000
			},
			"text": " So much more power at our fingertips."
		},
		{
			"timestamps": {
				"from": "00:01:28,000",
				"to": "00:01:30,000"
			},
			"offsets": {
				"from": 88000,
				"to": 90000
			},
			"text": " Things just become easier and easier."
		},
		{
			"timestamps": {
				"from": "00:01:30,000",
				"to": "00:01:34,000"
			},
			"offsets": {
				"from": 90000,
				"to": 94000
			},
			"text": " And if we think about today, we are inundated with riches."
		},
		{
			"timestamps": {
				"from": "00:01:34,000",
				"to": "00:01:40,000"
			},
			"offsets": {
				"from": 94000,
				"to": 100000
			},
			"text": " We have smartphones, we have powerful laptops, we have consoles, we have tablets."
		},
		{
			"timestamps": {
				"from": "00:01:40,000",
				"to": "00:01:42,000"
			},
			"offsets": {
				"from": 100000,
				"to": 102000
			},
			"text": " We have so much available to us."
		},
		{
			"timestamps": {
				"from": "00:01:42,000",
				"to": "00:01:44,000"
			},
			"offsets": {
				"from": 102000,
				"to": 104000
			},
			"text": " But something is missing."
		},
		{
			"timestamps": {
				"from": "00:01:44,000",
				"to": "00:01:46,000"
			},
			"offsets": {
				"from": 104000,
				"to": 106000
			},
			"text": " Something is wrong."
		},
		{
			"timestamps": {
				"from": "00:01:46,000",
				"to": "00:01:49,000"
			},
			"offsets": {
				"from": 106000,
				"to": 109000
			},
			"text": " How does this stuff actually work?"
		},
		{
			"timestamps": {
				"from": "00:01:49,000",
				"to": "00:01:55,000"
			},
			"offsets": {
				"from": 109000,
				"to": 115000
			},
			"text": " So when you press a key on your keyboard, when you swipe your finger across your smartphone,"
		},
		{
			"timestamps": {
				"from": "00:01:55,000",
				"to": "00:01:58,000"
			},
			"offsets": {
				"from": 115000,
				"to": 118000
			},
			"text": " what is actually technically happening behind the scenes?"
		},
		{
			"timestamps": {
				"from": "00:01:58,000",
				"to": "00:02:01,000"
			},
			"offsets": {
				"from": 118000,
				"to": 121000
			},
			"text": " How many of us actually know how this stuff works?"
		},
		{
			"timestamps": {
				"from": "00:02:01,000",
				"to": "00:02:03,000"
			},
			"offsets": {
				"from": 121000,
				"to": 123000
			},
			"text": " And this is where this comes in."
		},
		{
			"timestamps": {
				"from": "00:02:03,000",
				"to": "00:02:06,000"
			},
			"offsets": {
				"from": 123000,
				"to": 126000
			},
			"text": " This is a Raspberry Pi."
		},
		{
			"timestamps": {
				"from": "00:02:06,000",
				"to": "00:02:12,000"
			},
			"offsets": {
				"from": 126000,
				"to": 132000
			},
			"text": " It's a small, awesome computer built to inspire a generation of learners."
		},
		{
			"timestamps": {
				"from": "00:02:12,000",
				"to": "00:02:16,000"
			},
			"offsets": {
				"from": 132000,
				"to": 136000
			},
			"text": " And you can see there, it looks like pretty technical and hard to use."
		},
		{
			"timestamps": {
				"from": "00:02:16,000",
				"to": "00:02:19,000"
			},
			"offsets": {
				"from": 136000,
				"to": 139000
			},
			"text": " This is what you actually get when you order it."
		},
		{
			"timestamps": {
				"from": "00:02:19,000",
				"to": "00:02:20,000"
			},
			"offsets": {
				"from": 139000,
				"to": 140000
			},
			"text": " So it's a circuit board."
		},
		{
			"timestamps": {
				"from": "00:02:20,000",
				"to": "00:02:22,000"
			},
			"offsets": {
				"from": 140000,
				"to": 142000
			},
			"text": " You have to hook it up."
		},
		{
			"timestamps": {
				"from": "00:02:22,000",
				"to": "00:02:24,000"
			},
			"offsets": {
				"from": 142000,
				"to": 144000
			},
			"text": " But it's actually a lot of fun to do."
		},
		{
			"timestamps": {
				"from": "00:02:24,000",
				"to": "00:02:26,000"
			},
			"offsets": {
				"from": 144000,
				"to": 146000
			},
			"text": " And it's very easy to use."
		},
		{
			"timestamps": {
				"from": "00:02:26,000",
				"to": "00:02:30,000"
			},
			"offsets": {
				"from": 146000,
				"to": 150000
			},
			"text": " You can see here we've got pins which allow it to easily connect up to hardware."
		},
		{
			"timestamps": {
				"from": "00:02:30,000",
				"to": "00:02:34,000"
			},
			"offsets": {
				"from": 150000,
				"to": 154000
			},
			"text": " And you can learn so much about computing by putting it together."
		},
		{
			"timestamps": {
				"from": "00:02:34,000",
				"to": "00:02:37,000"
			},
			"offsets": {
				"from": 154000,
				"to": 157000
			},
			"text": " And you don't even need much to put it together."
		},
		{
			"timestamps": {
				"from": "00:02:37,000",
				"to": "00:02:41,000"
			},
			"offsets": {
				"from": 157000,
				"to": 161000
			},
			"text": " The kind of things you'll need are things you'll find just about your house."
		},
		{
			"timestamps": {
				"from": "00:02:41,000",
				"to": "00:02:45,000"
			},
			"offsets": {
				"from": 161000,
				"to": 165000
			},
			"text": " Keyboard, an HDMI cable, a mobile phone charger."
		},
		{
			"timestamps": {
				"from": "00:02:45,000",
				"to": "00:02:49,000"
			},
			"offsets": {
				"from": 165000,
				"to": 169000
			},
			"text": " The great thing about this is it keeps the cost extremely low."
		},
		{
			"timestamps": {
				"from": "00:02:49,000",
				"to": "00:02:53,000"
			},
			"offsets": {
				"from": 169000,
				"to": 173000
			},
			"text": " This only costs, including taxes, $42."
		},
		{
			"timestamps": {
				"from": "00:02:53,000",
				"to": "00:02:55,000"
			},
			"offsets": {
				"from": 173000,
				"to": 175000
			},
			"text": " Price of a couple of pieces."
		},
		{
			"timestamps": {
				"from": "00:02:55,000",
				"to": "00:03:02,000"
			},
			"offsets": {
				"from": 175000,
				"to": 182000
			},
			"text": " So there's absolutely no excuse for every single person in here not to go out and buy a Raspberry Pi."
		},
		{
			"timestamps": {
				"from": "00:03:02,000",
				"to": "00:03:04,000"
			},
			"offsets": {
				"from": 182000,
				"to": 184000
			},
			"text": " Tonight, after, popular."
		},
		{
			"timestamps": {
				"from": "00:03:04,000",
				"to": "00:03:06,000"
			},
			"offsets": {
				"from": 184000,
				"to": 186000
			},
			"text": " And you can learn great things."
		},
		{
			"timestamps": {
				"from": "00:03:06,000",
				"to": "00:03:10,000"
			},
			"offsets": {
				"from": 186000,
				"to": 190000
			},
			"text": " You can learn, if you've ever heard about operating system Linux and you want to get involved."
		},
		{
			"timestamps": {
				"from": "00:03:10,000",
				"to": "00:03:12,000"
			},
			"offsets": {
				"from": 190000,
				"to": 192000
			},
			"text": " You can put Linux in here."
		},
		{
			"timestamps": {
				"from": "00:03:12,000",
				"to": "00:03:15,000"
			},
			"offsets": {
				"from": 192000,
				"to": 195000
			},
			"text": " If you ever thought, \"Hey, I'd like to learn a bit of programming.\""
		},
		{
			"timestamps": {
				"from": "00:03:15,000",
				"to": "00:03:19,000"
			},
			"offsets": {
				"from": 195000,
				"to": 199000
			},
			"text": " You can learn Python, which is a really beautiful and easy to use language."
		},
		{
			"timestamps": {
				"from": "00:03:19,000",
				"to": "00:03:22,000"
			},
			"offsets": {
				"from": 199000,
				"to": 202000
			},
			"text": " And when you take Linux and Python, put them together."
		},
		{
			"timestamps": {
				"from": "00:03:22,000",
				"to": "00:03:26,000"
			},
			"offsets": {
				"from": 202000,
				"to": 206000
			},
			"text": " You can start doing really cool things with hardware."
		},
		{
			"timestamps": {
				"from": "00:03:26,000",
				"to": "00:03:28,000"
			},
			"offsets": {
				"from": 206000,
				"to": 208000
			},
			"text": " And this is where the magic happens."
		},
		{
			"timestamps": {
				"from": "00:03:28,000",
				"to": "00:03:32,000"
			},
			"offsets": {
				"from": 208000,
				"to": 212000
			},
			"text": " In fact, this here is a passive infrared detector."
		},
		{
			"timestamps": {
				"from": "00:03:32,000",
				"to": "00:03:34,000"
			},
			"offsets": {
				"from": 212000,
				"to": 214000
			},
			"text": " It costs $3 on eBay."
		},
		{
			"timestamps": {
				"from": "00:03:34,000",
				"to": "00:03:36,000"
			},
			"offsets": {
				"from": 214000,
				"to": 216000
			},
			"text": " Really easy to get hold of."
		},
		{
			"timestamps": {
				"from": "00:03:36,000",
				"to": "00:03:40,000"
			},
			"offsets": {
				"from": 216000,
				"to": 220000
			},
			"text": " And it actually detects motion within a range of 7 meters."
		},
		{
			"timestamps": {
				"from": "00:03:40,000",
				"to": "00:03:47,000"
			},
			"offsets": {
				"from": 220000,
				"to": 227000
			},
			"text": " So if a human or a cat or anything passes by, it can send a signal to this little computer here."
		},
		{
			"timestamps": {
				"from": "00:03:47,000",
				"to": "00:03:51,000"
			},
			"offsets": {
				"from": 227000,
				"to": 231000
			},
			"text": " And we can hook this up with other things."
		},
		{
			"timestamps": {
				"from": "00:03:51,000",
				"to": "00:03:56,000"
			},
			"offsets": {
				"from": 231000,
				"to": 236000
			},
			"text": " This is a USB missile launcher, which we can program to fire missiles."
		},
		{
			"timestamps": {
				"from": "00:03:56,000",
				"to": "00:03:59,000"
			},
			"offsets": {
				"from": 236000,
				"to": 239000
			},
			"text": " So you can build a really fun little detection system."
		},
		{
			"timestamps": {
				"from": "00:03:59,000",
				"to": "00:04:03,000"
			},
			"offsets": {
				"from": 239000,
				"to": 243000
			},
			"text": " It's putting together your programming knowledge and a couple of cheap bits of hardware."
		},
		{
			"timestamps": {
				"from": "00:04:03,000",
				"to": "00:04:10,000"
			},
			"offsets": {
				"from": 243000,
				"to": 250000
			},
			"text": " This is a picture taken from the upper atmosphere from a Raspberry Pi with a camera attached."
		},
		{
			"timestamps": {
				"from": "00:04:10,000",
				"to": "00:04:13,000"
			},
			"offsets": {
				"from": 250000,
				"to": 253000
			},
			"text": " Someone attached it to a weather balloon, sent it up into the atmosphere."
		},
		{
			"timestamps": {
				"from": "00:04:13,000",
				"to": "00:04:15,000"
			},
			"offsets": {
				"from": 253000,
				"to": 255000
			},
			"text": " What an amazing project to do."
		},
		{
			"timestamps": {
				"from": "00:04:15,000",
				"to": "00:04:17,000"
			},
			"offsets": {
				"from": 255000,
				"to": 257000
			},
			"text": " And very cheap to do."
		},
