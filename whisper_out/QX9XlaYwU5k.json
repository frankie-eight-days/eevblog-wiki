				"to": "00:04:04,100"
			},
			"offsets": {
				"from": 243660,
				"to": 244100
			},
			"text": " Fantastic."
		},
		{
			"timestamps": {
				"from": "00:04:04,260",
				"to": "00:04:07,120"
			},
			"offsets": {
				"from": 244260,
				"to": 247120
			},
			"text": " Now, it is like a local focus."
		},
		{
