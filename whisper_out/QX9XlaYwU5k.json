				"to": "00:03:32,380"
			},
			"offsets": {
				"from": 209360,
				"to": 212380
			},
			"text": " That's my ugly mugs even in there. Awesome. Thanks, Rob."
		},
		{
			"timestamps": {
				"from": "00:03:33,220",
				"to": "00:03:35,060"
			},
			"offsets": {
				"from": 213220,
				"to": 215060
			},
			"text": " But, yeah, this is brilliant."
		},
		{
			"timestamps": {
				"from": "00:03:35,200",
				"to": "00:03:38,600"
			},
			"offsets": {
				"from": 215200,
				"to": 218600
			},
			"text": " I never thought I'd see the day a new Australian electronics magazine."
		},
		{
			"timestamps": {
				"from": "00:03:39,380",
				"to": "00:03:41,360"
			},
			"offsets": {
				"from": 219380,
				"to": 221360
			},
			"text": " And, of course, silicon chip are still going."
		},
		{
			"timestamps": {
