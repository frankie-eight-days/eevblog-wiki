				"to": 302600
			},
			"text": " Now, a lot of people will say, what is the purpose of a printed magazine like this?"
		},
		{
			"timestamps": {
				"from": "00:05:02,660",
				"to": "00:05:06,060"
			},
			"offsets": {
				"from": 302660,
				"to": 306060
			},
			"text": " And these days, right, with the Internet, everything's free."
		},
		{
			"timestamps": {
				"from": "00:05:06,180",
				"to": "00:05:08,660"
			},
			"offsets": {
				"from": 306180,
				"to": 308660
			},
			"text": " Why would I pay money for a magazine like this?"
		},
		{
			"timestamps": {
				"from": "00:05:08,740",
				"to": "00:05:14,480"
			},
			"offsets": {
				"from": 308740,
				"to": 314480
			},
			"text": " One is that it's much higher quality content visually."
		},
		{
			"timestamps": {
				"from": "00:05:14,480",
				"to": "00:05:22,780"
			},
			"offsets": {
				"from": 314480,
				"to": 322780
			},
			"text": " And it's all, like, yeah, you can get your daily sign up to whatever electronics news blog project blog that you want."
		},
		{
			"timestamps": {
				"from": "00:05:22,880",
				"to": "00:05:23,700"
			},
			"offsets": {
				"from": 322880,
				"to": 323700
			},
			"text": " Subscribe to it."
		},
		{
			"timestamps": {
				"from": "00:05:23,780",
				"to": "00:05:25,240"
			},
			"offsets": {
				"from": 323780,
				"to": 325240
			},
			"text": " It doesn't have the same."
		},
		{
			"timestamps": {
				"from": "00:05:25,560",
				"to": "00:05:26,720"
			},
			"offsets": {
				"from": 325560,
				"to": 326720
			},
			"text": " It's not the same vibe."
		},
		{
			"timestamps": {
				"from": "00:05:27,020",
				"to": "00:05:28,940"
			},
			"offsets": {
				"from": 327020,
				"to": 328940
			},
			"text": " It's all about the vibe of the magazine."
		},
		{
			"timestamps": {
				"from": "00:05:28,940",
				"to": "00:05:34,720"
			},
			"offsets": {
				"from": 328940,
				"to": 334720
			},
			"text": " And the other thing is, what would be the purpose of having your projects published in here?"
		},
		{
			"timestamps": {
				"from": "00:05:35,020",
				"to": "00:05:36,300"
			},
			"offsets": {
				"from": 335020,
				"to": 336300
			},
			"text": " Now, here's the kicker."
		},
		{
			"timestamps": {
				"from": "00:05:36,420",
				"to": "00:05:41,600"
			},
			"offsets": {
				"from": 336420,
				"to": 341600
			},
			"text": " I still think magazines are a huge deal, right?"
		},
		{
			"timestamps": {
				"from": "00:05:41,760",
				"to": "00:05:42,080"
			},
			"offsets": {
				"from": 341760,
				"to": 342080
			},
			"text": " Why?"
		},
		{
			"timestamps": {
				"from": "00:05:42,700",
				"to": "00:05:48,840"
			},
			"offsets": {
				"from": 342700,
				"to": 348840
			},
			"text": " Because to put on your resume, if you're, you know, some student or hobbyist or whatever,"
		},
		{
			"timestamps": {
				"from": "00:05:48,880",
				"to": "00:05:52,640"
			},
			"offsets": {
				"from": 348880,
				"to": 352640
			},
			"text": " you're trying to get a job in the industry, of course, the best thing you can do is,"
		},
		{
			"timestamps": {
				"from": "00:05:52,800",
				"to": "00:05:55,020"
			},
			"offsets": {
				"from": 352800,
				"to": 355020
			},
			"text": " do your own projects and publish them."
		},
		{
			"timestamps": {
				"from": "00:05:55,260",
				"to": "00:06:00,840"
			},
			"offsets": {
				"from": 355260,
				"to": 360840
			},
			"text": " And there's still, this day, no better place to publish than an electronics magazine."
		},
		{
			"timestamps": {
				"from": "00:06:01,140",
				"to": "00:06:08,360"
			},
			"offsets": {
				"from": 361140,
				"to": 368360
			},
			"text": " Putting on your resume that your project was published in an electronics magazine is still number one."
		},
		{
			"timestamps": {
				"from": "00:06:08,780",
				"to": "00:06:14,580"
			},
			"offsets": {
				"from": 368780,
				"to": 374580
			},
			"text": " So I think it has a massive, valuable contribution right there."
		},
		{
			"timestamps": {
				"from": "00:06:14,660",
				"to": "00:06:22,680"
			},
			"offsets": {
				"from": 374660,
				"to": 382680
			},
			"text": " And I think a purpose of a magazine like this should be to, you know, really highly,"
		},
		{
			"timestamps": {
				"from": "00:06:22,800",
				"to": "00:06:29,780"
			},
			"offsets": {
				"from": 382800,
				"to": 389780
			},
			"text": " vet these projects so that really only the, you know, real novel and the best of the best ones get in here."
		},
		{
			"timestamps": {
				"from": "00:06:29,880",
				"to": "00:06:34,100"
			},
			"offsets": {
				"from": 389880,
				"to": 394100
			},
			"text": " At least novel, you know, like give youngsters a chance and stuff like that, of course,"
		},
		{
			"timestamps": {
				"from": "00:06:34,180",
				"to": "00:06:39,860"
			},
			"offsets": {
				"from": 394180,
				"to": 399860
			},
			"text": " because I got my start getting published in electronics magazines way back in the day."
		},
		{
			"timestamps": {
				"from": "00:06:40,060",
				"to": "00:06:43,460"
			},
			"offsets": {
				"from": 400060,
				"to": 403460
			},
			"text": " And I think it's still a valuable thing, a valuable service."
		},
		{
			"timestamps": {
				"from": "00:06:43,700",
				"to": "00:06:48,820"
			},
			"offsets": {
				"from": 403700,
				"to": 408820
			},
			"text": " Like, there's websites like, you know, you might get your project published on Hackaday or something like that."
		},
		{
			"timestamps": {
				"from": "00:06:48,900",
				"to": "00:06:50,340"
			},
			"offsets": {
				"from": 408900,
				"to": 410340
			},
			"text": " And, yeah, it's kind of a big deal."
		},
		{
			"timestamps": {
				"from": "00:06:50,340",
				"to": "00:06:52,680"
			},
			"offsets": {
				"from": 410340,
				"to": 412680
			},
			"text": " But putting that on your resume, oh, I got, you know,"
		},
		{
			"timestamps": {
				"from": "00:06:52,800",
				"to": "00:06:55,420"
			},
			"offsets": {
				"from": 412800,
				"to": 415420
			},
			"text": " like there's just so many projects that go in there."
		},
		{
			"timestamps": {
				"from": "00:06:55,520",
				"to": "00:06:59,440"
			},
			"offsets": {
				"from": 415520,
				"to": 419440
			},
			"text": " This one's, you know, the magazines could be a bit more selective in that respect."
		},
		{
			"timestamps": {
				"from": "00:06:59,520",
				"to": "00:07:05,780"
			},
			"offsets": {
				"from": 419520,
				"to": 425780
			},
			"text": " It can be more prestigious to get your project published and featured in a magazine like Diode."
		},
		{
			"timestamps": {
				"from": "00:07:05,920",
				"to": "00:07:06,600"
			},
			"offsets": {
				"from": 425920,
				"to": 426600
			},
			"text": " So there you go."
		},
		{
			"timestamps": {
				"from": "00:07:07,040",
				"to": "00:07:10,200"
			},
			"offsets": {
				"from": 427040,
				"to": 430200
			},
			"text": " Because, like, Silicon Chip aren't doing a similar thing."
		},
		{
			"timestamps": {
				"from": "00:07:10,360",
				"to": "00:07:12,280"
			},
			"offsets": {
				"from": 430360,
				"to": 432280
			},
			"text": " There's the, is Elector still going?"
		},
		{
			"timestamps": {
				"from": "00:07:12,400",
				"to": "00:07:12,900"
			},
			"offsets": {
				"from": 432400,
				"to": 432900
			},
			"text": " I don't know."
		},
		{
			"timestamps": {
				"from": "00:07:12,980",
				"to": "00:07:15,700"
			},
			"offsets": {
				"from": 432980,
				"to": 435700
			},
			"text": " I'm not into the overseas electronic magazines."
		},
		{
			"timestamps": {
				"from": "00:07:15,880",
				"to": "00:07:19,920"
			},
			"offsets": {
				"from": 435880,
				"to": 439920
			},
			"text": " But Silicon Chip do mostly their own in-house projects, which is a different kind of cool."
		},
		{
			"timestamps": {
				"from": "00:07:19,920",
				"to": "00:07:22,480"
			},
			"offsets": {
				"from": 439920,
				"to": 442480
			},
			"text": " But you can get your own projects published in there, of course."
		},
		{
			"timestamps": {
				"from": "00:07:22,800",
				"to": "00:07:23,700"
			},
			"offsets": {
				"from": 442800,
				"to": 443700
			},
			"text": " Which is awesome."
		},
		{
			"timestamps": {
				"from": "00:07:23,800",
				"to": "00:07:26,700"
			},
			"offsets": {
				"from": 443800,
				"to": 446700
			},
			"text": " But now there's another one where you can get your stuff published."
		},
		{
			"timestamps": {
				"from": "00:07:27,280",
				"to": "00:07:28,020"
			},
			"offsets": {
				"from": 447280,
				"to": 448020
			},
			"text": " Absolutely brilliant."
		},
		{
			"timestamps": {
				"from": "00:07:28,120",
				"to": "00:07:34,360"
			},
			"offsets": {
				"from": 448120,
				"to": 454360
			},
			"text": " So I think that's where the value still lies in these magazines is people getting projects published."
		},
		{
			"timestamps": {
				"from": "00:07:34,460",
				"to": "00:07:35,600"
			},
			"offsets": {
				"from": 454460,
				"to": 455600
			},
			"text": " And I just like the form factor."
		},
		{
			"timestamps": {
				"from": "00:07:35,900",
				"to": "00:07:37,860"
			},
			"offsets": {
				"from": 455900,
				"to": 457860
			},
			"text": " So, anyway, we'll take a quick look inside."
		},
		{
			"timestamps": {
				"from": "00:07:37,980",
				"to": "00:07:41,100"
			},
			"offsets": {
				"from": 457980,
				"to": 461100
			},
			"text": " I won't completely spoil it through every page."
		},
		{
			"timestamps": {
				"from": "00:07:41,160",
				"to": "00:07:43,520"
			},
			"offsets": {
				"from": 461160,
				"to": 463520
			},
			"text": " But let's have a look at the production quality, shall we?"
		},
		{
			"timestamps": {
				"from": "00:07:43,860",
				"to": "00:07:46,260"
			},
			"offsets": {
				"from": 463860,
				"to": 466260
			},
			"text": " And please excuse the crudity of this shot."
		},
		{
			"timestamps": {
				"from": "00:07:46,300",
				"to": "00:07:48,680"
			},
			"offsets": {
				"from": 466300,
				"to": 468680
			},
			"text": " I didn't have time to build it to scale or to paint it."
		},
		{
			"timestamps": {
				"from": "00:07:48,860",
				"to": "00:07:52,520"
			},
			"offsets": {
				"from": 468860,
				"to": 472520
			},
			"text": " It's good to see that they got a lot of advertisers in here, though."
		},
		{
			"timestamps": {
				"from": "00:07:52,800",
				"to": "00:07:53,960"
			},
			"offsets": {
				"from": 472800,
				"to": 473960
			},
			"text": " Which is fantastic."
		},
		{
			"timestamps": {
				"from": "00:07:54,100",
				"to": "00:08:00,400"
			},
			"offsets": {
				"from": 474100,
				"to": 480400
			},
			"text": " John from Tronics Lab, who's the big Artefruit distributor here in Australia."
		},
		{
			"timestamps": {
				"from": "00:08:00,480",
				"to": "00:08:01,100"
			},
			"offsets": {
				"from": 480480,
				"to": 481100
			},
			"text": " G'day, John."
		},
		{
			"timestamps": {
				"from": "00:08:01,180",
				"to": "00:08:07,380"
			},
			"offsets": {
				"from": 481180,
				"to": 487380
			},
			"text": " He's basically first page after the editorial and everything."
		},
		{
			"timestamps": {
				"from": "00:08:07,460",
				"to": "00:08:12,860"
			},
			"offsets": {
				"from": 487460,
				"to": 492860
			},
			"text": " So they've got their own in-house design, like writing team and stuff like that."
		},
		{
			"timestamps": {
				"from": "00:08:12,940",
				"to": "00:08:17,300"
			},
			"offsets": {
				"from": 492940,
				"to": 497300
			},
			"text": " Here's the table of contents for the latest edition here."
		},
		{
			"timestamps": {
				"from": "00:08:17,380",
				"to": "00:08:22,700"
			},
			"offsets": {
				"from": 497380,
				"to": 502700
			},
			"text": " It's basically a whole ton of, they've got an education section, project section,"
		},
		{
			"timestamps": {
				"from": "00:08:22,800",
				"to": "00:08:27,840"
			},
			"offsets": {
				"from": 502800,
				"to": 507840
			},
			"text": " and features, you know, various industry stuff that they want to feature."
		},
		{
			"timestamps": {
				"from": "00:08:28,000",
				"to": "00:08:33,540"
			},
			"offsets": {
				"from": 508000,
				"to": 513540
			},
			"text": " And there's my ugly mug, thanking people who helped get them up and running."
		},
		{
			"timestamps": {
				"from": "00:08:33,800",
				"to": "00:08:38,620"
			},
			"offsets": {
				"from": 513800,
				"to": 518620
			},
			"text": " The new, you know, news for the new 5 nanometer chip and stuff like that."
		},
		{
			"timestamps": {
				"from": "00:08:38,680",
				"to": "00:08:40,980"
			},
			"offsets": {
				"from": 518680,
				"to": 520980
			},
			"text": " And then they've got projects."
		},
		{
			"timestamps": {
				"from": "00:08:41,140",
				"to": "00:08:44,080"
			},
			"offsets": {
				"from": 521140,
				"to": 524080
			},
			"text": " The Raspberry Pi starting, well, like a prototype."
		},
		{
			"timestamps": {
				"from": "00:08:44,260",
				"to": "00:08:45,120"
			},
			"offsets": {
				"from": 524260,
				"to": 525120
			},
			"text": " These are just features."
		},
		{
			"timestamps": {
				"from": "00:08:45,440",
				"to": "00:08:47,400"
			},
			"offsets": {
				"from": 525440,
				"to": 527400
			},
			"text": " So these aren't the articles yet."
		},
		{
			"timestamps": {
				"from": "00:08:47,400",
				"to": "00:08:51,760"
			},
			"offsets": {
				"from": 527400,
				"to": 531760
			},
			"text": " But as you can see, very nice, very nice production quality."
		},
		{
			"timestamps": {
				"from": "00:08:52,800",
				"to": "00:09:00,360"
			},
			"offsets": {
				"from": 532800,
				"to": 540360
			},
			"text": " A Bosch ads and then a Pi robot and a photo booth of a nerd, which is a badge of honor."
		},
		{
			"timestamps": {
				"from": "00:09:00,880",
				"to": "00:09:05,920"
			},
			"offsets": {
				"from": 540880,
				"to": 545920
			},
			"text": " And, of course, it's heavily advertised by the two local electronics providers,"
		},
		{
			"timestamps": {
				"from": "00:09:06,080",
				"to": "00:09:07,920"
			},
			"offsets": {
				"from": 546080,
				"to": 547920
			},
			"text": " JCAR and Altronics."
		},
		{
			"timestamps": {
				"from": "00:09:08,360",
				"to": "00:09:15,660"
			},
			"offsets": {
				"from": 548360,
				"to": 555660
			},
			"text": " And, look, the excellent quality of the step-by-step guides and the diagrams and everything else."
		},
		{
			"timestamps": {
				"from": "00:09:15,720",
				"to": "00:09:16,100"
			},
			"offsets": {
				"from": 555720,
				"to": 556100
			},
			"text": " Fantastic."
		},
		{
			"timestamps": {
				"from": "00:09:16,100",
				"to": "00:09:17,220"
			},
			"offsets": {
				"from": 556100,
				"to": 557220
			},
			"text": " Are they getting that?"
		},
		{
			"timestamps": {
				"from": "00:09:17,280",
				"to": "00:09:21,340"
			},
			"offsets": {
				"from": 557280,
				"to": 561340
			},
			"text": " Isn't there a program which does the breadboard stuff like that?"
		},
		{
			"timestamps": {
				"from": "00:09:21,560",
				"to": "00:09:22,780"
			},
			"offsets": {
				"from": 561560,
				"to": 562780
			},
			"text": " Anyway, one thing you'll find."
		},
		{
			"timestamps": {
				"from": "00:09:22,860",
				"to": "00:09:25,780"
			},
			"offsets": {
				"from": 562860,
				"to": 565780
			},
			"text": " Is that they've got the parts list."
		},
		{
			"timestamps": {
				"from": "00:09:26,000",
				"to": "00:09:27,040"
			},
			"offsets": {
				"from": 566000,
				"to": 567040
			},
			"text": " Bill of Materials, fantastic."
		},
		{
			"timestamps": {
				"from": "00:09:27,200",
				"to": "00:09:29,700"
			},
			"offsets": {
				"from": 567200,
				"to": 569700
			},
			"text": " And they've got JCAR and Altronics part numbers."
		},
		{
			"timestamps": {
				"from": "00:09:29,820",
				"to": "00:09:31,780"
			},
			"offsets": {
				"from": 569820,
				"to": 571780
			},
			"text": " Now, this really localizes things."
		},
		{
			"timestamps": {
				"from": "00:09:32,040",
				"to": "00:09:37,000"
			},
			"offsets": {
				"from": 572040,
				"to": 577000
			},
			"text": " You know, if you're going to do that, I'd like to see maybe a DigiKey part number as well."
		},
		{
			"timestamps": {
				"from": "00:09:37,040",
				"to": "00:09:39,580"
			},
			"offsets": {
				"from": 577040,
				"to": 579580
			},
			"text": " Just to make it a bit more global, I think."
		},
		{
			"timestamps": {
				"from": "00:09:39,680",
				"to": "00:09:42,420"
			},
			"offsets": {
				"from": 579680,
				"to": 582420
			},
			"text": " I'm not, you know, okay, it's local focus."
		},
		{
			"timestamps": {
				"from": "00:09:42,540",
				"to": "00:09:46,920"
			},
			"offsets": {
				"from": 582540,
				"to": 586920
			},
			"text": " But I'm thinking that's not the best way to do it."
		},
		{
			"timestamps": {
				"from": "00:09:46,920",
				"to": "00:09:50,340"
			},
			"offsets": {
				"from": 586920,
				"to": 590340
			},
			"text": " Because you're going to get a global audience for a magazine like this, definitely."
		},
		{
			"timestamps": {
				"from": "00:09:50,720",
				"to": "00:09:52,780"
			},
			"offsets": {
				"from": 590720,
				"to": 592780
			},
			"text": " And they actually go into some detail."
		},
		{
			"timestamps": {
				"from": "00:09:52,960",
				"to": "00:09:55,920"
			},
			"offsets": {
				"from": 592960,
				"to": 595920
			},
			"text": " Of actually documenting the source code as well."
		},
		{
			"timestamps": {
				"from": "00:09:56,000",
				"to": "00:09:56,900"
			},
			"offsets": {
				"from": 596000,
				"to": 596900
			},
			"text": " Like each line."
		},
		{
			"timestamps": {
				"from": "00:09:57,160",
				"to": "00:10:02,800"
			},
			"offsets": {
				"from": 597160,
				"to": 602800
			},
			"text": " They, you know, really go into detailed descriptions of what pretty much each line of code does."
		},
		{
			"timestamps": {
				"from": "00:10:02,860",
				"to": "00:10:04,400"
			},
			"offsets": {
				"from": 602860,
				"to": 604400
			},
			"text": " So that's, you know, it's very impressive."
		},
		{
			"timestamps": {
				"from": "00:10:04,580",
				"to": "00:10:06,380"
			},
			"offsets": {
				"from": 604580,
				"to": 606380
			},
			"text": " Some might say too much, but eh."
		},
		{
			"timestamps": {
				"from": "00:10:06,660",
				"to": "00:10:08,980"
			},
			"offsets": {
				"from": 606660,
				"to": 608980
			},
			"text": " Then you've got projects like this one."
		},
		{
			"timestamps": {
				"from": "00:10:09,040",
				"to": "00:10:10,820"
			},
			"offsets": {
				"from": 609040,
				"to": 610820
			},
			"text": " And I won't go through the full project."
		},
		{
			"timestamps": {
				"from": "00:10:10,920",
				"to": "00:10:11,940"
			},
			"offsets": {
				"from": 610920,
				"to": 611940
			},
			"text": " But it's very impressive."
		},
		{
			"timestamps": {
				"from": "00:10:12,580",
				"to": "00:10:13,660"
			},
			"offsets": {
				"from": 612580,
				"to": 613660
			},
			"text": " Laid out very well."
		},
		{
			"timestamps": {
				"from": "00:10:13,660",
				"to": "00:10:15,480"
			},
			"offsets": {
				"from": 613660,
				"to": 615480
			},
			"text": " It's got, you know, photos of the contributors."
		},
		{
			"timestamps": {
				"from": "00:10:15,680",
				"to": "00:10:21,260"
			},
			"offsets": {
				"from": 615680,
				"to": 621260
			},
			"text": " Which I absolutely love with all their website and their Twitter contacts and other stuff."
		},
		{
			"timestamps": {
				"from": "00:10:21,460",
				"to": "00:10:21,780"
			},
			"offsets": {
				"from": 621460,
				"to": 621780
			},
			"text": " Terrific."
		},
		{
			"timestamps": {
				"from": "00:10:22,060",
				"to": "00:10:22,800"
			},
			"offsets": {
				"from": 622060,
				"to": 622800
			},
			"text": " And then they've got a..."
		},
		{
			"timestamps": {
				"from": "00:10:22,880",
				"to": "00:10:24,760"
			},
			"offsets": {
				"from": 622880,
				"to": 624760
			},
			"text": " Section they call the classroom."
		},
		{
			"timestamps": {
				"from": "00:10:24,940",
				"to": "00:10:30,060"
			},
			"offsets": {
				"from": 624940,
				"to": 630060
			},
			"text": " Which is what is electricity and go into power substations and how they all work and stuff like that."
		},
		{
			"timestamps": {
				"from": "00:10:30,200",
				"to": "00:10:30,400"
			},
			"offsets": {
				"from": 630200,
				"to": 630400
			},
			"text": " Neat."
		},
		{
			"timestamps": {
				"from": "00:10:30,400",
				"to": "00:10:32,420"
			},
			"offsets": {
				"from": 630400,
				"to": 632420
			},
			"text": " And then you've got more local advertisers."
		},
		{
			"timestamps": {
				"from": "00:10:33,060",
				"to": "00:10:35,520"
			},
			"offsets": {
				"from": 633060,
				"to": 635520
			},
			"text": " John Oxer from Freetronics, for example."
		},
		{
			"timestamps": {
				"from": "00:10:35,700",
				"to": "00:10:36,660"
			},
			"offsets": {
				"from": 635700,
				"to": 636660
			},
			"text": " Fantastic to see."
		},
		{
			"timestamps": {
				"from": "00:10:36,960",
				"to": "00:10:40,280"
			},
			"offsets": {
				"from": 636960,
				"to": 640280
			},
			"text": " And focus on other projects and stuff like that."
		},
		{
			"timestamps": {
				"from": "00:10:40,360",
				"to": "00:10:41,400"
			},
			"offsets": {
				"from": 640360,
				"to": 641400
			},
			"text": " Anyway, it is just..."
		},
		{
			"timestamps": {
				"from": "00:10:42,420",
				"to": "00:10:45,460"
			},
			"offsets": {
				"from": 642420,
				"to": 645460
			},
			"text": " Chock full of excellent."
		},
		{
			"timestamps": {
				"from": "00:10:45,620",
				"to": "00:10:48,200"
			},
			"offsets": {
				"from": 645620,
				"to": 648200
			},
			"text": " And all, like all the photos are top notch quality."
		},
		{
			"timestamps": {
				"from": "00:10:48,300",
				"to": "00:10:49,000"
			},
			"offsets": {
				"from": 648300,
				"to": 649000
			},
			"text": " It's just terrific."
		},
		{
			"timestamps": {
				"from": "00:10:49,380",
				"to": "00:10:50,160"
			},
			"offsets": {
				"from": 649380,
				"to": 650160
			},
			"text": " So there you have it."
		},
		{
			"timestamps": {
				"from": "00:10:50,220",
				"to": "00:10:51,400"
			},
			"offsets": {
				"from": 650220,
				"to": 651400
			},
			"text": " That's Diode Magazine."
		},
		{
			"timestamps": {
				"from": "00:10:52,800",
				"to": "00:10:56,460"
			},
			"offsets": {
				"from": 652800,
				"to": 656460
			},
			"text": " Huge thumbs up and hats off to Rob Bell and the team for getting this together."
		},
		{
			"timestamps": {
				"from": "00:10:56,620",
				"to": "00:10:58,420"
			},
			"offsets": {
				"from": 656620,
				"to": 658420
			},
			"text": " And please support them."
		},
		{
			"timestamps": {
				"from": "00:10:58,480",
				"to": "00:10:59,560"
			},
			"offsets": {
				"from": 658480,
				"to": 659560
			},
			"text": " I'll link it in down below."
		},
		{
			"timestamps": {
				"from": "00:10:59,700",
				"to": "00:11:02,240"
			},
			"offsets": {
				"from": 659700,
				"to": 662240
			},
			"text": " And not, no, not everyone likes the magazine format."
		},
		{
			"timestamps": {
				"from": "00:11:02,380",
				"to": "00:11:04,760"
			},
			"offsets": {
				"from": 662380,
				"to": 664760
			},
			"text": " Not everyone wants to pay the money to access the material."
		},
		{
			"timestamps": {
				"from": "00:11:05,080",
				"to": "00:11:07,100"
			},
			"offsets": {
				"from": 665080,
				"to": 667100
			},
			"text": " Some people say the print version is too expensive."
		},
		{
			"timestamps": {
				"from": "00:11:07,240",
				"to": "00:11:10,100"
			},
			"offsets": {
				"from": 667240,
				"to": 670100
			},
			"text": " But, you know, they've put a lot of effort into this."
		},
		{
			"timestamps": {
				"from": "00:11:10,100",
				"to": "00:11:16,820"
			},
			"offsets": {
				"from": 670100,
				"to": 676820
			},
			"text": " If you want quality produced, you know, content like this, then, you know, it costs money."
		},
		{
			"timestamps": {
				"from": "00:11:16,980",
				"to": "00:11:18,380"
			},
			"offsets": {
				"from": 676980,
				"to": 678380
			},
			"text": " People have to eat and make a living."
		},
		{
			"timestamps": {
				"from": "00:11:18,520",
				"to": "00:11:22,180"
			},
			"offsets": {
				"from": 678520,
				"to": 682180
			},
			"text": " And I just love the fact that it's in dead tree format."
		},
		{
			"timestamps": {
				"from": "00:11:22,360",
				"to": "00:11:22,740"
			},
			"offsets": {
				"from": 682360,
				"to": 682740
			},
			"text": " You know, I love it."
		},
		{
			"timestamps": {
				"from": "00:11:22,780",
				"to": "00:11:26,660"
			},
			"offsets": {
				"from": 682780,
				"to": 686660
			},
			"text": " I love just being able to, you know, take this and just read it anywhere."
		},
		{
			"timestamps": {
				"from": "00:11:26,820",
				"to": "00:11:29,000"
			},
			"offsets": {
				"from": 686820,
				"to": 689000
			},
			"text": " It's not the same on your stupid iPad."
		},
		{
			"timestamps": {
				"from": "00:11:29,320",
				"to": "00:11:30,720"
			},
			"offsets": {
				"from": 689320,
				"to": 690720
			},
			"text": " It's just, it's not."
		},
		{
			"timestamps": {
				"from": "00:11:33,780",
				"to": "00:11:34,640"
			},
			"offsets": {
				"from": 693780,
				"to": 694640
			},
			"text": " Oh, yeah."
		},
		{
			"timestamps": {
				"from": "00:11:35,680",
				"to": "00:11:36,540"
			},
			"offsets": {
				"from": 695680,
				"to": 696540
			},
			"text": " Catch you next time."
		},
		{
			"timestamps": {
				"from": "00:11:52,740",
				"to": "00:12:22,720"
			},
			"offsets": {
				"from": 712740,
				"to": 742720
			},
			"text": " Thank you."
		}
	]
}
