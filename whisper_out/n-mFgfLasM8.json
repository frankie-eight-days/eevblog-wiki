				"to": "00:03:48,860"
			},
			"offsets": {
				"from": 227640,
				"to": 228860
			},
			"text": " And that's the interesting thing."
		},
		{
			"timestamps": {
				"from": "00:03:48,920",
				"to": "00:03:51,120"
			},
			"offsets": {
				"from": 228920,
				"to": 231120
			},
			"text": " So let's go back to the schematic over here."
