			},
			"text": " Hmm."
		},
		{
			"timestamps": {
				"from": "00:02:56,940",
				"to": "00:02:58,280"
			},
			"offsets": {
				"from": 176940,
				"to": 178280
			},
			"text": " And then it dawned on me."
		},
		{
			"timestamps": {
