		{
			"timestamps": {
				"from": "00:03:58,300",
				"to": "00:03:59,200"
			},
			"offsets": {
				"from": 238300,
				"to": 239200
			},
			"text": " Well, as you..."
		},
		{
			"timestamps": {
				"from": "00:03:59,380",
				"to": "00:04:05,640"
			},
			"offsets": {
				"from": 239380,
				"to": 245640
			},
			"text": " As you saw in that video, all the other traces on the board go back basically to that microcontroller or to the..."
