		{
			"timestamps": {
				"from": "00:02:49,920",
				"to": "00:02:55,460"
			},
			"offsets": {
				"from": 169920,
				"to": 175460
			},
			"text": " But then why is this one eaten away and this one is not or any of the other traces?"
		},
		{
			"timestamps": {
