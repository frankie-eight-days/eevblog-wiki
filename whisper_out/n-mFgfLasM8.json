				"to": "00:04:41,980"
			},
			"offsets": {
				"from": 279680,
				"to": 281980
			},
			"text": " So that's the soft button power switch."
		},
		{
			"timestamps": {
				"from": "00:04:42,140",
				"to": "00:04:48,180"
			},
			"offsets": {
				"from": 282140,
				"to": 288180
			},
			"text": " So this line is always powered up through either of the two mains or battery power sources through here."
		},
		{
			"timestamps": {
				"from": "00:04:48,340",
				"to": "00:04:51,540"
			},
			"offsets": {
				"from": 288340,
				"to": 291540
			},
			"text": " So there's actually a voltage on this line."
		},
		{
			"timestamps": {
				"from": "00:04:51,680",
				"to": "00:04:52,220"
			},
			"offsets": {
				"from": 291680,
				"to": 292220
			},
			"text": " What voltage?"
		},
		{
			"timestamps": {
				"from": "00:04:52,460",
				"to": "00:04:56,160"
			},
			"offsets": {
				"from": 292460,
				"to": 296160
			},
			"text": " Well, it's going to be like the 8.3-volt battery that we had here."
		},
		{
			"timestamps": {
				"from": "00:04:56,160",
				"to": "00:04:59,160"
			},
			"offsets": {
				"from": 296160,
				"to": 299160
			},
			"text": " Or it's going to be the 24-volt 1-amp adapter."
		},
		{
			"timestamps": {
				"from": "00:04:59,340",
				"to": "00:05:02,880"
			},
			"offsets": {
				"from": 299340,
				"to": 302880
			},
			"text": " So there's always voltage on that line."
		},
		{
			"timestamps": {
				"from": "00:05:03,260",
				"to": "00:05:12,980"
			},
			"offsets": {
				"from": 303260,
				"to": 312980
			},
			"text": " And, uh-huh, what happens when you've got a DC voltage on a line and any sort of chemical involved?"
		},
		{
			"timestamps": {
				"from": "00:05:14,000",
				"to": "00:05:14,640"
			},
			"offsets": {
				"from": 314000,
				"to": 314640
			},
			"text": " Electrolysis."
		},
		{
			"timestamps": {
				"from": "00:05:15,320",
				"to": "00:05:17,860"
			},
			"offsets": {
				"from": 315320,
				"to": 317860
			},
			"text": " So I reckon that's what's happened here."
		},
		{
			"timestamps": {
				"from": "00:05:18,320",
				"to": "00:05:25,520"
			},
			"offsets": {
				"from": 318320,
				"to": 325520
			},
			"text": " This trace here permanently has, unless the battery is flat, permanently has that, like, 8 volts on there."
		},
		{
			"timestamps": {
				"from": "00:05:25,760",
				"to": "00:05:27,780"
			},
			"offsets": {
				"from": 325760,
				"to": 327780
			},
			"text": " Permanently has a DC voltage on there."
		},
		{
			"timestamps": {
				"from": "00:05:27,780",
				"to": "00:05:29,160"
			},
			"offsets": {
				"from": 327780,
				"to": 329160
			},
			"text": " So any sort of contamination."
		},
		{
			"timestamps": {
				"from": "00:05:29,300",
				"to": "00:05:31,440"
			},
			"offsets": {
				"from": 329300,
				"to": 331440
			},
			"text": " Here, like I speculated, beer."
		},
		{
			"timestamps": {
				"from": "00:05:31,580",
				"to": "00:05:37,080"
			},
			"offsets": {
				"from": 331580,
				"to": 337080
			},
			"text": " Other people speculated that, oh, it could have been a factory wash chemical residue left over."
		},
		{
			"timestamps": {
				"from": "00:05:37,360",
				"to": "00:05:40,860"
			},
			"offsets": {
				"from": 337360,
				"to": 340860
			},
			"text": " Somebody said, oh, it could have been some vomit from a party or something like that."
		},
		{
			"timestamps": {
				"from": "00:05:40,900",
				"to": "00:05:43,140"
			},
			"offsets": {
				"from": 340900,
				"to": 343140
			},
			"text": " Somebody puked over the speaker."
		},
		{
			"timestamps": {
				"from": "00:05:43,440",
				"to": "00:05:44,780"
			},
			"offsets": {
				"from": 343440,
				"to": 344780
			},
			"text": " I'm sorry for the visual there."
		},
		{
			"timestamps": {
				"from": "00:05:45,040",
				"to": "00:05:46,400"
			},
			"offsets": {
				"from": 345040,
				"to": 346400
			},
			"text": " But, you know, it happens."
		},
		{
			"timestamps": {
				"from": "00:05:46,740",
				"to": "00:05:48,320"
			},
			"offsets": {
				"from": 346740,
				"to": 348320
			},
			"text": " Somebody could have peed on the speaker."
		},
		{
			"timestamps": {
				"from": "00:05:48,500",
				"to": "00:05:50,920"
			},
			"offsets": {
				"from": 348500,
				"to": 350920
			},
			"text": " You don't know what happens at these parties, okay?"
		},
		{
			"timestamps": {
				"from": "00:05:51,100",
				"to": "00:05:55,660"
			},
			"offsets": {
				"from": 351100,
				"to": 355660
			},
			"text": " So it doesn't really matter what sort of chemical, I guess, was on here, okay?"
		},
		{
			"timestamps": {
				"from": "00:05:55,660",
				"to": "00:05:59,260"
			},
			"offsets": {
				"from": 355660,
				"to": 359260
			},
			"text": " But, yeah, I reckon, because this has a permanent..."
		},
		{
			"timestamps": {
				"from": "00:05:59,420",
				"to": "00:06:05,600"
			},
			"offsets": {
				"from": 359420,
				"to": 365600
			},
			"text": " This is the only line that has a permanent, relatively, you know, 8-ish volts or thereabouts,"
		},
		{
			"timestamps": {
				"from": "00:06:05,700",
				"to": "00:06:09,340"
			},
			"offsets": {
				"from": 365700,
				"to": 369340
			},
			"text": " permanently on it, and these other lines wouldn't,"
		},
		{
			"timestamps": {
				"from": "00:06:09,700",
				"to": "00:06:18,440"
			},
			"offsets": {
				"from": 369700,
				"to": 378440
			},
			"text": " then that's why electrolysis has started and eaten away, like, really cleanly eaten away the copper there."
		},
		{
			"timestamps": {
				"from": "00:06:19,200",
				"to": "00:06:23,800"
			},
			"offsets": {
				"from": 379200,
				"to": 383800
			},
			"text": " So that is my best guess now as to what's actually happened here."
		},
		{
			"timestamps": {
				"from": "00:06:23,800",
				"to": "00:06:29,220"
			},
			"offsets": {
				"from": 383800,
				"to": 389220
			},
			"text": " So I don't think it was, like, the rubbing of the membrane button could have, you know, gotten through the solder."
		},
		{
			"timestamps": {
				"from": "00:06:29,380",
				"to": "00:06:34,080"
			},
			"offsets": {
				"from": 389380,
				"to": 394080
			},
			"text": " Because normally the solder mask, right, if the solder mask is intact,"
		},
		{
			"timestamps": {
				"from": "00:06:34,240",
				"to": "00:06:38,520"
			},
			"offsets": {
				"from": 394240,
				"to": 398520
			},
			"text": " then, you know, any sort of liquid shouldn't, in theory, get through the solder mask."
		},
		{
			"timestamps": {
				"from": "00:06:38,580",
				"to": "00:06:41,560"
			},
			"offsets": {
				"from": 398580,
				"to": 401560
			},
			"text": " But you only need a tiny pinprick in the solder mask."
		},
		{
			"timestamps": {
				"from": "00:06:41,660",
				"to": "00:06:44,060"
			},
			"offsets": {
				"from": 401660,
				"to": 404060
			},
			"text": " So you'll see, like, little marks like that one, right?"
		},
		{
			"timestamps": {
				"from": "00:06:44,100",
				"to": "00:06:49,620"
			},
			"offsets": {
				"from": 404100,
				"to": 409620
			},
			"text": " You'll see little, like, you know, you always get, like, little holes in your solder mask and stuff like that, right?"
		},
		{
			"timestamps": {
				"from": "00:06:49,740",
				"to": "00:06:50,660"
			},
			"offsets": {
				"from": 409740,
				"to": 410660
			},
			"text": " So it happens all the time."
		},
		{
			"timestamps": {
				"from": "00:06:50,720",
				"to": "00:06:51,600"
			},
			"offsets": {
				"from": 410720,
				"to": 411600
			},
			"text": " So all you need..."
		},
		{
			"timestamps": {
				"from": "00:06:51,600",
				"to": "00:06:53,680"
			},
			"offsets": {
				"from": 411600,
				"to": 413680
			},
			"text": " So it could have been a bit of the membrane rubbing."
		},
		{
			"timestamps": {
				"from": "00:06:53,960",
				"to": "00:06:57,220"
			},
			"offsets": {
				"from": 413960,
				"to": 417220
			},
			"text": " It's no coincidence that was in line with that membrane there."
		},
		{
			"timestamps": {
				"from": "00:06:57,540",
				"to": "00:06:59,180"
			},
			"offsets": {
				"from": 417540,
				"to": 419180
			},
			"text": " But then any sort of liquid..."
		},
		{
			"timestamps": {
				"from": "00:06:59,240",
				"to": "00:07:01,780"
			},
			"offsets": {
				"from": 419240,
				"to": 421780
			},
			"text": " It would have, you know, lined up along there or something like that."
		},
		{
			"timestamps": {
				"from": "00:07:01,800",
				"to": "00:07:05,680"
			},
			"offsets": {
				"from": 421800,
				"to": 425680
			},
			"text": " And all it takes is the tiniest little bit on there combined with some voltage on there."
		},
		{
			"timestamps": {
				"from": "00:07:06,200",
				"to": "00:07:07,200"
			},
			"offsets": {
				"from": 426200,
				"to": 427200
			},
			"text": " Give it enough time."
		},
		{
			"timestamps": {
				"from": "00:07:07,920",
				"to": "00:07:09,880"
			},
			"offsets": {
				"from": 427920,
				"to": 429880
			},
			"text": " And it's going to eat away your copper."
		},
		{
			"timestamps": {
				"from": "00:07:10,640",
				"to": "00:07:12,240"
			},
			"offsets": {
				"from": 430640,
				"to": 432240
			},
			"text": " Anyway, best guess."
		},
		{
			"timestamps": {
				"from": "00:07:12,340",
				"to": "00:07:12,660"
			},
			"offsets": {
				"from": 432340,
				"to": 432660
			},
			"text": " I don't know."
		},
		{
			"timestamps": {
				"from": "00:07:12,820",
				"to": "00:07:15,020"
			},
			"offsets": {
				"from": 432820,
				"to": 435020
			},
			"text": " Chemists, leave it in the comments down below."
		},
		{
			"timestamps": {
				"from": "00:07:15,240",
				"to": "00:07:16,460"
			},
			"offsets": {
				"from": 435240,
				"to": 436460
			},
			"text": " What do you think's happening here?"
		},
		{
			"timestamps": {
				"from": "00:07:16,520",
				"to": "00:07:24,520"
			},
			"offsets": {
				"from": 436520,
				"to": 444520
			},
			"text": " But that is my guess as to why just that trace and that trace alone was impacted like that and had the copper eaten away."
		},
		{
			"timestamps": {
				"from": "00:07:24,520",
				"to": "00:07:29,140"
			},
			"offsets": {
				"from": 444520,
				"to": 449140
			},
			"text": " And the other keys you can see here, right, these are just from ADC."
		},
		{
			"timestamps": {
				"from": "00:07:29,140",
				"to": "00:07:31,600"
			},
			"offsets": {
				"from": 449140,
				"to": 451600
			},
			"text": " That's why it says key ADC there."
		},
		{
			"timestamps": {
				"from": "00:07:31,700",
				"to": "00:07:33,440"
			},
			"offsets": {
				"from": 451700,
				"to": 453440
			},
			"text": " Once again, I've got the ferrite bead."
		},
		{
			"timestamps": {
				"from": "00:07:33,680",
				"to": "00:07:41,140"
			},
			"offsets": {
				"from": 453680,
				"to": 461140
			},
			"text": " And then basically it's just an ADC in the main processor just measuring, you know, like a voltage window threshold."
		},
		{
			"timestamps": {
				"from": "00:07:41,960",
				"to": "00:07:43,920"
			},
			"offsets": {
				"from": 461960,
				"to": 463920
			},
			"text": " It's basically a window detector with an ADC."
		},
		{
			"timestamps": {
				"from": "00:07:44,040",
				"to": "00:07:51,600"
			},
			"offsets": {
				"from": 464040,
				"to": 471600
			},
			"text": " So they've got different value resistors in here to give you and then going down to ground so it knows which button is pressed."
		},
		{
			"timestamps": {
				"from": "00:07:51,660",
				"to": "00:07:53,860"
			},
			"offsets": {
				"from": 471660,
				"to": 473860
			},
			"text": " So it's not your traditional key matrix."
		},
		{
			"timestamps": {
				"from": "00:07:54,020",
				"to": "00:07:56,140"
			},
			"offsets": {
				"from": 474020,
				"to": 476140
			},
			"text": " But, yeah, these are going off to inputs."
		},
		{
			"timestamps": {
				"from": "00:07:56,700",
				"to": "00:07:59,120"
			},
			"offsets": {
				"from": 476700,
				"to": 479120
			},
			"text": " And you can see that key ADC1 there."
		},
		{
			"timestamps": {
				"from": "00:07:59,260",
				"to": "00:08:05,140"
			},
			"offsets": {
				"from": 479260,
				"to": 485140
			},
			"text": " Basically just goes straight into this microcontroller here, MLC3740."
		},
		{
			"timestamps": {
				"from": "00:08:05,240",
				"to": "00:08:06,040"
			},
			"offsets": {
				"from": 485240,
				"to": 486040
			},
			"text": " Don't know what that is."
		},
		{
			"timestamps": {
				"from": "00:08:06,660",
				"to": "00:08:09,200"
			},
			"offsets": {
				"from": 486660,
				"to": 489200
			},
			"text": " But, yeah, it basically just goes straight into there."
		},
		{
			"timestamps": {
				"from": "00:08:09,400",
				"to": "00:08:17,220"
			},
			"offsets": {
				"from": 489400,
				"to": 497220
			},
			"text": " So essentially, like, depending on the architecture of the ADC inside the chip and stuff, like, there's not really much happening there."
		},
		{
			"timestamps": {
				"from": "00:08:17,320",
				"to": "00:08:23,780"
			},
			"offsets": {
				"from": 497320,
				"to": 503780
			},
			"text": " It's not like it's got that permanent 8 volts from the battery or 24 volts from the DC to DC converter."
		},
		{
			"timestamps": {
				"from": "00:08:24,740",
				"to": "00:08:27,880"
			},
			"offsets": {
				"from": 504740,
				"to": 507880
			},
			"text": " Directly, always on that line 24-7."
		},
		{
			"timestamps": {
				"from": "00:08:27,880",
				"to": "00:08:29,000"
			},
			"offsets": {
				"from": 507880,
				"to": 509000
			},
			"text": " So, yeah, this."
		},
		{
			"timestamps": {
				"from": "00:08:29,100",
				"to": "00:08:37,400"
			},
			"offsets": {
				"from": 509100,
				"to": 517400
			},
			"text": " This line is electrically very different to, like, all the other surrounding lines that you see on here that go to the switches."
		},
		{
			"timestamps": {
				"from": "00:08:37,880",
				"to": "00:08:40,400"
			},
			"offsets": {
				"from": 517880,
				"to": 520400
			},
			"text": " And somebody else mentioned, oh, it was the hard plastic."
		},
		{
			"timestamps": {
				"from": "00:08:40,620",
				"to": "00:08:42,980"
			},
			"offsets": {
				"from": 520620,
				"to": 522980
			},
			"text": " And somebody was, like, sitting on the hard plastic."
		},
		{
			"timestamps": {
				"from": "00:08:43,340",
				"to": "00:08:45,960"
			},
			"offsets": {
				"from": 523340,
				"to": 525960
			},
			"text": " You know, it sat on top of the speaker and that just rubbed on the board."
		},
		{
			"timestamps": {
				"from": "00:08:46,040",
				"to": "00:08:51,420"
			},
			"offsets": {
				"from": 526040,
				"to": 531420
			},
			"text": " But it doesn't explain why there's no damage to any of the other traces and there's almost nothing there."
		},
		{
			"timestamps": {
				"from": "00:08:51,480",
				"to": "00:08:53,760"
			},
			"offsets": {
				"from": 531480,
				"to": 533760
			},
			"text": " You know, there's maybe a little smidge there."
		},
		{
			"timestamps": {
				"from": "00:08:54,040",
				"to": "00:08:57,120"
			},
			"offsets": {
				"from": 534040,
				"to": 537120
			},
			"text": " That is my best theory as to what has happened there."
		},
		{
			"timestamps": {
				"from": "00:08:57,120",
				"to": "00:08:59,080"
			},
			"offsets": {
				"from": 537120,
				"to": 539080
			},
			"text": " But if you've got something else, leave it."
		},
		{
			"timestamps": {
				"from": "00:08:59,080",
				"to": "00:09:00,040"
			},
			"offsets": {
				"from": 539080,
				"to": 540040
			},
			"text": " Leave it in the comments down below."
		},
		{
			"timestamps": {
				"from": "00:09:00,700",
				"to": "00:09:02,160"
			},
			"offsets": {
				"from": 540700,
				"to": 542160
			},
			"text": " This is very interesting stuff."
		},
		{
			"timestamps": {
				"from": "00:09:02,660",
