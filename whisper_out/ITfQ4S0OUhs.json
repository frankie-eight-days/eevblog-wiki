			"offsets": {
				"from": 259000,
				"to": 263000
			},
			"text": " So, that plastic has just totally deteriorated."
		},
		{
			"timestamps": {
				"from": "00:04:23,000",
				"to": "00:04:24,000"
			},
			"offsets": {
				"from": 263000,
				"to": 264000
			},
			"text": " Look at that."
		},
		{
			"timestamps": {
				"from": "00:04:24,000",
				"to": "00:04:28,000"
			},
			"offsets": {
				"from": 264000,
				"to": 268000
			},
			"text": " And the seal couldn't keep the water out."
		},
		{
			"timestamps": {
				"from": "00:04:28,000",
				"to": "00:04:30,000"
			},
			"offsets": {
				"from": 268000,
				"to": 270000
			},
			"text": " So, yep."
		},
		{
			"timestamps": {
				"from": "00:04:30,000",
				"to": "00:04:36,000"
			},
			"offsets": {
				"from": 270000,
				"to": 276000
			},
			"text": " Well, I guess, you know, six years, all the plastic's going to degrade with the UV and stuff like that."
		},
		{
			"timestamps": {
				"from": "00:04:36,000",
				"to": "00:04:39,000"
			},
			"offsets": {
				"from": 276000,
				"to": 279000
			},
			"text": " So, yeah, have to get that replaced."
		},
		{
			"timestamps": {
				"from": "00:04:39,000",
				"to": "00:04:46,000"
			},
			"offsets": {
				"from": 279000,
				"to": 286000
			},
			"text": " But, yep, really, I don't think there's a problem with my panels, though."
		},
		{
			"timestamps": {
				"from": "00:04:46,000",
				"to": "00:04:48,000"
			},
			"offsets": {
				"from": 286000,
				"to": 288000
			},
			"text": " Panels are still looking good."
		},
		{
			"timestamps": {
				"from": "00:04:48,000",
				"to": "00:04:52,000"
			},
			"offsets": {
				"from": 288000,
				"to": 292000
			},
			"text": " Great condition after six years, apart from that."
		},
		{
			"timestamps": {
				"from": "00:04:52,000",
				"to": "00:04:54,000"
			},
			"offsets": {
				"from": 292000,
				"to": 294000
			},
			"text": " Wow."
		},
		{
			"timestamps": {
				"from": "00:04:54,000",
				"to": "00:04:56,000"
			},
			"offsets": {
				"from": 294000,
				"to": 296000
			},
			"text": " That's terrible, Muriel."
		},
		{
			"timestamps": {
				"from": "00:04:56,000",
				"to": "00:04:58,000"
			},
			"offsets": {
				"from": 296000,
				"to": 298000
			},
			"text": " I'm in some kind of a chamber."
		},
		{
			"timestamps": {
				"from": "00:04:58,000",
				"to": "00:05:00,000"
			},
			"offsets": {
				"from": 298000,
				"to": 300000
			},
			"text": " Is the tile working?"
		},
		{
			"timestamps": {
				"from": "00:05:00,000",
				"to": "00:05:01,000"
			},
			"offsets": {
				"from": 300000,
				"to": 301000
			},
			"text": " Slide!"
		},
		{
			"timestamps": {
				"from": "00:05:01,000",
				"to": "00:05:02,000"
			},
			"offsets": {
				"from": 301000,
				"to": 302000
			},
			"text": " What?"
		},
		{
			"timestamps": {
				"from": "00:05:02,000",
				"to": "00:05:04,000"
			},
			"offsets": {
				"from": 302000,
				"to": 304000
			},
			"text": " It's a river of slime!"
		},
		{
			"timestamps": {
				"from": "00:05:06,000",
				"to": "00:05:08,000"
			},
			"offsets": {
				"from": 306000,
				"to": 308000
			},
			"text": " Okay, let's probe this."
		},
		{
			"timestamps": {
				"from": "00:05:08,000",
				"to": "00:05:12,000"
			},
			"offsets": {
				"from": 308000,
				"to": 312000
			},
			"text": " My third hand holding this up is the strap."
		},
		{
			"timestamps": {
				"from": "00:05:12,000",
				"to": "00:05:14,000"
			},
			"offsets": {
				"from": 312000,
				"to": 314000
			},
			"text": " So, let's get in there."
		},
		{
			"timestamps": {
				"from": "00:05:14,000",
				"to": "00:05:15,000"
			},
			"offsets": {
				"from": 314000,
				"to": 315000
			},
			"text": " Bingo."
		},
		{
			"timestamps": {
				"from": "00:05:15,000",
				"to": "00:05:16,000"
			},
			"offsets": {
				"from": 315000,
				"to": 316000
			},
			"text": " That's fine."
		},
		{
			"timestamps": {
				"from": "00:05:16,000",
				"to": "00:05:17,000"
			},
			"offsets": {
				"from": 316000,
				"to": 317000
			},
			"text": " So, there you have it."
		},
		{
			"timestamps": {
				"from": "00:05:17,000",
				"to": "00:05:19,000"
			},
			"offsets": {
				"from": 317000,
				"to": 319000
			},
			"text": " Nothing wrong with my string."
		},
		{
			"timestamps": {
				"from": "00:05:19,000",
				"to": "00:05:22,000"
			},
			"offsets": {
				"from": 319000,
				"to": 322000
			},
			"text": " It's just, yeah, a dodgy switch."
		},
		{
			"timestamps": {
				"from": "00:05:22,000",
				"to": "00:05:24,000"
			},
			"offsets": {
				"from": 322000,
				"to": 324000
			},
			"text": " Check out the sludge on my tip."
		},
		{
			"timestamps": {
				"from": "00:05:24,000",
				"to": "00:05:26,000"
			},
			"offsets": {
				"from": 324000,
				"to": 326000
			},
			"text": " Unbelievable."
		},
		{
			"timestamps": {
				"from": "00:05:26,000",
				"to": "00:05:27,000"
			},
			"offsets": {
				"from": 326000,
				"to": 327000
			},
			"text": " So, there you have it."
		},
		{
			"timestamps": {
				"from": "00:05:27,000",
				"to": "00:05:38,000"
			},
			"offsets": {
				"from": 327000,
				"to": 338000
			},
			"text": " After six years, the thing that failed is probably the thing you expected to fail, which is the seal in, like, a box, just like a weather seal up on top."
		},
		{
			"timestamps": {
				"from": "00:05:38,000",
				"to": "00:05:42,000"
			},
			"offsets": {
				"from": 338000,
				"to": 342000
			},
			"text": " Of course, it's going to degrade and eventually wear out."
		},
		{
			"timestamps": {
				"from": "00:05:42,000",
				"to": "00:05:43,000"
			},
			"offsets": {
				"from": 342000,
				"to": 343000
			},
			"text": " It's just a given."
		},
		{
			"timestamps": {
				"from": "00:05:43,000",
				"to": "00:05:46,000"
			},
			"offsets": {
				"from": 343000,
				"to": 346000
			},
			"text": " I don't even know why they have those isolator switches up on the roof."
		},
		{
			"timestamps": {
				"from": "00:05:46,000",
				"to": "00:05:48,000"
			},
			"offsets": {
				"from": 346000,
				"to": 348000
			},
			"text": " I've already got an isolator switch down here."
		},
		{
			"timestamps": {
				"from": "00:05:48,000",
				"to": "00:05:56,000"
			},
			"offsets": {
				"from": 348000,
				"to": 356000
			},
			"text": " I don't see the purpose of that, but it just goes to show how having another thing in the chain can fail."
		},
		{
			"timestamps": {
				"from": "00:05:56,000",
				"to": "00:06:02,000"
			},
			"offsets": {
				"from": 356000,
				"to": 362000
			},
			"text": " So, yeah, let us know if you've had a DC isolator fail and if you've got one installed up in your roof."
		},
		{
			"timestamps": {
				"from": "00:06:02,000",
				"to": "00:06:03,000"
			},
			"offsets": {
				"from": 362000,
				"to": 363000
			},
			"text": " I don't know."
		},
		{
			"timestamps": {
				"from": "00:06:03,000",
				"to": "00:06:05,000"
			},
			"offsets": {
				"from": 363000,
				"to": 365000
			},
			"text": " Maybe it's requirement law here in Australia to have it."
		},
		{
			"timestamps": {
				"from": "00:06:05,000",
				"to": "00:06:06,000"
			},
			"offsets": {
				"from": 365000,
				"to": 366000
			},
			"text": " I'm not really sure."
		},
		{
			"timestamps": {
				"from": "00:06:06,000",
				"to": "00:06:08,000"
			},
			"offsets": {
				"from": 366000,
				"to": 368000
			},
			"text": " But, anyway, yep, it failed."
		},
		{
			"timestamps": {
				"from": "00:06:08,000",
				"to": "00:06:10,000"
			},
			"offsets": {
				"from": 368000,
				"to": 370000
			},
			"text": " Panels are still good."
		},
		{
			"timestamps": {
				"from": "00:06:10,000",
				"to": "00:06:13,000"
			},
			"offsets": {
				"from": 370000,
				"to": 373000
			},
			"text": " And my Sunny Boy inverter is still fantastic."
		},
		{
			"timestamps": {
				"from": "00:06:13,000",
				"to": "00:06:15,000"
			},
			"offsets": {
				"from": 373000,
				"to": 375000
			},
			"text": " The wind's picking up again."
		},
		{
			"timestamps": {
				"from": "00:06:15,000",
				"to": "00:06:22,000"
			},
			"offsets": {
				"from": 375000,
				"to": 382000
			},
			"text": " And I think once we get that isolator switch up there replaced or maybe even bypassed if we don't need it, then it's fine."
		},
		{
			"timestamps": {
				"from": "00:06:22,000",
				"to": "00:06:28,000"
			},
			"offsets": {
				"from": 382000,
				"to": 388000
			},
			"text": " And this thing wouldn't have failed if we didn't have that weatherproof box up there with the isolator switch."
		},
		{
			"timestamps": {
				"from": "00:06:28,000",
				"to": "00:06:36,000"
			},
			"offsets": {
				"from": 388000,
				"to": 396000
			},
			"text": " So the conduit was bound to last a lot longer than that switch and case and rubber seal in there and just another water ingress path."
		},
		{
			"timestamps": {
				"from": "00:06:36,000",
				"to": "00:06:39,000"
			},
			"offsets": {
				"from": 396000,
				"to": 399000
			},
			"text": " And it just corroded everything and it's just buggered it up."
		},
		{
			"timestamps": {
				"from": "00:06:39,000",
				"to": "00:06:41,000"
			},
			"offsets": {
				"from": 399000,
				"to": 401000
			},
			"text": " So, anyway, yeah."
		},
		{
			"timestamps": {
				"from": "00:06:41,000",
				"to": "00:06:43,000"
			},
			"offsets": {
				"from": 401000,
				"to": 403000
			},
			"text": " So it's simple stuff like that that's failed."
		},
		{
			"timestamps": {
				"from": "00:06:43,000",
				"to": "00:06:44,000"
			},
			"offsets": {
				"from": 403000,
				"to": 404000
			},
			"text": " Not the electronics."
		},
		{
			"timestamps": {
				"from": "00:06:44,000",
				"to": "00:06:48,000"
			},
			"offsets": {
				"from": 404000,
				"to": 408000
			},
			"text": " Not the panels because I've got top quality LG panels up there."
		},
		{
			"timestamps": {
				"from": "00:06:48,000",
				"to": "00:06:54,000"
			},
			"offsets": {
				"from": 408000,
				"to": 414000
			},
			"text": " And because I paid a lot more for those panels and they've lasted, you know, the six plus years already."
		},
		{
			"timestamps": {
				"from": "00:06:54,000",
				"to": "00:06:58,000"
			},
			"offsets": {
				"from": 414000,
				"to": 418000
			},
			"text": " Hopefully, I'll get more than a decade out of this system."
		},
		{
			"timestamps": {
				"from": "00:06:58,000",
				"to": "00:07:00,000"
			},
			"offsets": {
				"from": 418000,
				"to": 420000
			},
			"text": " Anyway, I hope you liked it."
		},
		{
			"timestamps": {
				"from": "00:07:00,000",
				"to": "00:07:01,000"
			},
			"offsets": {
				"from": 420000,
				"to": 421000
			},
			"text": " Catch you next time."
		},
		{
			"timestamps": {
				"from": "00:07:14,000",
				"to": "00:07:15,000"
			},
			"offsets": {
				"from": 434000,
				"to": 435000
			},
			"text": " Bye."
		},
		{
			"timestamps": {
				"from": "00:07:15,000",
				"to": "00:07:16,000"
			},
			"offsets": {
				"from": 435000,
				"to": 436000
			},
			"text": " Bye."
		},
		{
			"timestamps": {
				"from": "00:07:16,000",
				"to": "00:07:17,000"
			},
			"offsets": {
				"from": 436000,
				"to": 437000
			},
			"text": " Bye."
		},
		{
			"timestamps": {
				"from": "00:07:17,000",
				"to": "00:07:18,000"
			},
			"offsets": {
				"from": 437000,
				"to": 438000
			},
			"text": " Bye."
		},
		{
			"timestamps": {
				"from": "00:07:18,000",
				"to": "00:07:18,000"
			},
			"offsets": {
				"from": 438000,
				"to": 438000
			},
			"text": " Bye."
		}
	]
}
