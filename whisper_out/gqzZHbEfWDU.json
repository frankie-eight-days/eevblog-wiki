		{
			"timestamps": {
				"from": "00:01:04,000",
				"to": "00:01:07,000"
			},
			"offsets": {
				"from": 64000,
				"to": 67000
			},
			"text": " So let's turn it on and see what happens."
		},
		{
			"timestamps": {
				"from": "00:01:11,000",
				"to": "00:01:13,000"
			},
			"offsets": {
