			"timestamps": {
				"from": "00:05:08,000",
				"to": "00:05:10,000"
			},
			"offsets": {
				"from": 308000,
				"to": 310000
			},
			"text": " So there's 115 watts there."
		},
		{
			"timestamps": {
				"from": "00:05:10,000",
				"to": "00:05:15,000"
			},
			"offsets": {
				"from": 310000,
				"to": 315000
			},
			"text": " And that'll give us the ability to draw a bit of current out of the power supply."
		},
		{
			"timestamps": {
				"from": "00:05:15,000",
				"to": "00:05:20,000"
			},
			"offsets": {
				"from": 315000,
				"to": 320000
			},
			"text": " Now the way these bulbs are wired is that there's a common there,"
		},
		{
			"timestamps": {
				"from": "00:05:20,000",
				"to": "00:05:24,000"
			},
			"offsets": {
				"from": 320000,
				"to": 324000
			},
			"text": " and then one terminal for each of the filaments."
		},
		{
			"timestamps": {
				"from": "00:05:24,000",
				"to": "00:05:28,000"
			},
			"offsets": {
				"from": 324000,
				"to": 328000
			},
			"text": " But if you go across the two terminals that I showed you earlier,"
		},
		{
			"timestamps": {
				"from": "00:05:28,000",
				"to": "00:05:31,000"
			},
			"offsets": {
				"from": 328000,
				"to": 331000
			},
			"text": " across the two terminals that I'm not holding,"
		},
		{
			"timestamps": {
				"from": "00:05:31,000",
				"to": "00:05:34,000"
			},
			"offsets": {
				"from": 331000,
				"to": 334000
			},
			"text": " that actually puts the two filaments in series."
		},
		{
			"timestamps": {
				"from": "00:05:34,000",
				"to": "00:05:36,000"
			},
			"offsets": {
				"from": 334000,
				"to": 336000
			},
			"text": " So that's what we're going to do."
		},
		{
			"timestamps": {
				"from": "00:05:36,000",
				"to": "00:05:39,000"
			},
			"offsets": {
				"from": 336000,
				"to": 339000
			},
			"text": " So we'll be applying 24 volts to this,"
		},
		{
			"timestamps": {
				"from": "00:05:39,000",
				"to": "00:05:44,000"
			},
			"offsets": {
				"from": 339000,
				"to": 344000
			},
			"text": " and hoping to draw somewhere around four and a half, five amps out of it."
		},
		{
			"timestamps": {
				"from": "00:05:44,000",
				"to": "00:05:46,000"
			},
			"offsets": {
				"from": 344000,
				"to": 346000
			},
			"text": " So that's what we'll do."
		},
		{
			"timestamps": {
				"from": "00:05:46,000",
				"to": "00:05:48,000"
			},
			"offsets": {
				"from": 346000,
				"to": 348000
			},
			"text": " So let's give it a go and see what happens."
		},
		{
			"timestamps": {
				"from": "00:05:51,000",
				"to": "00:05:54,000"
			},
			"offsets": {
				"from": 351000,
				"to": 354000
			},
			"text": " Well we've wired the filaments and the bulb in series now."
		},
		{
			"timestamps": {
				"from": "00:05:56,000",
				"to": "00:05:57,000"
			},
			"offsets": {
				"from": 356000,
				"to": 357000
			},
			"text": " As you can see."
		},
		{
			"timestamps": {
				"from": "00:05:58,000",
				"to": "00:06:03,000"
			},
			"offsets": {
				"from": 358000,
				"to": 363000
			},
			"text": " And we've taken the multimeter and we've connected it"
		},
		{
			"timestamps": {
				"from": "00:06:03,000",
				"to": "00:06:07,000"
			},
			"offsets": {
				"from": 363000,
				"to": 367000
			},
			"text": " so that it's actually measuring the output voltage as opposed to the current."
		},
		{
			"timestamps": {
				"from": "00:06:07,000",
				"to": "00:06:11,000"
			},
			"offsets": {
				"from": 367000,
				"to": 371000
			},
			"text": " Now we know that the current metering on the power supply"
		},
		{
			"timestamps": {
				"from": "00:06:11,000",
				"to": "00:06:14,000"
			},
			"offsets": {
				"from": 371000,
				"to": 374000
			},
			"text": " is pretty accurate from what we've seen already."
		},
		{
			"timestamps": {
				"from": "00:06:14,000",
				"to": "00:06:19,000"
			},
			"offsets": {
				"from": 374000,
				"to": 379000
			},
			"text": " So I don't want the shunt resistance of the multimeter actually in circuit."
		},
		{
			"timestamps": {
				"from": "00:06:19,000",
				"to": "00:06:22,000"
			},
			"offsets": {
				"from": 379000,
				"to": 382000
			},
			"text": " So we've taken that out and we'll measure that voltage."
		},
		{
			"timestamps": {
				"from": "00:06:22,000",
				"to": "00:06:27,000"
			},
			"offsets": {
				"from": 382000,
				"to": 387000
			},
			"text": " The other reason is I just wanted to show you the effect of the lead resistance"
		},
		{
			"timestamps": {
				"from": "00:06:27,000",
				"to": "00:06:31,000"
			},
			"offsets": {
				"from": 387000,
				"to": 391000
			},
			"text": " when you're delivering a higher current to a load."
		},
		{
			"timestamps": {
				"from": "00:06:31,000",
				"to": "00:06:35,000"
			},
			"offsets": {
				"from": 391000,
				"to": 395000
			},
			"text": " What we'll be getting on the power supply"
		},
		{
			"timestamps": {
				"from": "00:06:35,000",
				"to": "00:06:38,000"
			},
			"offsets": {
				"from": 395000,
				"to": 398000
			},
			"text": " versus what we'll be seeing at the bulb will be different"
		},
		{
			"timestamps": {
				"from": "00:06:38,000",
				"to": "00:06:41,000"
			},
			"offsets": {
				"from": 398000,
				"to": 401000
			},
			"text": " due to the voltage drop actually in the leads."
		},
		{
			"timestamps": {
				"from": "00:06:42,000",
				"to": "00:06:45,000"
			},
			"offsets": {
				"from": 402000,
				"to": 405000
			},
			"text": " So let's turn it on and see what happens now."
		},
		{
			"timestamps": {
				"from": "00:06:45,000",
				"to": "00:06:46,000"
			},
			"offsets": {
				"from": 405000,
				"to": 406000
			},
			"text": " This is going to..."
		},
		{
			"timestamps": {
				"from": "00:06:46,000",
				"to": "00:06:48,000"
			},
			"offsets": {
				"from": 406000,
				"to": 408000
			},
			"text": " All right, there we go."
		},
		{
			"timestamps": {
				"from": "00:06:49,000",
				"to": "00:06:52,000"
			},
			"offsets": {
				"from": 409000,
				"to": 412000
			},
			"text": " So you can see we've got our 24 volts."
		},
		{
			"timestamps": {
				"from": "00:06:52,000",
				"to": "00:06:55,000"
			},
			"offsets": {
				"from": 412000,
				"to": 415000
			},
			"text": " We've got 4.6 amps."
		},
		{
			"timestamps": {
				"from": "00:06:55,000",
				"to": "00:06:56,000"
			},
			"offsets": {
				"from": 415000,
				"to": 416000
			},
			"text": " And if we can see it,"
		},
		{
			"timestamps": {
				"from": "00:06:56,000",
				"to": "00:06:59,000"
			},
			"offsets": {
				"from": 416000,
				"to": 419000
			},
			"text": " we're in constant voltage mode."
		},
		{
			"timestamps": {
				"from": "00:06:59,000",
				"to": "00:07:01,000"
			},
			"offsets": {
				"from": 419000,
				"to": 421000
			},
			"text": " That's OK."
		},
		{
			"timestamps": {
				"from": "00:07:01,000",
				"to": "00:07:07,000"
			},
			"offsets": {
				"from": 421000,
				"to": 427000
			},
			"text": " We're showing 23.95 at the output terminals."
		},
		{
			"timestamps": {
				"from": "00:07:07,000",
				"to": "00:07:10,000"
			},
			"offsets": {
				"from": 427000,
				"to": 430000
			},
			"text": " That's about a 50 millivolt difference there"
		},
		{
			"timestamps": {
				"from": "00:07:10,000",
				"to": "00:07:13,000"
			},
			"offsets": {
				"from": 430000,
				"to": 433000
			},
			"text": " from the 24 volts that we've asked for."
		},
		{
			"timestamps": {
				"from": "00:07:15,000",
				"to": "00:07:18,000"
			},
			"offsets": {
				"from": 435000,
				"to": 438000
			},
			"text": " If we just disconnect the bulb for a second..."
		},
		{
			"timestamps": {
				"from": "00:07:23,000",
				"to": "00:07:25,000"
			},
			"offsets": {
				"from": 443000,
				"to": 445000
			},
			"text": " OK, you can see that it's..."
		},
		{
			"timestamps": {
				"from": "00:07:25,000",
				"to": "00:07:33,000"
			},
			"offsets": {
				"from": 445000,
				"to": 453000
			},
			"text": " We're out by about 20 millivolts, 21 millivolts at 24 volts."
		},
		{
			"timestamps": {
				"from": "00:07:33,000",
				"to": "00:07:36,000"
			},
			"offsets": {
				"from": 453000,
				"to": 456000
			},
			"text": " So you're looking at about 0.1% accuracy there."
		},
		{
			"timestamps": {
				"from": "00:07:36,000",
				"to": "00:07:37,000"
			},
			"offsets": {
				"from": 456000,
				"to": 457000
			},
			"text": " So that's not bad."
		},
		{
			"timestamps": {
				"from": "00:07:37,000",
				"to": "00:07:39,000"
			},
			"offsets": {
				"from": 457000,
				"to": 459000
			},
			"text": " I'll connect this bulb up again."
		},
		{
			"timestamps": {
				"from": "00:07:45,000",
				"to": "00:07:49,000"
			},
			"offsets": {
				"from": 465000,
				"to": 469000
			},
			"text": " You can see a slight voltage drop from when it was open circuit."
		},
		{
			"timestamps": {
				"from": "00:07:49,000",
				"to": "00:07:54,000"
			},
			"offsets": {
				"from": 469000,
				"to": 474000
			},
			"text": " And what I'll do now is I'm just going to take this lead from here."
		},
		{
			"timestamps": {
				"from": "00:07:54,000",
				"to": "00:08:00,000"
			},
			"offsets": {
				"from": 474000,
				"to": 480000
			},
			"text": " And I'm going to connect it onto the headlamp bulb."
		},
		{
			"timestamps": {
				"from": "00:08:00,000",
				"to": "00:08:05,000"
			},
			"offsets": {
				"from": 480000,
				"to": 485000
			},
			"text": " I'll try and do this without destroying the camera on my phone."
		},
		{
			"timestamps": {
				"from": "00:08:14,000",
				"to": "00:08:16,000"
			},
			"offsets": {
				"from": 494000,
				"to": 496000
			},
			"text": " It's connected on there now."
		},
		{
			"timestamps": {
				"from": "00:08:16,000",
				"to": "00:08:19,000"
			},
			"offsets": {
				"from": 496000,
				"to": 499000
			},
			"text": " If we go back and have a look on the multimeter..."
		},
		{
			"timestamps": {
				"from": "00:08:21,000",
				"to": "00:08:25,000"
			},
			"offsets": {
				"from": 501000,
				"to": 505000
			},
			"text": " See, it's now got 23.87."
		},
		{
			"timestamps": {
				"from": "00:08:26,000",
				"to": "00:08:33,000"
			},
			"offsets": {
				"from": 506000,
				"to": 513000
			},
			"text": " So you can see there's been a drop of about 0.12 of a volt or so."
		},
		{
			"timestamps": {
				"from": "00:08:33,000",
				"to": "00:08:35,000"
			},
			"offsets": {
				"from": 513000,
				"to": 515000
			},
			"text": " And that voltage drop's in the lead."
		},
		{
			"timestamps": {
				"from": "00:08:35,000",
				"to": "00:08:40,000"
			},
			"offsets": {
				"from": 515000,
				"to": 520000
			},
			"text": " And that's why if you are using power supplies and delivering higher currents to a load,"
		},
		{
			"timestamps": {
				"from": "00:08:40,000",
				"to": "00:08:43,000"
			},
			"offsets": {
				"from": 520000,
				"to": 523000
			},
			"text": " and you want to be sure that you're getting the right voltage at your load,"
		},
		{
			"timestamps": {
				"from": "00:08:43,000",
				"to": "00:08:47,000"
			},
			"offsets": {
				"from": 523000,
				"to": 527000
			},
			"text": " then measure the voltage separately at the load"
		},
		{
			"timestamps": {
				"from": "00:08:47,000",
				"to": "00:08:50,000"
			},
			"offsets": {
				"from": 527000,
				"to": 530000
			},
			"text": " as opposed to relying on what you're seeing on your power supply."
		},
		{
			"timestamps": {
				"from": "00:08:50,000",
				"to": "00:08:54,000"
			},
			"offsets": {
				"from": 530000,
				"to": 534000
			},
			"text": " There's other ways of doing this called four-wire techniques,"
		},
		{
			"timestamps": {
				"from": "00:08:54,000",
				"to": "00:08:57,000"
			},
			"offsets": {
				"from": 534000,
				"to": 537000
			},
			"text": " which those of you who are into measurement will know all about it."
		},
		{
			"timestamps": {
				"from": "00:08:57,000",
				"to": "00:09:01,000"
			},
			"offsets": {
				"from": 537000,
				"to": 541000
			},
			"text": " Those of you who aren't, interesting topic."
		},
		{
			"timestamps": {
				"from": "00:09:01,000",
				"to": "00:09:04,000"
			},
			"offsets": {
				"from": 541000,
				"to": 544000
			},
			"text": " OK, we're going to move this back again."
		},
		{
			"timestamps": {
				"from": "00:09:13,000",
				"to": "00:09:16,000"
			},
			"offsets": {
				"from": 553000,
				"to": 556000
			},
			"text": " In the meantime, the power supply's obviously been behaving itself"
		},
		{
			"timestamps": {
				"from": "00:09:16,000",
				"to": "00:09:19,000"
			},
			"offsets": {
				"from": 556000,
				"to": 559000
			},
			"text": " because the bulb's stayed on and we haven't blown it up in voltages."
		},
		{
			"timestamps": {
				"from": "00:09:19,000",
				"to": "00:09:21,000"
			},
			"offsets": {
				"from": 559000,
				"to": 561000
			},
			"text": " It's stayed stable."
		},
		{
			"timestamps": {
				"from": "00:09:21,000",
				"to": "00:09:24,000"
			},
			"offsets": {
				"from": 561000,
				"to": 564000
			},
			"text": " So let's just flick it on and off a few times now."
		},
		{
			"timestamps": {
				"from": "00:09:35,000",
				"to": "00:09:37,000"
			},
			"offsets": {
				"from": 575000,
				"to": 577000
			},
			"text": " You can also see briefly there,"
		},
		{
			"timestamps": {
				"from": "00:09:37,000",
				"to": "00:09:40,000"
			},
			"offsets": {
				"from": 577000,
				"to": 580000
			},
			"text": " when the power supply is first connected, turned on,"
		},
		{
			"timestamps": {
				"from": "00:09:40,000",
				"to": "00:09:44,000"
			},
			"offsets": {
				"from": 580000,
				"to": 584000
			},
			"text": " we go to constant current mode, then we go to constant voltage mode."
		},
		{
			"timestamps": {
				"from": "00:09:44,000",
				"to": "00:09:48,000"
			},
			"offsets": {
				"from": 584000,
				"to": 588000
			},
			"text": " And that'll be when the bulb is actually pulling maximum current"
		},
		{
			"timestamps": {
				"from": "00:09:48,000",
				"to": "00:09:51,000"
			},
			"offsets": {
				"from": 588000,
				"to": 591000
			},
			"text": " out of the supply, so it just says, \"I've had enough.\""
		},
		{
			"timestamps": {
				"from": "00:09:51,000",
				"to": "00:09:53,000"
			},
			"offsets": {
				"from": 591000,
				"to": 593000
			},
			"text": " I'm going to constant current,"
		},
		{
			"timestamps": {
				"from": "00:09:53,000",
				"to": "00:09:56,000"
			},
			"offsets": {
				"from": 593000,
				"to": 596000
			},
			"text": " and then it drops back to constant voltage,"
		},
		{
			"timestamps": {
				"from": "00:09:56,000",
				"to": "00:09:59,000"
			},
			"offsets": {
				"from": 596000,
				"to": 599000
			},
			"text": " which is what it's at now,"
		},
		{
			"timestamps": {
				"from": "00:09:59,000",
				"to": "00:10:02,000"
			},
			"offsets": {
				"from": 599000,
				"to": 602000
			},
			"text": " but you can't really see that because of that bulb."
		},
		{
			"timestamps": {
				"from": "00:10:02,000",
				"to": "00:10:05,000"
			},
			"offsets": {
				"from": 602000,
				"to": 605000
			},
			"text": " So we're going to get that out of the way."
		},
		{
			"timestamps": {
				"from": "00:10:05,000",
				"to": "00:10:07,000"
			},
			"offsets": {
				"from": 605000,
				"to": 607000
			},
			"text": " There you go, constant voltage."
		},
		{
			"timestamps": {
				"from": "00:10:07,000",
				"to": "00:10:11,000"
			},
			"offsets": {
				"from": 607000,
				"to": 611000
			},
			"text": " If I increase the voltage on the bulb now,"
		},
		{
			"timestamps": {
				"from": "00:10:11,000",
				"to": "00:10:14,000"
			},
			"offsets": {
				"from": 611000,
				"to": 614000
			},
			"text": " what we'll end up doing is driving the power supply"
		},
		{
			"timestamps": {
				"from": "00:10:14,000",
				"to": "00:10:17,000"
			},
			"offsets": {
				"from": 614000,
				"to": 617000
			},
			"text": " to be delivering its maximum current,"
		},
		{
			"timestamps": {
				"from": "00:10:17,000",
				"to": "00:10:20,000"
			},
			"offsets": {
				"from": 617000,
				"to": 620000
			},
			"text": " and then we'll flip across into constant current mode"
		},
		{
			"timestamps": {
				"from": "00:10:20,000",
				"to": "00:10:21,000"
			},
			"offsets": {
				"from": 620000,
				"to": 621000
			},
			"text": " at a certain voltage."
		},
		{
			"timestamps": {
				"from": "00:10:21,000",
				"to": "00:10:23,000"
			},
			"offsets": {
				"from": 621000,
				"to": 623000
			},
			"text": " So let's try that."
		},
		{
			"timestamps": {
				"from": "00:10:31,000",
				"to": "00:10:33,000"
			},
			"offsets": {
				"from": 631000,
				"to": 633000
			},
			"text": " There you go, so 24."
		},
		{
			"timestamps": {
				"from": "00:10:33,000",
				"to": "00:10:36,000"
			},
			"offsets": {
				"from": 633000,
				"to": 636000
			},
			"text": " Oops."
		},
		{
			"timestamps": {
				"from": "00:10:36,000",
				"to": "00:10:42,000"
			},
			"offsets": {
				"from": 636000,
				"to": 642000
			},
			"text": " 24, 25, 6."
		},
		{
			"timestamps": {
				"from": "00:10:42,000",
				"to": "00:10:44,000"
			},
			"offsets": {
				"from": 642000,
				"to": 644000
			},
			"text": " See, the current's going up."
		},
		{
			"timestamps": {
				"from": "00:10:44,000",
				"to": "00:10:46,000"
			},
			"offsets": {
				"from": 644000,
				"to": 646000
			},
			"text": " 27."
		},
		{
			"timestamps": {
				"from": "00:10:47,000",
				"to": "00:10:52,000"
			},
			"offsets": {
				"from": 647000,
				"to": 652000
			},
			"text": " 28."
		},
		{
			"timestamps": {
				"from": "00:10:52,000",
				"to": "00:10:54,000"
			},
			"offsets": {
				"from": 652000,
				"to": 654000
			},
			"text": " 29."
		},
		{
			"timestamps": {
				"from": "00:10:54,000",
				"to": "00:11:01,000"
			},
			"offsets": {
				"from": 654000,
				"to": 661000
			},
			"text": " We're in constant current mode now."
		},
		{
			"timestamps": {
				"from": "00:11:01,000",
				"to": "00:11:06,000"
			},
			"offsets": {
				"from": 661000,
				"to": 666000
			},
			"text": " The bulb went back down."
		},
		{
			"timestamps": {
				"from": "00:11:06,000",
				"to": "00:11:14,000"
			},
			"offsets": {
				"from": 666000,
				"to": 674000
			},
			"text": " Constant voltage mode."
		},
		{
			"timestamps": {
				"from": "00:11:14,000",
				"to": "00:11:16,000"
			},
			"offsets": {
				"from": 674000,
				"to": 676000
			},
			"text": " Constant current mode."
		},
		{
			"timestamps": {
				"from": "00:11:16,000",
				"to": "00:11:21,000"
			},
			"offsets": {
				"from": 676000,
				"to": 681000
			},
			"text": " So we're delivering pretty close to our 5.1 amps."
		},
		{
			"timestamps": {
				"from": "00:11:21,000",
				"to": "00:11:23,000"
			},
			"offsets": {
				"from": 681000,
				"to": 683000
			},
			"text": " Now, the thing's rated at 5 amps,"
		},
		{
			"timestamps": {
				"from": "00:11:23,000",
				"to": "00:11:25,000"
			},
			"offsets": {
				"from": 683000,
				"to": 685000
			},
			"text": " so it's got a little bit of overrange there,"
		},
		{
			"timestamps": {
				"from": "00:11:25,000",
				"to": "00:11:29,000"
			},
			"offsets": {
				"from": 685000,
				"to": 689000
			},
			"text": " but if you want your 5 amps, you're going to get it,"
		},
		{
			"timestamps": {
				"from": "00:11:29,000",
				"to": "00:11:31,000"
			},
			"offsets": {
				"from": 689000,
				"to": 691000
			},
			"text": " and obviously it hasn't blown up"
		},
		{
			"timestamps": {
				"from": "00:11:31,000",
				"to": "00:11:34,000"
			},
			"offsets": {
				"from": 691000,
				"to": 694000
			},
			"text": " because we're still being blinded."
		},
		{
			"timestamps": {
				"from": "00:11:38,000",
				"to": "00:11:43,000"
			},
			"offsets": {
				"from": 698000,
				"to": 703000
			},
			"text": " Multimeter has just done an auto-power off."
		},
		{
			"timestamps": {
				"from": "00:11:46,000",
				"to": "00:11:50,000"
			},
			"offsets": {
				"from": 706000,
				"to": 710000
			},
			"text": " Yep, it's all working."
		},
		{
			"timestamps": {
				"from": "00:11:50,000",
				"to": "00:11:54,000"
			},
			"offsets": {
				"from": 710000,
				"to": 714000
			},
			"text": " Let's just hit the M1, M4 button,"
		},
		{
			"timestamps": {
				"from": "00:11:54,000",
				"to": "00:11:58,000"
			},
			"offsets": {
				"from": 714000,
				"to": 718000
			},
			"text": " because that's the 31 volts, 5.1 amps."
		},
		{
			"timestamps": {
				"from": "00:11:58,000",
				"to": "00:12:00,000"
			},
			"offsets": {
				"from": 718000,
				"to": 720000
			},
			"text": " Turn that on."
		},
		{
			"timestamps": {
				"from": "00:12:00,000",
				"to": "00:12:06,000"
			},
			"offsets": {
				"from": 720000,
				"to": 726000
			},
			"text": " Yep, all good."
		},
		{
			"timestamps": {
				"from": "00:12:06,000",
				"to": "00:12:08,000"
			},
			"offsets": {
				"from": 726000,
				"to": 728000
			},
			"text": " Yep, nothing strange happening there."
		},
		{
			"timestamps": {
				"from": "00:12:08,000",
				"to": "00:12:14,000"
			},
			"offsets": {
				"from": 728000,
				"to": 734000
			},
			"text": " So we've tried to use this power supply."
		},
		{
			"timestamps": {
				"from": "00:12:14,000",
				"to": "00:12:16,000"
			},
			"offsets": {
				"from": 734000,
				"to": 736000
			},
			"text": " Well, we short-circuited it."
		},
		{
			"timestamps": {
				"from": "00:12:16,000",
				"to": "00:12:18,000"
			},
			"offsets": {
				"from": 736000,
				"to": 738000
			},
			"text": " We've given it intermittent short-circuit."
		},
		{
			"timestamps": {
				"from": "00:12:18,000",
				"to": "00:12:22,000"
			},
			"offsets": {
				"from": 738000,
				"to": 742000
			},
			"text": " We've tried to use it as a makeshift arc welder."
		},
		{
			"timestamps": {
				"from": "00:12:22,000",
				"to": "00:12:24,000"
			},
			"offsets": {
				"from": 742000,
				"to": 744000
			},
			"text": " We've driven it to full load."
		},
		{
			"timestamps": {
				"from": "00:12:24,000",
				"to": "00:12:27,000"
			},
			"offsets": {
				"from": 744000,
				"to": 747000
			},
			"text": " We've driven full current."
		},
		{
			"timestamps": {
				"from": "00:12:27,000",
				"to": "00:12:29,000"
			},
			"offsets": {
				"from": 747000,
				"to": 749000
			},
			"text": " I'm pretty satisfied with that."
		},
		{
			"timestamps": {
				"from": "00:12:29,000",
				"to": "00:12:30,000"
			},
			"offsets": {
				"from": 749000,
				"to": 750000
			},
			"text": " We have managed to blow it up."
		},
		{
			"timestamps": {
				"from": "00:12:30,000",
				"to": "00:12:32,000"
			},
			"offsets": {
				"from": 750000,
				"to": 752000
			},
			"text": " We've done similar to what Dave did"
		},
		{
			"timestamps": {
				"from": "00:12:32,000",
				"to": "00:12:34,000"
			},
			"offsets": {
				"from": 752000,
				"to": 754000
			},
			"text": " with the varying load conditions"
		},
		{
			"timestamps": {
				"from": "00:12:34,000",
				"to": "00:12:36,000"
			},
			"offsets": {
				"from": 754000,
				"to": 756000
			},
			"text": " when the one he did blew up."
		},
		{
			"timestamps": {
				"from": "00:12:36,000",
				"to": "00:12:37,000"
			},
			"offsets": {
				"from": 756000,
				"to": 757000
			},
			"text": " The interesting thing about this one is"
		},
		{
			"timestamps": {
				"from": "00:12:37,000",
				"to": "00:12:40,000"
			},
			"offsets": {
				"from": 757000,
				"to": 760000
			},
			"text": " this one's got a sticker on the back that says 240 volt."
		},
		{
			"timestamps": {
				"from": "00:12:40,000",
				"to": "00:12:42,000"
			},
			"offsets": {
				"from": 760000,
				"to": 762000
			},
			"text": " The ones that we tested previously at 220,"
		},
		{
			"timestamps": {
				"from": "00:12:42,000",
				"to": "00:12:46,000"
			},
			"offsets": {
				"from": 762000,
				"to": 766000
			},
			"text": " now, we were told that they were supposed to be capable"
		},
		{
			"timestamps": {
				"from": "00:12:46,000",
				"to": "00:12:48,000"
			},
			"offsets": {
				"from": 766000,
				"to": 768000
			},
			"text": " of running on 240 volts,"
		},
		{
			"timestamps": {
				"from": "00:12:48,000",
				"to": "00:12:51,000"
			},
			"offsets": {
				"from": 768000,
				"to": 771000
			},
			"text": " and one of the questions that we received from Corad"
		},
		{
			"timestamps": {
				"from": "00:12:51,000",
				"to": "00:12:53,000"
			},
			"offsets": {
				"from": 771000,
				"to": 773000
			},
			"text": " was what are the Australian voltages,"
		},
		{
			"timestamps": {
				"from": "00:12:53,000",
				"to": "00:12:56,000"
			},
			"offsets": {
				"from": 773000,
				"to": 776000
			},
			"text": " and we only received that question today."
		},
		{
			"timestamps": {
				"from": "00:12:56,000",
				"to": "00:13:01,000"
			},
			"offsets": {
				"from": 776000,
				"to": 781000
			},
			"text": " So I suspect that we might have had power supplies"
		},
		{
			"timestamps": {
				"from": "00:13:01,000",
				"to": "00:13:05,000"
			},
			"offsets": {
				"from": 781000,
				"to": 785000
			},
			"text": " that were designed for 220 volts and not 240,"
		},
		{
			"timestamps": {
				"from": "00:13:05,000",
				"to": "00:13:08,000"
			},
			"offsets": {
				"from": 785000,
				"to": 788000
			},
			"text": " because even that 20-volt difference,"
		},
		{
			"timestamps": {
				"from": "00:13:08,000",
				"to": "00:13:11,000"
			},
			"offsets": {
				"from": 788000,
				"to": 791000
			},
			"text": " by the time you stick that across your regulator transistors,"
		},
		{
			"timestamps": {
				"from": "00:13:11,000",
				"to": "00:13:13,000"
			},
			"offsets": {
				"from": 791000,
				"to": 793000
			},
			"text": " you're going to be dissipating a lot more power."
		},
		{
			"timestamps": {
				"from": "00:13:13,000",
				"to": "00:13:15,000"
			},
			"offsets": {
				"from": 793000,
				"to": 795000
			},
			"text": " So if the transistors aren't up to the job,"
		},
		{
			"timestamps": {
				"from": "00:13:15,000",
				"to": "00:13:16,000"
			},
			"offsets": {
				"from": 795000,
				"to": 796000
			},
			"text": " they're going to go,"
		},
		{
			"timestamps": {
				"from": "00:13:16,000",
				"to": "00:13:18,000"
			},
			"offsets": {
				"from": 796000,
				"to": 798000
			},
			"text": " and I suspect that's what's happened."
		},
		{
			"timestamps": {
				"from": "00:13:18,000",
				"to": "00:13:21,000"
			},
			"offsets": {
				"from": 798000,
				"to": 801000
			},
			"text": " But anyway, somebody will confirm that or deny it,"
		},
		{
			"timestamps": {
				"from": "00:13:21,000",
				"to": "00:13:26,000"
			},
			"offsets": {
				"from": 801000,
				"to": 806000
			},
			"text": " probably Corad, if they're listening to this."
		},
		{
			"timestamps": {
				"from": "00:13:26,000",
				"to": "00:13:28,000"
			},
			"offsets": {
				"from": 806000,
				"to": 808000
			},
			"text": " So Chrissie, if you're listening,"
		},
		{
			"timestamps": {
				"from": "00:13:28,000",
				"to": "00:13:30,000"
			},
			"offsets": {
				"from": 808000,
				"to": 810000
			},
			"text": " tell us what you've done, please."
		},
		{
			"timestamps": {
				"from": "00:13:30,000",
				"to": "00:13:31,000"
			},
			"offsets": {
				"from": 810000,
				"to": 811000
			},
			"text": " We'd like to know."
		},
		{
			"timestamps": {
				"from": "00:13:31,000",
				"to": "00:13:32,000"
			},
			"offsets": {
				"from": 811000,
				"to": 812000
			},
			"text": " But as far as I'm concerned,"
		},
		{
			"timestamps": {
				"from": "00:13:32,000",
				"to": "00:13:34,000"
			},
			"offsets": {
				"from": 812000,
				"to": 814000
			},
			"text": " if you send us the parts,"
		},
		{
			"timestamps": {
				"from": "00:13:34,000",
				"to": "00:13:36,000"
			},
			"offsets": {
				"from": 814000,
				"to": 816000
			},
			"text": " we'll modify all the supplies we've got,"
		},
		{
			"timestamps": {
				"from": "00:13:36,000",
				"to": "00:13:38,000"
			},
			"offsets": {
				"from": 816000,
				"to": 818000
			},
			"text": " and when we've modified them"
		},
		{
			"timestamps": {
				"from": "00:13:38,000",
				"to": "00:13:40,000"
			},
			"offsets": {
				"from": 818000,
				"to": 820000
			},
			"text": " and given them a bit of a test,"
		},
		{
			"timestamps": {
				"from": "00:13:40,000",
				"to": "00:13:43,000"
			},
			"offsets": {
				"from": 820000,
				"to": 823000
			},
			"text": " we'll put them back on sale with a two-year warranty."
		},
		{
			"timestamps": {
				"from": "00:13:43,000",
				"to": "00:13:46,000"
			},
			"offsets": {
				"from": 823000,
				"to": 826000
			},
			"text": " So I'll just do this again,"
		},
		{
			"timestamps": {
				"from": "00:13:46,000",
				"to": "00:13:52,000"
			},
			"offsets": {
				"from": 826000,
				"to": 832000
			},
			"text": " and I'll say this was an enlightening video."
		},
		{
			"timestamps": {
				"from": "00:13:52,000",
				"to": "00:13:53,000"
			},
			"offsets": {
				"from": 832000,
				"to": 833000
			},
			"text": " Yeah, sorry about that."
		},
		{
			"timestamps": {
				"from": "00:13:53,000",
				"to": "00:13:54,000"
			},
			"offsets": {
				"from": 833000,
				"to": 834000
			},
			"text": " Okay."
		},
		{
			"timestamps": {
				"from": "00:13:54,000",
				"to": "00:13:56,000"
			},
			"offsets": {
				"from": 834000,
				"to": 836000
			},
			"text": " It's now 5:00 to 8:00 in the evening,"
		},
		{
			"timestamps": {
				"from": "00:13:56,000",
				"to": "00:13:58,000"
			},
			"offsets": {
				"from": 836000,
				"to": 838000
			},
			"text": " and there's a beer waiting for me."
		},
		{
			"timestamps": {
				"from": "00:13:58,000",
				"to": "00:13:59,000"
			},
			"offsets": {
				"from": 838000,
				"to": 839000
			},
			"text": " I'll see you folks."
		},
		{
			"timestamps": {
				"from": "00:13:59,000",
				"to": "00:14:01,000"
			},
			"offsets": {
				"from": 839000,
				"to": 841000
			},
			"text": " All the best, and thanks for watching."
		}
	]
}
