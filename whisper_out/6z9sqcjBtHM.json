			},
			"offsets": {
				"from": 328000,
				"to": 332000
			},
			"text": " And it's good in that, well, it keeps you out of trouble, I guess."
		},
		{
			"timestamps": {
				"from": "00:05:32,000",
				"to": "00:05:35,000"
			},
			"offsets": {
				"from": 332000,
				"to": 335000
			},
			"text": " But it doesn't showcase your talents."
		},
		{
			"timestamps": {
				"from": "00:05:35,000",
				"to": "00:05:39,000"
			},
			"offsets": {
				"from": 335000,
				"to": 339000
			},
			"text": " Yeah, if you hide all that away, does that hinder or enhance?"
		},
		{
			"timestamps": {
				"from": "00:05:39,000",
				"to": "00:05:40,000"
			},
			"offsets": {
				"from": 339000,
				"to": 340000
			},
			"text": " Leave it in the comments."
		},
		{
			"timestamps": {
				"from": "00:05:40,000",
				"to": "00:05:42,000"
			},
			"offsets": {
				"from": 340000,
				"to": 342000
			},
			"text": " Leave it in the comments down below."
		},
		{
			"timestamps": {
				"from": "00:05:42,000",
				"to": "00:05:43,000"
			},
			"offsets": {
				"from": 342000,
				"to": 343000
			},
			"text": " I'm going to spin that video out."
		},
		{
			"timestamps": {
				"from": "00:05:43,000",
				"to": "00:05:46,000"
			},
			"offsets": {
				"from": 343000,
				"to": 346000
			},
			"text": " Is having no social media actually being secretive?"
		},
		{
			"timestamps": {
				"from": "00:05:46,000",
				"to": "00:05:48,000"
			},
			"offsets": {
				"from": 346000,
				"to": 348000
			},
			"text": " I think in the modern age it is."
		},
		{
			"timestamps": {
				"from": "00:05:48,000",
				"to": "00:05:50,000"
			},
			"offsets": {
				"from": 348000,
				"to": 350000
			},
			"text": " No, Milo."
		},
		{
			"timestamps": {
				"from": "00:05:50,000",
				"to": "00:05:51,000"
			},
			"offsets": {
				"from": 350000,
				"to": 351000
			},
			"text": " I don't agree."
		},
		{
			"timestamps": {
				"from": "00:05:51,000",
				"to": "00:05:53,000"
			},
			"offsets": {
				"from": 351000,
				"to": 353000
			},
			"text": " Nothing but positive things in it."
		},
		{
			"timestamps": {
				"from": "00:05:53,000",
				"to": "00:05:56,000"
			},
			"offsets": {
				"from": 353000,
				"to": 356000
			},
			"text": " That could be a negative."
		},
		{
			"timestamps": {
				"from": "00:05:56,000",
				"to": "00:06:04,000"
			},
			"offsets": {
				"from": 356000,
				"to": 364000
			},
			"text": " Like, what is deemed positive things to one person is, like, not positive to another."
		},
		{
			"timestamps": {
				"from": "00:06:04,000",
				"to": "00:06:05,000"
			},
			"offsets": {
				"from": 364000,
				"to": 365000
			},
			"text": " Or is just annoying."
		},
		{
			"timestamps": {
				"from": "00:06:05,000",
				"to": "00:06:09,000"
			},
			"offsets": {
				"from": 365000,
				"to": 369000
			},
			"text": " You know, you could post, you know, these positive life-affirming things."
		},
		{
			"timestamps": {
				"from": "00:06:09,000",
				"to": "00:06:10,000"
			},
			"offsets": {
				"from": 369000,
				"to": 370000
			},
			"text": " Oh, life is wonderful."
		},
		{
			"timestamps": {
				"from": "00:06:10,000",
				"to": "00:06:17,000"
			},
			"offsets": {
				"from": 370000,
				"to": 377000
			},
			"text": " And you post all those meme, you know, wonderful life is brilliant and happiness and smell the roses and all that sort of stuff."
		},
		{
			"timestamps": {
				"from": "00:06:17,000",
				"to": "00:06:21,000"
			},
			"offsets": {
				"from": 377000,
				"to": 381000
			},
			"text": " And somebody could see that and go, who's this wanker?"
		},
		{
			"timestamps": {
				"from": "00:06:21,000",
				"to": "00:06:23,000"
			},
			"offsets": {
				"from": 381000,
				"to": 383000
			},
			"text": " You know, like, you know."
		},
		{
			"timestamps": {
				"from": "00:06:23,000",
				"to": "00:06:24,000"
			},
			"offsets": {
				"from": 383000,
				"to": 384000
			},
			"text": " So, no."
		},
		{
			"timestamps": {
				"from": "00:06:24,000",
				"to": "00:06:26,000"
			},
			"offsets": {
				"from": 384000,
				"to": 386000
			},
			"text": " You can't."
		},
		{
			"timestamps": {
				"from": "00:06:26,000",
				"to": "00:06:30,000"
			},
			"offsets": {
				"from": 386000,
				"to": 390000
			},
			"text": " There's no such thing as, you know, all positive."
		},
		{
			"timestamps": {
				"from": "00:06:30,000",
				"to": "00:06:34,000"
			},
			"offsets": {
				"from": 390000,
				"to": 394000
			},
			"text": " Somebody will see that as a negative trait in some way."
		},
		{
			"timestamps": {
				"from": "00:06:34,000",
				"to": "00:06:36,000"
			},
			"offsets": {
				"from": 394000,
				"to": 396000
			},
			"text": " You know, they're not after that kind of person."
		},
		{
			"timestamps": {
				"from": "00:06:36,000",
				"to": "00:06:38,000"
			},
			"offsets": {
				"from": 396000,
				"to": 398000
			},
			"text": " I don't want some arty, flarty, fussy."
		},
		{
			"timestamps": {
				"from": "00:06:38,000",
				"to": "00:06:41,000"
			},
			"offsets": {
				"from": 398000,
				"to": 401000
			},
			"text": " You know, person who's just airy-fairy."
		},
		{
			"timestamps": {
				"from": "00:06:41,000",
				"to": "00:06:48,000"
			},
			"offsets": {
				"from": 401000,
				"to": 408000
			},
			"text": " Who's, you know, posting all positive things about, you know, saving the orphans and stuff like that."
		},
		{
			"timestamps": {
				"from": "00:06:48,000",
				"to": "00:06:50,000"
			},
			"offsets": {
				"from": 408000,
				"to": 410000
			},
			"text": " And saving the whales and saving the environment."
		},
		{
			"timestamps": {
				"from": "00:06:50,000",
				"to": "00:06:52,000"
			},
			"offsets": {
				"from": 410000,
				"to": 412000
			},
			"text": " And that's all they post on their Facebook page."
		},
		{
			"timestamps": {
				"from": "00:06:52,000",
				"to": "00:06:53,000"
			},
			"offsets": {
				"from": 412000,
				"to": 413000
			},
			"text": " And it's like, oh, okay."
		},
		{
			"timestamps": {
				"from": "00:06:53,000",
				"to": "00:06:58,000"
			},
			"offsets": {
				"from": 413000,
				"to": 418000
			},
			"text": " It's like, it's all can be, you know, it's not going to, it's not going to be negative."
		},
		{
			"timestamps": {
				"from": "00:06:58,000",
				"to": "00:07:00,000"
			},
			"offsets": {
				"from": 418000,
				"to": 420000
			},
			"text": " It's not going to get you, you know, controversial."
		},
		{
			"timestamps": {
				"from": "00:07:00,000",
				"to": "00:07:04,000"
			},
			"offsets": {
				"from": 420000,
				"to": 424000
			},
			"text": " Some people might look at, somebody's laughing at Silverbrook."
		},
		{
			"timestamps": {
				"from": "00:07:04,000",
				"to": "00:07:07,000"
			},
			"offsets": {
				"from": 424000,
				"to": 427000
			},
			"text": " Anyway, having zero social media accounts is a sign of genius and ingenuity."
		},
		{
			"timestamps": {
				"from": "00:07:07,000",
				"to": "00:07:09,000"
			},
			"offsets": {
				"from": 427000,
				"to": 429000
			},
			"text": " It's a sign of genius and independent thinking."
		},
		{
			"timestamps": {
				"from": "00:07:09,000",
				"to": "00:07:11,000"
			},
			"offsets": {
				"from": 429000,
				"to": 431000
			},
			"text": " Could be, could be."
		},
		{
			"timestamps": {
				"from": "00:07:11,000",
				"to": "00:07:14,000"
			},
			"offsets": {
				"from": 431000,
				"to": 434000
			},
			"text": " But once again, it may not, you know."
		},
		{
			"timestamps": {
				"from": "00:07:14,000",
				"to": "00:07:17,000"
			},
			"offsets": {
				"from": 434000,
				"to": 437000
			},
			"text": " So that's an interesting question."
		},
		{
			"timestamps": {
				"from": "00:07:17,000",
				"to": "00:07:30,000"
			},
			"offsets": {
				"from": 437000,
				"to": 450000
			},
			"text": " I would say that probably, my guess would be that having no social media presence at all is probably going to help more than, well, it can't hinder."
		},
		{
			"timestamps": {
				"from": "00:07:30,000",
				"to": "00:07:36,000"
			},
			"offsets": {
				"from": 450000,
				"to": 456000
			},
			"text": " I suspect it's not going to hinder you by having no social media accounts."
		},
		{
			"timestamps": {
				"from": "00:07:36,000",
				"to": "00:07:40,000"
			},
			"offsets": {
				"from": 456000,
				"to": 460000
			},
			"text": " If you have like personal website, that is definitely going to hinder more than it helps."
		},
		{
			"timestamps": {
				"from": "00:07:40,000",
				"to": "00:07:43,000"
			},
			"offsets": {
				"from": 460000,
				"to": 463000
			},
			"text": " So that, that'd be my take on it."
		},
		{
			"timestamps": {
				"from": "00:07:43,000",
				"to": "00:07:45,000"
			},
			"offsets": {
				"from": 463000,
				"to": 465000
			},
			"text": " Anyway, let me know what you think down below."
		},
		{
			"timestamps": {
				"from": "00:07:45,000",
				"to": "00:07:55,000"
			},
			"offsets": {
				"from": 465000,
				"to": 475000
			},
			"text": " But having said that, there are some people, of course, who will see your social media presence and go, oh, yes, I'll hire you because you're not an SJW."
		},
		{
			"timestamps": {
				"from": "00:07:55,000",
				"to": "00:07:57,000"
			},
			"offsets": {
				"from": 475000,
				"to": 477000
			},
			"text": " You're not going to destroy my company."
		},
		{
			"timestamps": {
				"from": "00:07:57,000",
				"to": "00:07:59,000"
			},
			"offsets": {
				"from": 477000,
				"to": 479000
			},
			"text": " You know, it's like, yeah."
		},
		{
			"timestamps": {
				"from": "00:07:59,000",
				"to": "00:08:05,000"
			},
			"offsets": {
				"from": 479000,
				"to": 485000
			},
			"text": " So there's, but other companies will go, oh, no, you're not an SJW."
		},
		{
			"timestamps": {
				"from": "00:08:05,000",
				"to": "00:08:07,000"
			},
			"offsets": {
				"from": 485000,
				"to": 487000
			},
			"text": " Therefore, we're not going to hire you."
		},
		{
			"timestamps": {
				"from": "00:08:07,000",
				"to": "00:08:19,000"
			},
			"offsets": {
				"from": 487000,
				"to": 499000
			},
			"text": " It's like, you know, it's one of those, yeah, I guess you've got to work in Silicon Valley, you know, is different to somewhere else, perhaps like Australia."
		},
		{
			"timestamps": {
				"from": "00:08:19,000",
				"to": "00:08:21,000"
			},
			"offsets": {
				"from": 499000,
				"to": 501000
			},
			"text": " LinkedIn is just an annoying HR tool."
		},
		{
			"timestamps": {
				"from": "00:08:21,000",
				"to": "00:08:26,000"
			},
			"offsets": {
				"from": 501000,
				"to": 506000
			},
			"text": " Yeah, whether or not, should you have a LinkedIn account?"
		},
		{
			"timestamps": {
				"from": "00:08:26,000",
				"to": "00:08:32,000"
			},
			"offsets": {
				"from": 506000,
				"to": 512000
			},
			"text": " You know, probably you should, like, because that's what the HR droids look at these days."
		},
		{
			"timestamps": {
				"from": "00:08:32,000",
				"to": "00:08:34,000"
			},
			"offsets": {
				"from": 512000,
				"to": 514000
			},
			"text": " So if you're not on LinkedIn, they're going to go, well."
		},
		{
			"timestamps": {
				"from": "00:08:34,000",
				"to": "00:08:41,000"
			},
			"offsets": {
				"from": 514000,
				"to": 521000
			},
			"text": " I can't do my job anymore because their whole, I think their sole job now is looking at LinkedIn and looking at your Twitter profile, isn't it?"
		},
		{
			"timestamps": {
				"from": "00:08:41,000",
				"to": "00:08:45,000"
			},
			"offsets": {
				"from": 521000,
				"to": 525000
			},
			"text": " That's the sole job of a HR, useless HR droids."
		},
		{
			"timestamps": {
				"from": "00:08:45,000",
				"to": "00:08:49,000"
			},
			"offsets": {
				"from": 525000,
				"to": 529000
			},
			"text": " Yeah, so LinkedIn, as much as I don't like, well, I don't need LinkedIn."
		},
		{
			"timestamps": {
				"from": "00:08:49,000",
				"to": "00:08:53,000"
			},
			"offsets": {
				"from": 529000,
				"to": 533000
			},
			"text": " I've still got it because I link to people on there, you know, like colleagues and stuff."
		},
		{
			"timestamps": {
				"from": "00:08:53,000",
				"to": "00:08:56,000"
			},
			"offsets": {
				"from": 533000,
				"to": 536000
			},
			"text": " I've got like 500, you know, other colleagues on there I link to."
		},
		{
			"timestamps": {
				"from": "00:08:56,000",
				"to": "00:08:58,000"
			},
			"offsets": {
				"from": 536000,
				"to": 538000
			},
			"text": " I don't need it for a job, obviously."
		},
		{
			"timestamps": {
				"from": "00:08:58,000",
				"to": "00:09:02,000"
			},
			"offsets": {
				"from": 538000,
				"to": 542000
			},
			"text": " But I'd say, yeah, you probably need LinkedIn."
		},
		{
			"timestamps": {
				"from": "00:09:02,000",
				"to": "00:09:03,000"
			},
			"offsets": {
				"from": 542000,
				"to": 543000
			},
			"text": " I mean, that can't hurt."
		},
		{
			"timestamps": {
				"from": "00:09:03,000",
				"to": "00:09:05,000"
			},
			"offsets": {
				"from": 543000,
				"to": 545000
			},
			"text": " Like, don't post stuff on LinkedIn."
		},
		{
			"timestamps": {
				"from": "00:09:05,000",
				"to": "00:09:10,000"
			},
			"offsets": {
				"from": 545000,
				"to": 550000
			},
			"text": " Just have a LinkedIn profile with your career stuff and your education and things like that."
		},
		{
			"timestamps": {
				"from": "00:09:10,000",
				"to": "00:09:14,000"
			},
			"offsets": {
				"from": 550000,
				"to": 554000
			},
			"text": " And, you know, what societies you belong to, you know, IEEE or something like that."
		},
		{
			"timestamps": {
				"from": "00:09:14,000",
				"to": "00:09:17,000"
			},
			"offsets": {
				"from": 554000,
				"to": 557000
			},
			"text": " And that'll, you know, that's it, done."
		},
		{
			"timestamps": {
				"from": "00:09:17,000",
				"to": "00:09:21,000"
			},
			"offsets": {
				"from": 557000,
				"to": 561000
			},
			"text": " And just, you know, have endorsements from other people because that's what HR are going to look at as well."
		},
		{
			"timestamps": {
				"from": "00:09:21,000",
				"to": "00:09:24,000"
			},
			"offsets": {
				"from": 561000,
				"to": 564000
			},
			"text": " They'll look at endorsements from other people."
		},
		{
			"timestamps": {
				"from": "00:09:24,000",
				"to": "00:09:26,000"
			},
			"offsets": {
				"from": 564000,
				"to": 566000
			},
			"text": " That's changed a lot since I last went for a job."
		},
		{
			"timestamps": {
				"from": "00:09:26,000",
				"to": "00:09:28,000"
			},
			"offsets": {
				"from": 566000,
				"to": 568000
			},
			"text": " You know, there was no LinkedIn."
		},
		{
			"timestamps": {
				"from": "00:09:28,000",
				"to": "00:09:32,000"
			},
			"offsets": {
				"from": 568000,
				"to": 572000
			},
			"text": " On the flip side, couldn't you brand yourself an SJW to get a job in San Francisco?"
		},
		{
			"timestamps": {
				"from": "00:09:32,000",
				"to": "00:09:33,000"
			},
			"offsets": {
				"from": 572000,
				"to": 573000
			},
			"text": " You could."
		},
		{
			"timestamps": {
				"from": "00:09:33,000",
				"to": "00:09:38,000"
			},
			"offsets": {
				"from": 573000,
				"to": 578000
			},
			"text": " This is all to do with tailoring your resume, right?"
		},
		{
			"timestamps": {
				"from": "00:09:38,000",
				"to": "00:09:43,000"
			},
			"offsets": {
				"from": 578000,
				"to": 583000
			},
			"text": " Tailoring your resume, always tailor your resume to the job that you're applying for."
		},
		{
			"timestamps": {
				"from": "00:09:43,000",
				"to": "00:09:53,000"
			},
