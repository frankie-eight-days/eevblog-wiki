			"timestamps": {
				"from": "00:00:45,000",
				"to": "00:00:51,000"
			},
			"offsets": {
				"from": 45000,
				"to": 51000
			},
			"text": " About, like, not have social media accounts, not have anything that they can research on you or anything like that."
