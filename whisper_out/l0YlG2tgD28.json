				"from": 281180,
				"to": 282340
			},
			"text": " It is..."
		},
		{
			"timestamps": {
				"from": "00:04:43,040",
				"to": "00:04:44,340"
			},
			"offsets": {
				"from": 283040,
				"to": 284340
			},
			"text": " Oh, there's some more..."
		},
		{
			"timestamps": {
				"from": "00:04:45,520",
				"to": "00:04:46,040"
			},
			"offsets": {
				"from": 285520,
				"to": 286040
			},
			"text": " Yeah."
		},
		{
			"timestamps": {
				"from": "00:04:46,800",
				"to": "00:04:48,660"
			},
			"offsets": {
				"from": 286800,
				"to": 288660
			},
			"text": " Some more commentary going on there."
		},
		{
			"timestamps": {
				"from": "00:04:49,020",
				"to": "00:04:50,320"
			},
			"offsets": {
				"from": 289020,
				"to": 290320
			},
			"text": " Not sure what all the letters..."
		},
		{
			"timestamps": {
				"from": "00:04:50,320",
				"to": "00:04:55,660"
			},
			"offsets": {
				"from": 290320,
				"to": 295660
			},
			"text": " I don't know what the numbers mean, but that is what a dual..."
		},
		{
			"timestamps": {
				"from": "00:04:55,660",
				"to": "00:04:57,080"
			},
			"offsets": {
				"from": 295660,
				"to": 297080
			},
			"text": " They're pin 1, there you go."
		},
		{
			"timestamps": {
				"from": "00:04:57,080",
				"to": "00:05:02,060"
			},
			"offsets": {
				"from": 297080,
				"to": 302060
			},
			"text": " So they've actually labelled them with the pin numbers."
		},
		{
			"timestamps": {
				"from": "00:05:02,060",
				"to": "00:05:06,160"
			},
			"offsets": {
				"from": 302060,
				"to": 306160
			},
			"text": " So let's go back to 200, that's a 400 times magnification, it's a bit much."
		},
		{
			"timestamps": {
				"from": "00:05:06,160",
				"to": "00:05:11,140"
			},
			"offsets": {
				"from": 306160,
				"to": 311140
			},
			"text": " Only if you want to see the detail, it's not good for panning around and stuff like that."
		},
		{
			"timestamps": {
				"from": "00:05:11,140",
				"to": "00:05:12,380"
			},
			"offsets": {
				"from": 311140,
				"to": 312380
			},
			"text": " So that's pin 1."
		},
		{
			"timestamps": {
				"from": "00:05:12,380",
				"to": "00:05:16,140"
			},
			"offsets": {
				"from": 312380,
				"to": 316140
			},
			"text": " Okay, they don't label the other pins."
		},
		{
			"timestamps": {
				"from": "00:05:16,140",
				"to": "00:05:18,920"
			},
			"offsets": {
				"from": 316140,
				"to": 318920
			},
			"text": " But pin 1 starts there and then goes around."
		},
		{
			"timestamps": {
				"from": "00:05:20,300",
				"to": "00:05:24,040"
			},
			"offsets": {
				"from": 320300,
				"to": 324040
			},
			"text": " I've just got the wafer sitting on, like, a post-it note."
		},
		{
			"timestamps": {
				"from": "00:05:25,060",
				"to": "00:05:30,260"
			},
			"offsets": {
				"from": 325060,
				"to": 330260
			},
			"text": " Just to sort of raise it up, because the stage doesn't go high enough to get to the focus point."
		},
		{
			"timestamps": {
				"from": "00:05:31,160",
				"to": "00:05:34,300"
			},
			"offsets": {
				"from": 331160,
				"to": 334300
			},
			"text": " So, which is kind of annoying, so..."
		},
		{
			"timestamps": {
				"from": "00:05:35,780",
				"to": "00:05:37,120"
			},
			"offsets": {
				"from": 335780,
				"to": 337120
			},
			"text": " Why are they..."
		},
		{
			"timestamps": {
				"from": "00:05:37,120",
				"to": "00:05:40,860"
			},
			"offsets": {
				"from": 337120,
				"to": 340860
			},
			"text": " Look, they've labelled those drains, but they've got big pads connected to the drain."
		},
		{
			"timestamps": {
				"from": "00:05:40,980",
				"to": "00:05:41,300"
			},
			"offsets": {
				"from": 340980,
				"to": 341300
			},
			"text": " It's like..."
		},
		{
			"timestamps": {
				"from": "00:05:42,260",
				"to": "00:05:43,240"
			},
			"offsets": {
				"from": 342260,
				"to": 343240
			},
			"text": " It's fascinating."
		},
		{
			"timestamps": {
				"from": "00:05:43,480",
				"to": "00:05:43,900"
			},
			"offsets": {
				"from": 343480,
				"to": 343900
			},
			"text": " Why?"
		},
		{
			"timestamps": {
				"from": "00:05:45,120",
				"to": "00:05:45,560"
			},
			"offsets": {
				"from": 345120,
				"to": 345560
			},
			"text": " Why?"
		},
		{
			"timestamps": {
				"from": "00:05:45,640",
				"to": "00:05:46,720"
			},
			"offsets": {
				"from": 345640,
				"to": 346720
			},
			"text": " Are they big test pads?"
		},
		{
			"timestamps": {
				"from": "00:05:46,840",
				"to": "00:05:47,680"
			},
			"offsets": {
				"from": 346840,
				"to": 347680
			},
			"text": " Do they test them?"
		},
		{
			"timestamps": {
				"from": "00:05:48,520",
				"to": "00:05:49,480"
			},
			"offsets": {
				"from": 348520,
				"to": 349480
			},
			"text": " Or something like that?"
		},
		{
			"timestamps": {
				"from": "00:05:49,480",
				"to": "00:05:50,280"
			},
			"offsets": {
				"from": 349480,
				"to": 350280
			},
			"text": " I'm not sure what they're doing."
		},
		{
			"timestamps": {
				"from": "00:05:50,280",
				"to": "00:05:50,720"
			},
			"offsets": {
				"from": 350280,
				"to": 350720
			},
			"text": " I'm not sure what the deal is."
		},
		{
			"timestamps": {
				"from": "00:05:50,800",
				"to": "00:05:51,940"
			},
			"offsets": {
				"from": 350800,
				"to": 351940
			},
			"text": " P-well, source..."
		},
		{
			"timestamps": {
				"from": "00:05:51,940",
				"to": "00:05:52,400"
			},
			"offsets": {
				"from": 351940,
				"to": 352400
			},
			"text": " Oh!"
		},
		{
			"timestamps": {
				"from": "00:05:52,640",
				"to": "00:05:53,020"
			},
			"offsets": {
				"from": 352640,
				"to": 353020
			},
			"text": " No!"
		},
		{
			"timestamps": {
				"from": "00:05:53,220",
				"to": "00:05:53,500"
			},
			"offsets": {
				"from": 353220,
				"to": 353500
			},
			"text": " They're..."
		},
		{
			"timestamps": {
				"from": "00:05:53,500",
				"to": "00:05:54,920"
			},
			"offsets": {
				"from": 353500,
				"to": 354920
			},
			"text": " Okay, that's not part of the die."
		},
		{
			"timestamps": {
				"from": "00:05:55,340",
				"to": "00:05:55,700"
			},
			"offsets": {
				"from": 355340,
				"to": 355700
			},
			"text": " Okay."
		},
		{
			"timestamps": {
				"from": "00:05:57,220",
				"to": "00:06:00,220"
			},
			"offsets": {
				"from": 357220,
				"to": 360220
			},
			"text": " That is a test strip in the middle, right?"
		},
		{
			"timestamps": {
				"from": "00:06:00,280",
				"to": "00:06:03,260"
			},
			"offsets": {
				"from": 360280,
				"to": 363260
			},
			"text": " So they've just got MOSFET in the middle, right?"
		},
		{
			"timestamps": {
				"from": "00:06:04,200",
				"to": "00:06:04,720"
			},
			"offsets": {
				"from": 364200,
				"to": 364720
			},
			"text": " Drain..."
		},
		{
			"timestamps": {
				"from": "00:06:04,720",
				"to": "00:06:08,240"
			},
			"offsets": {
				"from": 364720,
				"to": 368240
			},
			"text": " Oh, yeah, multiple drains."
		},
		{
			"timestamps": {
				"from": "00:06:09,100",
				"to": "00:06:09,300"
			},
			"offsets": {
				"from": 369100,
				"to": 369300
			},
			"text": " No?"
		},
		{
			"timestamps": {
				"from": "00:06:10,080",
				"to": "00:06:11,740"
			},
			"offsets": {
				"from": 370080,
				"to": 371740
			},
			"text": " Anyway, yeah, that..."
		},
		{
			"timestamps": {
				"from": "00:06:11,740",
				"to": "00:06:14,900"
			},
			"offsets": {
				"from": 371740,
				"to": 374900
			},
			"text": " You can see the corner of the two dies there."
		},
		{
			"timestamps": {
				"from": "00:06:14,980",
				"to": "00:06:15,740"
			},
			"offsets": {
				"from": 374980,
				"to": 375740
			},
			"text": " So that's in the middle."
		},
		{
			"timestamps": {
				"from": "00:06:15,740",
				"to": "00:06:18,740"
			},
			"offsets": {
				"from": 375740,
				"to": 378740
			},
			"text": " They've just put, obviously, a test..."
		},
		{
			"timestamps": {
				"from": "00:06:20,260",
				"to": "00:06:22,400"
			},
			"offsets": {
				"from": 380260,
				"to": 382400
			},
			"text": " Some test transistors in there."
		},
		{
			"timestamps": {
				"from": "00:06:22,700",
				"to": "00:06:24,420"
			},
			"offsets": {
				"from": 382700,
				"to": 384420
			},
			"text": " So that's not part of..."
		},
		{
			"timestamps": {
				"from": "00:06:24,420",
				"to": "00:06:25,760"
			},
			"offsets": {
				"from": 384420,
				"to": 385760
			},
			"text": " Of course, it didn't make sense."
		},
		{
			"timestamps": {
				"from": "00:06:26,120",
				"to": "00:06:27,300"
			},
			"offsets": {
				"from": 386120,
				"to": 387300
			},
			"text": " You know, there they are again."
		},
		{
			"timestamps": {
				"from": "00:06:27,580",
				"to": "00:06:28,200"
			},
			"offsets": {
				"from": 387580,
				"to": 388200
			},
			"text": " Right there."
		},
		{
			"timestamps": {
				"from": "00:06:28,260",
				"to": "00:06:30,500"
			},
			"offsets": {
				"from": 388260,
				"to": 390500
			},
			"text": " So the die finishes, start and ends there."
		},
		{
			"timestamps": {
				"from": "00:06:30,800",
				"to": "00:06:32,340"
			},
			"offsets": {
				"from": 390800,
				"to": 392340
			},
			"text": " So that's what we're looking at here."
		},
		{
			"timestamps": {
				"from": "00:06:33,020",
				"to": "00:06:34,380"
			},
			"offsets": {
				"from": 393020,
				"to": 394380
			},
			"text": " So we're looking at the die now."
		},
		{
			"timestamps": {
				"from": "00:06:35,020",
				"to": "00:06:38,660"
			},
			"offsets": {
				"from": 395020,
				"to": 398660
			},
			"text": " So they've just got some features there that they can, I guess, just test them."
		},
		{
			"timestamps": {
				"from": "00:06:40,560",
				"to": "00:06:45,340"
			},
			"offsets": {
				"from": 400560,
				"to": 405340
			},
			"text": " That the MOSFET functionality is working well."
		},
		{
			"timestamps": {
				"from": "00:06:45,880",
				"to": "00:06:47,720"
			},
			"offsets": {
				"from": 405880,
				"to": 407720
			},
			"text": " So, no pun intended, well."
		},
		{
			"timestamps": {
				"from": "00:06:47,900",
				"to": "00:06:48,340"
			},
			"offsets": {
				"from": 407900,
				"to": 408340
			},
			"text": " Get it?"
		},
		{
			"timestamps": {
				"from": "00:06:48,340",
				"to": "00:06:49,500"
			},
			"offsets": {
				"from": 408340,
				"to": 409500
			},
			"text": " Talking about dies."
		},
		{
			"timestamps": {
				"from": "00:06:50,240",
				"to": "00:06:53,060"
			},
			"offsets": {
				"from": 410240,
				"to": 413060
			},
			"text": " Anyway, there you go."
		},
		{
			"timestamps": {
				"from": "00:06:53,220",
				"to": "00:06:56,680"
			},
			"offsets": {
				"from": 413220,
				"to": 416680
			},
			"text": " I just thought, that is beautiful color, and I thought you might want to see that."
		},
		{
			"timestamps": {
				"from": "00:06:57,120",
				"to": "00:07:00,620"
			},
			"offsets": {
				"from": 417120,
				"to": 420620
			},
			"text": " I just find that absolutely gorgeous."
		},
		{
			"timestamps": {
				"from": "00:07:00,780",
				"to": "00:07:02,380"
			},
			"offsets": {
				"from": 420780,
				"to": 422380
			},
			"text": " So thank you very much, Antoine."
		},
		{
			"timestamps": {
				"from": "00:07:02,480",
				"to": "00:07:06,800"
			},
			"offsets": {
				"from": 422480,
				"to": 426800
			},
			"text": " I'm going to do more videos on all the dies he's sending."
		},
		{
			"timestamps": {
				"from": "00:07:06,920",
				"to": "00:07:09,700"
			},
			"offsets": {
				"from": 426920,
				"to": 429700
			},
			"text": " We've got, like, test dies and all sorts of cool stuff."
		},
		{
			"timestamps": {
				"from": "00:07:10,540",
				"to": "00:07:12,940"
			},
			"offsets": {
				"from": 430540,
				"to": 432940
			},
			"text": " But that one is particularly colorful."
		},
		{
			"timestamps": {
				"from": "00:07:13,280",
				"to": "00:07:14,680"
			},
			"offsets": {
				"from": 433280,
				"to": 434680
			},
			"text": " It's the only green one in the batch."
		},
		{
			"timestamps": {
				"from": "00:07:14,680",
				"to": "00:07:19,180"
			},
			"offsets": {
				"from": 434680,
				"to": 439180
			},
			"text": " Anyway, if you are into the semiconductor processing business,"
		},
		{
			"timestamps": {
				"from": "00:07:19,440",
				"to": "00:07:20,220"
			},
			"offsets": {
				"from": 439440,
				"to": 440220
			},
			"text": " leave us some..."
		},
		{
			"timestamps": {
				"from": "00:07:20,220",
				"to": "00:07:23,020"
			},
			"offsets": {
				"from": 440220,
				"to": 443020
			},
			"text": " Leave us some comments down below with what you think of this puppy."
		},
		{
			"timestamps": {
				"from": "00:07:24,020",
				"to": "00:07:25,620"
			},
			"offsets": {
				"from": 444020,
				"to": 445620
			},
			"text": " Anyway, hope you enjoyed it."
		},
		{
			"timestamps": {
				"from": "00:07:26,120",
				"to": "00:07:27,120"
			},
			"offsets": {
				"from": 446120,
				"to": 447120
			},
			"text": " Catch you next time."
		},
		{
			"timestamps": {
				"from": "00:07:27,120",
				"to": "00:07:27,120"
			},
			"offsets": {
				"from": 447120,
				"to": 447120
			},
			"text": " Subtitles by the Amara.org community"
		}
	]
}
