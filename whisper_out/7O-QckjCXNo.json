			"offsets": {
				"from": 434800,
				"to": 435420
			},
			"text": " Like, it."
		},
		{
			"timestamps": {
				"from": "00:07:15,480",
				"to": "00:07:16,860"
			},
			"offsets": {
				"from": 435480,
				"to": 436860
			},
			"text": " It sounds real enough."
		},
		{
			"timestamps": {
				"from": "00:07:16,920",
				"to": "00:07:17,420"
			},
			"offsets": {
				"from": 436920,
				"to": 437420
			},
			"text": " But I don't know."
		},
		{
			"timestamps": {
				"from": "00:07:17,500",
				"to": "00:07:19,200"
			},
			"offsets": {
				"from": 437500,
				"to": 439200
			},
			"text": " It might be, like, an AI voice or something."
		},
		{
			"timestamps": {
				"from": "00:07:19,380",
				"to": "00:07:19,740"
			},
			"offsets": {
				"from": 439380,
				"to": 439740
			},
			"text": " But, yeah."
		},
		{
			"timestamps": {
				"from": "00:07:19,860",
				"to": "00:07:22,500"
			},
			"offsets": {
				"from": 439860,
				"to": 442500
			},
			"text": " These channels are just insane."
		},
		{
			"timestamps": {
				"from": "00:07:23,180",
				"to": "00:07:24,920"
			},
			"offsets": {
				"from": 443180,
				"to": 444920
			},
			"text": " And there's tons of them."
		},
		{
			"timestamps": {
				"from": "00:07:25,020",
				"to": "00:07:26,020"
			},
			"offsets": {
				"from": 445020,
				"to": 446020
			},
			"text": " It's not just this one."
		},
		{
			"timestamps": {
				"from": "00:07:26,020",
				"to": "00:07:30,020"
			},
			"offsets": {
				"from": 446020,
				"to": 450020
			},
			"text": " And this is, like, one of the most advanced ones with, like, proper voiceovers."
		},
		{
			"timestamps": {
				"from": "00:07:30,780",
				"to": "00:07:33,880"
			},
			"offsets": {
				"from": 450780,
				"to": 453880
			},
			"text": " And technically, you'll get a little bit of what's in the title."
		},
		{
			"timestamps": {
				"from": "00:07:34,000",
				"to": "00:07:40,200"
			},
			"offsets": {
				"from": 454000,
				"to": 460200
			},
			"text": " Like, they'll mix up, you know, the James Webb Space Telescope with, you know, information about Proxima b and sun."
		},
		{
			"timestamps": {
				"from": "00:07:40,240",
				"to": "00:07:42,340"
			},
			"offsets": {
				"from": 460240,
				"to": 462340
			},
			"text": " Even though they're not related at all."
		},
		{
			"timestamps": {
				"from": "00:07:42,660",
				"to": "00:07:45,020"
			},
			"offsets": {
				"from": 462660,
				"to": 465020
			},
			"text": " Like, there is no news about, you know."
		},
		{
			"timestamps": {
				"from": "00:07:45,300",
				"to": "00:07:48,660"
			},
			"offsets": {
				"from": 465300,
				"to": 468660
			},
			"text": " Listen, Elon Musk has not released a nuclear diamond battery."
		},
		{
			"timestamps": {
				"from": "00:07:48,860",
				"to": "00:07:50,620"
			},
			"offsets": {
				"from": 468860,
				"to": 470620
			},
			"text": " But, like, what?"
		},
		{
			"timestamps": {
				"from": "00:07:51,300",
				"to": "00:07:53,300"
			},
			"offsets": {
				"from": 471300,
				"to": 473300
			},
			"text": " And yet, they'll just mash these things together."
		},
		{
			"timestamps": {
				"from": "00:07:53,820",
				"to": "00:07:55,640"
			},
			"offsets": {
				"from": 473820,
				"to": 475640
			},
			"text": " And, like, I don't know."
		},
		{
			"timestamps": {
				"from": "00:07:55,660",
				"to": "00:07:56,620"
			},
			"offsets": {
				"from": 475660,
				"to": 476620
			},
			"text": " I'm jealous, right?"
		},
		{
			"timestamps": {
				"from": "00:07:56,700",
				"to": "00:08:00,200"
			},
			"offsets": {
				"from": 476700,
				"to": 480200
			},
			"text": " Because, like, they're getting a million views a day on average on their channel."
		},
		{
			"timestamps": {
				"from": "00:08:00,900",
				"to": "00:08:02,020"
			},
			"offsets": {
				"from": 480900,
				"to": 482020
			},
			"text": " Which is phenomenal."
		},
		{
			"timestamps": {
				"from": "00:08:02,180",
				"to": "00:08:04,400"
			},
			"offsets": {
				"from": 482180,
				"to": 484400
			},
			"text": " Don't know how many people are subbing to this."
		},
		{
			"timestamps": {
				"from": "00:08:04,500",
				"to": "00:08:07,680"
			},
			"offsets": {
				"from": 484500,
				"to": 487680
			},
			"text": " But, like, they just trend all over the place."
		},
		{
			"timestamps": {
				"from": "00:08:08,240",
				"to": "00:08:09,240"
			},
			"offsets": {
				"from": 488240,
				"to": 489240
			},
			"text": " And these channels are everywhere."
		},
		{
			"timestamps": {
				"from": "00:08:09,340",
				"to": "00:08:13,540"
			},
			"offsets": {
				"from": 489340,
				"to": 493540
			},
			"text": " So, please, leave it in the comments down below if you've got another example of these channels."
		},
		{
			"timestamps": {
				"from": "00:08:13,540",
				"to": "00:08:15,280"
			},
			"offsets": {
				"from": 493540,
				"to": 495280
			},
			"text": " And there's some, like, really lower quality."
		},
		{
			"timestamps": {
				"from": "00:08:15,300",
				"to": "00:08:18,760"
			},
			"offsets": {
				"from": 495300,
				"to": 498760
			},
			"text": " As I said, they just have, like, some overlay text and stuff like that."
		},
		{
			"timestamps": {
				"from": "00:08:18,800",
				"to": "00:08:22,020"
			},
			"offsets": {
				"from": 498800,
				"to": 502020
			},
			"text": " And some wanky background music and stuff."
		},
		{
			"timestamps": {
				"from": "00:08:22,180",
				"to": "00:08:24,500"
			},
			"offsets": {
				"from": 502180,
				"to": 504500
			},
			"text": " And these things trend on Twitter."
		},
		{
			"timestamps": {
				"from": "00:08:24,640",
				"to": "00:08:27,100"
			},
			"offsets": {
				"from": 504640,
				"to": 507100
			},
			"text": " And then there's also the live ones as well."
		},
		{
			"timestamps": {
				"from": "00:08:27,220",
				"to": "00:08:33,000"
			},
			"offsets": {
				"from": 507220,
				"to": 513000
			},
			"text": " That will, like, trick you into thinking, like, this is the official NASA feed or whatever."
		},
		{
			"timestamps": {
				"from": "00:08:33,060",
				"to": "00:08:33,980"
			},
			"offsets": {
				"from": 513060,
				"to": 513980
			},
			"text": " I've been sucked into this."
		},
		{
			"timestamps": {
				"from": "00:08:34,000",
				"to": "00:08:35,080"
			},
			"offsets": {
				"from": 514000,
				"to": 515080
			},
			"text": " It's been happening for years."
		},
		{
			"timestamps": {
				"from": "00:08:35,560",
				"to": "00:08:39,640"
			},
			"offsets": {
				"from": 515560,
				"to": 519640
			},
			"text": " I've been, like, sucked into watching, like, the latest, you know, live feed."
		},
		{
			"timestamps": {
				"from": "00:08:39,660",
				"to": "00:08:40,520"
			},
			"offsets": {
				"from": 519660,
				"to": 520520
			},
			"text": " But it's not live."
		},
		{
			"timestamps": {
				"from": "00:08:40,760",
				"to": "00:08:42,260"
			},
			"offsets": {
				"from": 520760,
				"to": 522260
			},
			"text": " You know, it'll show up in trending."
		},
		{
			"timestamps": {
				"from": "00:08:42,520",
				"to": "00:08:44,200"
			},
			"offsets": {
				"from": 522520,
				"to": 524200
			},
			"text": " And it's saying, oh, launch."
		},
		{
			"timestamps": {
				"from": "00:08:44,200",
				"to": "00:08:45,160"
			},
			"offsets": {
				"from": 524200,
				"to": 525160
			},
			"text": " You know, there's a live."
		},
		{
			"timestamps": {
				"from": "00:08:45,160",
				"to": "00:08:46,660"
			},
			"offsets": {
				"from": 525160,
				"to": 526660
			},
			"text": " There's a live rocket launch or whatever."
		},
		{
			"timestamps": {
				"from": "00:08:46,760",
				"to": "00:08:47,620"
			},
			"offsets": {
				"from": 526760,
				"to": 527620
			},
			"text": " And I go, oh, wow."
		},
		{
			"timestamps": {
				"from": "00:08:47,680",
				"to": "00:08:53,820"
			},
			"offsets": {
				"from": 527680,
				"to": 533820
			},
			"text": " Because it showed up in my, you know, trending tab or my new video recommended tab in YouTube or whatever."
		},
		{
			"timestamps": {
				"from": "00:08:54,260",
				"to": "00:08:58,640"
			},
			"offsets": {
				"from": 534260,
				"to": 538640
			},
			"text": " And so, I'll actually click on it and watch this supposed rocket launch."
		},
		{
			"timestamps": {
				"from": "00:08:58,680",
				"to": "00:09:04,040"
			},
			"offsets": {
				"from": 538680,
				"to": 544040
			},
			"text": " And it's just a replay of some live footage from, you know, three months ago or something."
		},
		{
			"timestamps": {
				"from": "00:09:04,160",
				"to": "00:09:08,940"
			},
			"offsets": {
				"from": 544160,
				"to": 548940
			},
			"text": " And it's just, like, I think they might have clamped down on those types of channels."
		},
		{
			"timestamps": {
				"from": "00:09:08,940",
				"to": "00:09:15,140"
			},
			"offsets": {
				"from": 548940,
				"to": 555140
			},
			"text": " But, yeah, there's this sort of rubbish that is, on the surface, looks like."
		},
		{
			"timestamps": {
				"from": "00:09:15,140",
				"to": "00:09:17,480"
			},
			"offsets": {
				"from": 555140,
				"to": 557480
			},
			"text": " Like, incredibly highly polished content."
		},
		{
			"timestamps": {
				"from": "00:09:17,940",
				"to": "00:09:20,580"
			},
			"offsets": {
				"from": 557940,
				"to": 560580
			},
			"text": " But it's just, like, it's just rubbish."
		},
		{
			"timestamps": {
				"from": "00:09:20,980",
				"to": "00:09:26,000"
			},
			"offsets": {
				"from": 560980,
				"to": 566000
			},
			"text": " It's a mishmash of just complete garbage just to get the clicks."
		},
		{
			"timestamps": {
				"from": "00:09:26,040",
				"to": "00:09:26,720"
			},
			"offsets": {
				"from": 566040,
				"to": 566720
			},
			"text": " And it works."
		},
		{
			"timestamps": {
				"from": "00:09:27,140",
				"to": "00:09:28,920"
			},
			"offsets": {
				"from": 567140,
				"to": 568920
			},
			"text": " Look, 1.1 million views."
		},
		{
			"timestamps": {
				"from": "00:09:29,040",
				"to": "00:09:30,120"
			},
			"offsets": {
				"from": 569040,
				"to": 570120
			},
			"text": " 1.1 million views."
		},
		{
			"timestamps": {
				"from": "00:09:30,460",
				"to": "00:09:31,640"
			},
			"offsets": {
				"from": 570460,
				"to": 571640
			},
			"text": " I am in the wrong business."
		},
		{
			"timestamps": {
				"from": "00:09:31,840",
				"to": "00:09:37,580"
			},
			"offsets": {
				"from": 571840,
				"to": 577580
			},
			"text": " I need to, yep, I need to get on this real quick while the algorithm still allows it."
		},
		{
			"timestamps": {
				"from": "00:09:37,680",
				"to": "00:09:43,000"
			},
			"offsets": {
				"from": 577680,
				"to": 583000
			},
			"text": " Anyway, yeah, leave your thoughts and comments down below and links to other channels you've been duped by."
		},
		{
			"timestamps": {
				"from": "00:09:45,020",
				"to": "00:09:45,780"
			},
			"offsets": {
				"from": 585020,
				"to": 585780
			},
			"text": " This stuff."
		},
		{
			"timestamps": {
				"from": "00:09:46,120",
				"to": "00:09:47,960"
			},
			"offsets": {
				"from": 586120,
				"to": 587960
			},
			"text": " Because it's just unbelievable."
		},
		{
			"timestamps": {
				"from": "00:09:48,660",
				"to": "00:09:50,080"
			},
			"offsets": {
				"from": 588660,
				"to": 590080
			},
			"text": " So, eh, anyway."
		},
		{
			"timestamps": {
				"from": "00:09:50,700",
				"to": "00:09:51,480"
			},
			"offsets": {
				"from": 590700,
				"to": 591480
			},
			"text": " Catch you next time."
		}
	]
